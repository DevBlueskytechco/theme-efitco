[
  {
    "name": "theme_info",
    "theme_name": "Efitco",
    "theme_version": "0.1.0",
    "theme_author": "NextSky Ecom",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "sofia_sans_condensed_n7",
        "label": "t:labels.heading_font",
        "info": "t:info.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "91rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "91rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "space_base",
        "min": 2,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "t:labels.space_base",
        "info": "t:info.space_base",
        "default": 4
      },
      {
        "type": "header",
        "content": "t:general.corner_radius"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "hero_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.hero_corner_radius",
        "default": 12
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "t:general.color_base"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1A1A1A",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#4D4D4D",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "muted_light_color",
        "default": "#6B6B6B",
        "label": "t:labels.muted_light",
        "info": "t:info.muted_light"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E5E5E5",
        "label": "t:labels.border"
      },
      {
        "type": "header",
        "content": "t:general.color_alternate"
      },
      {
        "type": "color",
        "id": "background_alt_color",
        "default": "#F4F4F4",
        "label": "t:labels.background_alt"
      },
      {
        "type": "color",
        "id": "background_alt_foreground_color",
        "default": "#1A1A1A",
        "label": "t:labels.background_alt_foreground"
      },
      {
        "type": "color",
        "id": "background_cream_color",
        "default": "#F5F5F1",
        "label": "t:labels.background_cream"
      },
      {
        "type": "color",
        "id": "background_cream_foreground_color",
        "default": "#1A1A1A",
        "label": "t:labels.background_cream_foreground"
      },
      {
        "type": "color",
        "id": "background_dark_color",
        "default": "#1E1E1E",
        "label": "t:labels.background_dark"
      },
      {
        "type": "color",
        "id": "background_dark_foreground_color",
        "default": "#FFFFFF",
        "label": "t:labels.background_dark_foreground"
      },
      {
        "type": "color",
        "id": "muted_on_dark_color",
        "default": "#999999",
        "label": "t:labels.muted_on_dark",
        "info": "t:info.muted_on_dark"
      },
      {
        "type": "header",
        "content": "t:general.color_accent"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#C8400E",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "accent_foreground_color",
        "default": "#FFFFFF",
        "label": "t:labels.accent_foreground"
      },
      {
        "type": "color",
        "id": "sale_color",
        "default": "#BD1616",
        "label": "t:labels.sale"
      },
      {
        "type": "color",
        "id": "sale_foreground_color",
        "default": "#FFFFFF",
        "label": "t:labels.sale_foreground"
      },
      {
        "type": "color",
        "id": "rating_color",
        "default": "#FFC107",
        "label": "t:labels.rating"
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "t:labels.social_tiktok_link"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "t:labels.social_instagram_link"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "t:labels.social_youtube_link"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "t:labels.social_facebook_link"
      },
      {
        "type": "url",
        "id": "social_x_link",
        "label": "t:labels.social_x_link"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "t:labels.social_pinterest_link"
      }
    ]
  }
]
