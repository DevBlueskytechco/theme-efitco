{% doc %}
  Cart line items, or the empty state when the cart has no items (TE-5 AC1, AC4,
  AC10, AC11, AC12; mini-cart-quickview.md §1, §10). Shared by
  blocks/cart-page.liquid and blocks/cart-drawer.liquid; render it inside their
  partial so a refresh keeps lines and totals in sync.

  Does not use snippets/price.liquid: that snippet prices a variant and has no
  final_price, original_price or line discounts. It reuses the price__* classes
  and the products.price.* keys instead.

  Line order (DOM = Tab order): image link (tabindex -1, aria-hidden: only the
  title takes Tab), title, options, properties, selling plan (AC10, the line
  price is already the plan price), unit price with compare-at or original price
  struck through, unit price measurement, line discounts (tag icon), then the
  stepper (decrease, quantity, increase), the trash icon remove link and the
  line total. In the drawer CSS places the remove link on the title row.

  Price: a line with a discount shows final_price on sale + original_price
  struck through; otherwise a variant (or selling plan) compare-at price above
  final_price shows final_price on sale + compare-at struck through.

  Controls point at the form with the form attribute, so they submit from any
  position. Without JavaScript: updates[] plus the Update button save quantities,
  the Remove link goes to item.url_to_remove. The decrease and increase buttons
  render with the hidden attribute: JavaScript removes it once it handles them
  (TE-5-R2-BE1); without JavaScript only the number input shows (AC11). The
  decrease button has aria-disabled="true" when the quantity is 1.

  JavaScript hooks: data-line-key (li), data-cart-remove (link),
  data-cart-update (button, hidden by CSS once cart-items has data-enhanced),
  data-cart-step="-1" / "1" (decrease, increase buttons, aria-controls is the
  quantity input id).

  Test hooks: cart-lines, cart-line, cart-line-image, cart-line-title,
  cart-line-options, cart-line-properties, cart-line-selling-plan,
  cart-line-price, cart-line-original-price, cart-line-compare-price,
  cart-line-unit-price, cart-line-discount, cart-line-total, cart-line-quantity,
  cart-line-decrease, cart-line-increase, cart-line-remove, cart-update,
  cart-empty, cart-empty-heading, cart-empty-cta, cart-empty-link.

  @param {object} cart - The cart to list
  @param {string} context - Where it renders, 'page' or 'drawer'. Part of the form id and of the input ids
  @param {string} [empty_url] - Drawer only: destination of "Shop Bestsellers" in the empty state. Default: all products sorted by best selling

  @example
  {% render 'cart-lines', cart: cart, context: 'page' %}
{% enddoc %}

{%- assign form_id = 'cart-form-' | append: context -%}

{%- if cart.item_count == 0 -%}
  {%- comment -%}
    Empty state (foundation §18, TE-5 AC19). .cart-empty a is the focus target of
    assets/cart-items.js after the last line is removed in the drawer.
  {%- endcomment -%}
  <div class="cart-empty empty-state" data-testid="cart-empty">
    <span class="empty-state__icon">{% render 'status-icon', name: 'cart' %}</span>
    <h2 class="empty-state__heading" data-testid="cart-empty-heading">{{ 'cart.empty_heading' | t }}</h2>
    <p class="empty-state__text">{{ 'cart.empty_text' | t }}</p>
    <div class="empty-state__actions">
      {%- if context == 'drawer' -%}
        {%- liquid
          assign bestsellers_url = empty_url
          if bestsellers_url == blank
            assign bestsellers_url = routes.all_products_collection_url | append: '?sort_by=best-selling'
          endif
        -%}
        <a class="button" href="{{ bestsellers_url }}" data-testid="cart-empty-cta">
          {{- 'cart.empty_cta' | t -}}
        </a>
      {%- else -%}
        <a class="button" href="{{ routes.all_products_collection_url }}" data-testid="cart-empty-cta">
          {{- 'cart.continue_shopping' | t -}}
        </a>
        <a class="empty-state__link" href="{{ routes.collections_url }}" data-testid="cart-empty-link">
          {{- 'cart.browse_collections' | t -}}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  {%- liquid
    if context == 'drawer'
      assign image_widths = '72, 96, 144, 192'
      assign image_sizes = '(min-width: 48rem) 96px, 72px'
    else
      assign image_widths = '96, 120, 192, 240'
      assign image_sizes = '(min-width: 48rem) 120px, 96px'
    endif
  -%}
  <ul class="cart-lines" role="list" data-testid="cart-lines">
    {%- for item in cart.items -%}
      {%- liquid
        assign line_title = item.product.title | escape
        assign quantity_id = 'cart-quantity-' | append: context | append: '-' | append: forloop.index
        assign compare_price = item.variant.compare_at_price
        if item.selling_plan_allocation.compare_at_price
          assign compare_price = item.selling_plan_allocation.compare_at_price
        endif
      -%}
      <li class="cart-line" data-line-key="{{ item.key }}" data-testid="cart-line">
        <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          {%- if item.image -%}
            {%- render 'image',
              image: item.image,
              class: 'cart-line__image',
              width: 240,
              height: 240,
              crop: 'center',
              widths: image_widths,
              sizes: image_sizes,
              decorative: true,
              testid: 'cart-line-image'
            -%}
          {%- else -%}
            <span class="cart-line__image cart-line__image--empty" data-testid="cart-line-image">
              {%- render 'status-icon', name: 'box' -%}
            </span>
          {%- endif -%}
        </a>

        <div class="cart-line__details">
          <a class="cart-line__title" href="{{ item.url }}" data-testid="cart-line-title">{{ line_title }}</a>

          {%- unless item.product.has_only_default_variant -%}
            <dl class="cart-line__meta" data-testid="cart-line-options">
              {%- for option in item.options_with_values -%}
                <div class="cart-line__meta-row">
                  <dt>{{ option.name | escape }}:</dt>
                  <dd>{{ option.value | escape }}</dd>
                </div>
              {%- endfor -%}
            </dl>
          {%- endunless -%}

          {%- capture line_properties -%}
            {%- for property in item.properties -%}
              {%- assign property_prefix = property.first | slice: 0 -%}
              {%- if property_prefix != '_' and property.last != blank -%}
                <div class="cart-line__meta-row">
                  <dt>{{ property.first | escape }}:</dt>
                  <dd>{{ property.last | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if line_properties != blank -%}
            <dl class="cart-line__meta" data-testid="cart-line-properties">{{ line_properties }}</dl>
          {%- endif -%}

          {%- if item.selling_plan_allocation -%}
            <p class="cart-line__selling-plan" data-testid="cart-line-selling-plan">
              {{- item.selling_plan_allocation.selling_plan.name | escape -}}
            </p>
          {%- endif -%}

          <div class="price cart-line__price">
            {%- if item.original_price != item.final_price -%}
              <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
              <span class="price__current price__current--sale" data-testid="cart-line-price">
                {{- item.final_price | money -}}
              </span>
              <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
              <s class="price__compare" data-testid="cart-line-original-price">{{ item.original_price | money }}</s>
            {%- elsif compare_price > item.final_price -%}
              <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
              <span class="price__current price__current--sale" data-testid="cart-line-price">
                {{- item.final_price | money -}}
              </span>
              <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
              <s class="price__compare" data-testid="cart-line-compare-price">{{ compare_price | money }}</s>
            {%- else -%}
              <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
              <span class="price__current" data-testid="cart-line-price">{{ item.final_price | money }}</span>
            {%- endif -%}

            {%- if item.unit_price_measurement -%}
              {%- liquid
                assign measurement = item.unit_price_measurement
                assign reference = measurement.reference_unit
                if measurement.reference_value != 1
                  assign reference = measurement.reference_value | append: measurement.reference_unit
                endif
                assign unit_price = item.unit_price | money
              -%}
              <span class="visually-hidden">{{ 'products.price.unit_price' | t }}</span>
              <span class="price__unit" data-testid="cart-line-unit-price">
                {{- 'products.price.unit_price_value' | t: price: unit_price, unit: reference -}}
              </span>
            {%- endif -%}
          </div>

          {%- if item.line_level_discount_allocations.size > 0 -%}
            <ul class="cart-line__discounts" role="list">
              {%- for allocation in item.line_level_discount_allocations -%}
                {%- assign discount_amount = allocation.amount | money -%}
                <li class="cart-line__discount" data-testid="cart-line-discount">
                  <span class="cart-line__discount-icon">{% render 'status-icon', name: 'tag' %}</span>
                  <span class="visually-hidden">{{ 'cart.discount_label' | t }}</span>
                  <span>{{ allocation.discount_application.title | escape }}</span>
                  <span>{{ 'cart.discount_value' | t: amount: discount_amount }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="cart-line__controls">
          <label class="visually-hidden" for="{{ quantity_id }}">
            {{- 'cart.quantity_label' | t: title: line_title -}}
          </label>
          <div class="cart-line__stepper">
            <button
              class="cart-line__step"
              type="button"
              aria-label="{{ 'cart.decrease_label' | t: title: line_title }}"
              aria-controls="{{ quantity_id }}"
              {% if item.quantity <= 1 %}
                aria-disabled="true"
              {% endif %}
              data-cart-step="-1"
              data-testid="cart-line-decrease"
              hidden
            >
              {%- render 'status-icon', name: 'minus' -%}
            </button>
            <input
              id="{{ quantity_id }}"
              class="cart-line__quantity"
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              inputmode="numeric"
              form="{{ form_id }}"
              data-testid="cart-line-quantity"
            >
            <button
              class="cart-line__step"
              type="button"
              aria-label="{{ 'cart.increase_label' | t: title: line_title }}"
              aria-controls="{{ quantity_id }}"
              data-cart-step="1"
              data-testid="cart-line-increase"
              hidden
            >
              {%- render 'status-icon', name: 'plus' -%}
            </button>
          </div>
          <a
            class="cart-line__remove"
            href="{{ item.url_to_remove }}"
            aria-label="{{ 'cart.remove_label' | t: title: line_title }}"
            data-cart-remove
            data-testid="cart-line-remove"
          >
            {%- render 'status-icon', name: 'trash' -%}
          </a>
        </div>

        <p class="cart-line__total">
          <span class="visually-hidden">{{ 'cart.line_total' | t }}</span>
          <span data-testid="cart-line-total">{{ item.final_line_price | money }}</span>
        </p>
      </li>
    {%- endfor -%}
  </ul>

  <button
    class="button button--secondary cart-update"
    type="submit"
    name="update"
    form="{{ form_id }}"
    data-cart-update
    data-testid="cart-update"
  >
    {{- 'cart.update' | t -}}
  </button>
{%- endif -%}
