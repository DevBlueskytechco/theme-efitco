{% doc %}
  Product structured data (TE-4 AC11): one JSON-LD Product with name, url,
  up to 5 images (1200px), description (HTML stripped), brand (vendor), sku
  and one Offer per variant (price, priceCurrency from the market currency,
  InStock / OutOfStock, absolute variant URL). Every value goes through the
  json filter. Static: it already lists every variant, so it is not part of
  a partial and is not refreshed when the variant changes.

  Replaces the Skeleton `product | structured_data` output in
  snippets/meta-tags.liquid so the page has a single Product entity.

  @param {product} product - The product to describe

  @example
  {% render 'product-structured-data', product: product %}
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_url = request.origin | append: product.url
  # Space before each tag so block elements (</p><p>) do not glue words together.
  assign description = product.description | replace: '<', ' <' | strip_html | strip
-%}

<script type="application/ld+json" data-testid="product-structured-data">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ product_url | json }},
    {%- if product.images.size > 0 %}
      "image": [
        {%- for image in product.images limit: 5 -%}
          {%- assign image_src = image | image_url: width: 1200 | prepend: 'https:' -%}
          {{ image_src | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
    {%- endif %}
    {%- if description != blank %}
      "description": {{ description | json }},
    {%- endif %}
    {%- if product.vendor != blank %}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
    {%- endif %}
    {%- if current_variant.sku != blank %}
      "sku": {{ current_variant.sku | json }},
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign offer_url = request.origin | append: variant.url
          assign offer_price = variant.price | divided_by: 100.0
          if variant.available
            assign offer_availability = 'https://schema.org/InStock'
          else
            assign offer_availability = 'https://schema.org/OutOfStock'
          endif
        -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank %}
            "sku": {{ variant.sku | json }},
          {%- endif %}
          "price": {{ offer_price | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": {{ offer_availability | json }},
          "url": {{ offer_url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
