{% doc %}
  Renders a responsive image that might be wrapped in a link.

  When `width`, `height` and `crop` are provided, the image will be rendered
  with a fixed aspect ratio.

  Serves as an example of how to use the `image_url` filter and `image_tag` filter
  as well as how you can use LiquidDoc to document your code.

  @param {image} image - The image to be rendered
  @param {string} [url] - An optional destination URL for the image
  @param {string} [class] - Optional class to be added to the image wrapper
  @param {number} [width] - The highest resolution width of the image to be rendered
  @param {number} [height] - The highest resolution height of the image to be rendered
  @param {string} [crop] - The crop position of the image
  @param {string} [widths] - Comma-separated srcset widths. Default: '360, 720, 1080, 1440'
  @param {string} [sizes] - The sizes attribute. Default: '100vw'
  @param {string} [loading] - The loading attribute. Default: 'lazy'
  @param {string} [fetchpriority] - The fetchpriority attribute, omitted when empty

  @example
  {% render 'image', image: product.featured_image %}
  {% render 'image', image: product.featured_image, url: product.url %}
  {% render 'image',
    class: 'product__image',
    image: product.featured_image,
    url: product.url,
    width: 1200,
    height: 800,
    crop: 'center',
  %}
  {% render 'image',
    image: product.featured_image,
    width: 1800,
    widths: '360, 720, 1080, 1800',
    sizes: '100vw',
    loading: 'eager',
    fetchpriority: 'high',
  %}
{% enddoc %}

{% liquid
  unless height
    assign width = width | default: image.width
  endunless

  if url
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif

  assign responsive = false
  if widths or sizes or loading or fetchpriority
    assign responsive = true
    assign tag_widths = widths | default: '360, 720, 1080, 1440'
    assign tag_sizes = sizes | default: '100vw'
    assign tag_loading = loading | default: 'lazy'
  endif
%}

<{{ wrapper }}
  class="image {{ class }}"
  {% if url %}
    href="{{ url }}"
  {% endif %}
>
  {%- if fetchpriority -%}
    {{
      image
      | image_url: width: width, height: height, crop: crop
      | image_tag: widths: tag_widths, sizes: tag_sizes, loading: tag_loading, fetchpriority: fetchpriority
    }}
  {%- elsif responsive -%}
    {{
      image
      | image_url: width: width, height: height, crop: crop
      | image_tag: widths: tag_widths, sizes: tag_sizes, loading: tag_loading
    }}
  {%- else -%}
    {{ image | image_url: width: width, height: height, crop: crop | image_tag }}
  {%- endif -%}
</{{ wrapper }}>
