{% doc %}
  Outputs the theme design tokens as CSS custom properties on :root,
  plus @font-face rules for the heading and body fonts. Every value is
  read from config/settings_schema.json (source: docs/tokens.json), so
  CSS in assets/ only references var(--color-*), var(--font-*),
  var(--space-*) and var(--radius-*).

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign body_font = settings.type_primary_font
  assign heading_font = settings.type_heading_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign heading_font_extrabold = heading_font | font_modify: 'weight', '800'
  assign space = settings.space_base
-%}

{% style %}
  {% # Loads font variants with display: swap. Variants the font family lacks return nil and are skipped. %}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_font_medium %}{{ body_font_medium | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_semibold %}{{ body_font_semibold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_bold %}{{ body_font_bold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_italic %}{{ body_font_italic | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_bold_italic %}{{ body_font_bold_italic | font_face: font_display: 'swap' }}{% endif -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {%- if heading_font_extrabold %}{{ heading_font_extrabold | font_face: font_display: 'swap' }}{% endif -%}

  :root {
    /* Fonts */
    --font-primary--family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-primary--style: {{ body_font.style }};
    --font-primary--weight: {{ body_font.weight }};
    --font-heading--family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading--style: {{ heading_font.style }};
    --font-heading--weight: {{ heading_font.weight }};
    /* Display + wordmark dùng 800 theo Figma; font không có 800 thì giữ weight heading */
    --font-heading--weight-display: {% if heading_font_extrabold %}800{% else %}{{ heading_font.weight }}{% endif %};

    /* Type scale: 13 / 14 / 16 / 18 / 28 / 36 / 48 / 100 / 200 px at 1280+ */
    --font-size-xs: 0.8125rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-h3: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    --font-size-h2: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    --font-size-h1: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    --font-size-display: clamp(3rem, 1rem + 7vw, 6.25rem);
    --font-size-wordmark: clamp(4rem, 10.4vw, 12.5rem);
    --line-height-body: 1.5;
    --line-height-heading: 1.1;
    /* Token kit (ES1-T540, kit.css :root): khai báo, chưa áp vào component. --line-height-heading giữ tới ES1-T577 */
    --font-size-eyebrow: clamp(0.875rem, 0.826rem + 0.217vw, 1rem);
    --font-size-h4: 1.25rem;
    --font-body-weight: 500;
    --letter-spacing-body: -0.01em;
    --letter-spacing-label: -0.02em;
    --letter-spacing-heading: -0.02em;
    --letter-spacing-display: -0.03em;
    --letter-spacing-caps: 0.04em;
    --line-height-sm: 1.4286;
    --line-height-label: 1.5385;
    --line-height-title: 1.5556;
    --line-height-reading: 1.75;
    --line-height-price-lg: 1.4;
    --line-height-eyebrow: 1.25rem;
    --line-height-h4: 1.2;
    --line-height-h3: 1.2857;
    --line-height-h2: 1.25;
    --line-height-h1: 1.2;
    --line-height-display: 1.1538;

    /* Icon: khung 16 / 20 / 24, nét 1.5 */
    --icon-size-sm: 16px;
    --icon-size-md: 20px;
    --icon-size-lg: 24px;
    --icon-stroke-width: 1.5;

    /* Layout */
    /* 91rem = 1456px = nội dung 1416px (Figma) + 2 x page margin 20px */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    /* Hero chui dưới header đúng bằng chiều cao này khi header trong suốt */
    --header-height: {{ space | times: 20 }}px;
    /* Cột giữa của lưới trang; 100% tính tại phần tử dùng (.block-container) */
    --content-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    --grid-columns: 4;
    --dark-texture: url('{{ 'noise-dark.png' | asset_url }}');

    /* Space scale: 4 / 8 / 12 / 16 / 24 / 32 / 48 / 120 px at base 4 */
    --space-1: {{ space }}px;
    --space-2: {{ space | times: 2 }}px;
    --space-3: {{ space | times: 3 }}px;
    --space-4: {{ space | times: 4 }}px;
    --space-5: {{ space | times: 6 }}px;
    --space-6: {{ space | times: 8 }}px;
    --space-7: {{ space | times: 12 }}px;
    --space-8: {{ space | times: 30 }}px;
    /* Sàn vùng bấm (WCAG 2.5.8, TE-3 AC6): hằng số, không theo space_base */
    --touch-target-min: 24px;
    /* Kích thước component (kit): px hằng số, không theo space_base */
    --touch-target: 44px;
    --control-height: 48px;
    --control-height-compact: 44px;
    --tab-height-desktop: 40px;
    --row-height: 52px;
    --count-badge-size: 20px;
    --progress-height: 4px;
    --meter-height: 8px;

    /* Corner radius. Thang 4 / 8 / 12 / 16 / 20 + pill (foundation §1.2, ES1-T537): hằng số, không theo setting.
       Bo lồng: con nhỏ hơn cha một bậc (thumb 8 trong card 12, card 12 trong panel 16, panel 16 trong dialog 20). */
    --radius-xs: 4px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    /* Pill shape (badges): constant, not a merchant setting */
    --radius-pill: 999px;
    /* Vai trò theo setting */
    --radius-input: {{ settings.input_corner_radius }}px;
    --radius-button: {{ settings.button_corner_radius }}px;
    --radius-card: {{ settings.card_corner_radius }}px;
    --radius-hero: {{ settings.hero_corner_radius }}px;
    /* Vai trò cố định: swatch, thumb · panel, banner, card bài viết · dialog, bottom sheet */
    --radius-swatch: var(--radius-sm);
    --radius-panel: var(--radius-lg);
    --radius-dialog: var(--radius-xl);

    /* Colors */
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-muted: {{ settings.muted_color }};
    --color-muted-light: {{ settings.muted_light_color }};
    --color-border: {{ settings.border_color }};
    --color-background-alt: {{ settings.background_alt_color }};
    --color-background-alt-foreground: {{ settings.background_alt_foreground_color }};
    --color-background-cream: {{ settings.background_cream_color }};
    --color-background-cream-foreground: {{ settings.background_cream_foreground_color }};
    --color-background-sand: {{ settings.background_sand_color }};
    --color-background-sand-foreground: {{ settings.background_sand_foreground_color }};
    --color-background-dark: {{ settings.background_dark_color }};
    --color-background-dark-foreground: {{ settings.background_dark_foreground_color }};
    --color-background-panel: {{ settings.background_panel_color }};
    --color-muted-on-dark: {{ settings.muted_on_dark_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-foreground: {{ settings.accent_foreground_color }};
    --color-sale: {{ settings.sale_color }};
    --color-sale-foreground: {{ settings.sale_foreground_color }};
    --color-badge-new: {{ settings.badge_new_color }};
    --color-badge-new-foreground: {{ settings.badge_new_foreground_color }};
    --color-rating: {{ settings.rating_color }};
    /* Vai trò trạng thái: chỉ alias, không thêm giá trị màu */
    --color-success: var(--color-badge-new);
    --color-success-foreground: var(--color-badge-new-foreground);
    --color-critical: var(--color-sale);
    --color-critical-foreground: var(--color-sale-foreground);
    --color-warning: var(--color-accent);
    --color-warning-foreground: var(--color-accent-foreground);
    --figma-radius-2: 2px;
    --figma-radius-4: 4px;
    --figma-radius-8: 8px;
    --figma-radius-12: 12px;
    --figma-radius-16: 16px;
    --figma-radius-18: 18px;
    --figma-radius-24: 24px;
    --figma-radius-999: 999px;
    {%- comment -%} CTA hero 1:433 rộng 233: Figma làm tròn bề rộng chữ lên, trình duyệt đo 232.28 {%- endcomment %}
    --figma-hero-cta-width: 233px;
    --motion-fast: 150ms;
    --motion-base: 250ms;
    --motion-slow: 500ms;
    --motion-accordion: 350ms;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --motion-reveal: 900ms;
    --motion-enter: 400ms;
    --motion-stagger: 60ms;
    --motion-hero: 1400ms;
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    /* Cam đậm hơn accent 10% cho chữ nhỏ trên nền sand: #C8400E 4.03:1 -> khoảng 4.8:1 (AA), vẫn là cam Figma (CTO 09/11) */
    --color-accent-on-sand: color-mix(in srgb, var(--color-accent) 90%, #000);
    --figma-000000: #000;
    --figma-1a1a1a: #1a1a1a;
    --figma-1c1c1c: #1c1c1c;
    --figma-333333: #333;
    --figma-393942: #393942;
    --figma-4b824d: #4b824d;
    --figma-4d4d4d: #4d4d4d;
    --figma-666666: var(--color-muted-on-dark);
    --figma-808080: var(--color-muted-light);
    --figma-999999: #999;
    --figma-b2b2b2: #b2b2b2;
    --figma-d9d9d9: #d9d9d9;
    --figma-e5e5e5: #e5e5e5;
    --figma-ebe6e0: #ebe6e0;
    --figma-f4f4f5: #f4f4f5;
    --figma-f5f5f1: #f5f5f1;
    --figma-ffffff: #fff;
    --figma-white-12: rgb(255 255 255 / 0.12);
    --figma-white-60: rgb(255 255 255 / 0.6);

    /* Lớp (ADR 0007, foundation §31): mọi z-index dùng var(--layer-*) */
    --layer-content: 1;
    --layer-sticky: 4;
    --layer-bottom-bar: 5;
    --layer-header: 10;
    --layer-floating: 15;
    --layer-scrim: 20;
    --layer-overlay: 21;
    --layer-toast: 30;

    /* Elevation 4 bậc (foundation §31): none card/panel, raised dropdown/hover/header cuộn, overlay drawer/dialog, bar thanh đáy */
    --overlay-scrim: color-mix(in srgb, var(--color-background-dark) 50%, transparent);
    --shadow-none: none;
    --shadow-raised: 0 var(--space-2) var(--space-5) color-mix(in srgb, var(--color-foreground) 12%, transparent);
    --shadow-overlay: 0 var(--space-6) calc(var(--space-1) * 20) color-mix(in srgb, var(--color-foreground) 28%, transparent);
    --shadow-bar: 0 calc(-1 * var(--space-1)) var(--space-5) color-mix(in srgb, var(--color-foreground) 10%, transparent);

    /* Panel tối: chữ phụ 70% (6.56:1), dòng giảm giá (5.64:1, luôn kèm icon + dấu −) */
    --panel-muted: color-mix(in srgb, var(--color-background-dark-foreground) 70%, var(--color-background-panel));
    --panel-saving: color-mix(in srgb, var(--color-badge-new) 50%, var(--color-background-dark-foreground));
    --round-button-size: calc(var(--space-1) * 13);
  }

  @media (min-width: 48rem) {
    :root {
      --grid-columns: 8;
      --letter-spacing-display: -0.04em;
      --line-height-display: 1;
    }
  }

  @media (min-width: 80rem) {
    :root {
      --grid-columns: 12;
      --line-height-h2: 1.2222;
      --line-height-h1: 1.1667;
    }
  }
{% endstyle %}
