{% doc %}
  Outputs the theme design tokens as CSS custom properties on :root,
  plus @font-face rules for the heading and body fonts. Every value is
  read from config/settings_schema.json (source: docs/tokens.json), so
  CSS in assets/ only references var(--color-*), var(--font-*),
  var(--space-*) and var(--radius-*).

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign body_font = settings.type_primary_font
  assign heading_font = settings.type_heading_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign space = settings.space_base
-%}

{% style %}
  {% # Loads font variants with display: swap. Variants the font family lacks return nil and are skipped. %}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_font_medium %}{{ body_font_medium | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_semibold %}{{ body_font_semibold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_bold %}{{ body_font_bold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_italic %}{{ body_font_italic | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_font_bold_italic %}{{ body_font_bold_italic | font_face: font_display: 'swap' }}{% endif -%}
  {{ heading_font | font_face: font_display: 'swap' }}

  :root {
    /* Fonts */
    --font-primary--family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-primary--style: {{ body_font.style }};
    --font-primary--weight: {{ body_font.weight }};
    --font-heading--family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading--style: {{ heading_font.style }};
    --font-heading--weight: {{ heading_font.weight }};

    /* Type scale: 13 / 14 / 16 / 18 / 28 / 36 / 48 / 100 / 200 px at 1280+ */
    --font-size-xs: 0.8125rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-h3: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    --font-size-h2: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    --font-size-h1: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    --font-size-display: clamp(3rem, 1rem + 7vw, 6.25rem);
    --font-size-wordmark: clamp(4rem, 10.4vw, 12.5rem);
    --line-height-body: 1.5;
    --line-height-heading: 1.1;

    /* Layout */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Space scale: 4 / 8 / 12 / 16 / 24 / 32 / 48 / 120 px at base 4 */
    --space-1: {{ space }}px;
    --space-2: {{ space | times: 2 }}px;
    --space-3: {{ space | times: 3 }}px;
    --space-4: {{ space | times: 4 }}px;
    --space-5: {{ space | times: 6 }}px;
    --space-6: {{ space | times: 8 }}px;
    --space-7: {{ space | times: 12 }}px;
    --space-8: {{ space | times: 30 }}px;

    /* Corner radius */
    --radius-input: {{ settings.input_corner_radius }}px;
    --radius-button: {{ settings.button_corner_radius }}px;
    --radius-card: {{ settings.card_corner_radius }}px;
    --radius-hero: {{ settings.hero_corner_radius }}px;

    /* Colors */
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-muted: {{ settings.muted_color }};
    --color-muted-light: {{ settings.muted_light_color }};
    --color-border: {{ settings.border_color }};
    --color-background-alt: {{ settings.background_alt_color }};
    --color-background-alt-foreground: {{ settings.background_alt_foreground_color }};
    --color-background-cream: {{ settings.background_cream_color }};
    --color-background-cream-foreground: {{ settings.background_cream_foreground_color }};
    --color-background-dark: {{ settings.background_dark_color }};
    --color-background-dark-foreground: {{ settings.background_dark_foreground_color }};
    --color-muted-on-dark: {{ settings.muted_on_dark_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-foreground: {{ settings.accent_foreground_color }};
    --color-sale: {{ settings.sale_color }};
    --color-sale-foreground: {{ settings.sale_foreground_color }};
    --color-rating: {{ settings.rating_color }};
  }
{% endstyle %}
