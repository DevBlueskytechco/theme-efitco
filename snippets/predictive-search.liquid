{% doc %}
  Renders the search dialog of the header. The caller places it right after the
  header-search-link anchor: assets/search-loader.js finds the dialog with
  nextElementSibling and opens it with showModal(). Without JavaScript the
  dialog stays closed and the anchor goes to the search page. Inside the dialog
  the form is a plain GET to the search page, so search works if
  assets/predictive-search.js fails to load.

  Option elements are the <a role="option"> themselves, never wrapped in a list
  item: an option that contains a link fails axe nested-interactive. Group
  titles are plain <div>: a heading inside a listbox fails axe
  aria-required-children.

  Hooks for assets/predictive-search.js (ES1-T123 D9):
  - <predictive-search>: data-url, data-money-format, data-label-count (%n is
    the number), data-label-empty and data-label-all (%s is the search terms).
  - data-predictive-group: products, collections, pages, articles; hidden until
    filled. data-predictive-options: where cloned options go.
  - data-predictive-template: product, link. Inside the clones:
    data-predictive-image, data-predictive-title, data-predictive-price.
  - Test ids: predictive-search, predictive-search-dialog,
    predictive-search-close, predictive-search-form, predictive-search-input,
    predictive-search-submit, predictive-search-listbox,
    predictive-search-group, predictive-search-option, predictive-search-all,
    predictive-search-status.

  @example
  {% render 'predictive-search' %}
{% enddoc %}

<dialog
  class="predictive-search-dialog"
  scroll-lock
  aria-label="{{ 'blocks.predictive_search.dialog_label' | t | escape }}"
  data-testid="predictive-search-dialog"
>
  <predictive-search
    class="predictive-search"
    data-testid="predictive-search"
    data-url="{{ routes.predictive_search_url }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-label-count="{{ 'blocks.predictive_search.count' | t: number: '%n' | escape }}"
    data-label-empty="{{ 'blocks.predictive_search.empty' | t: terms: '%s' | escape }}"
    data-label-all="{{ 'blocks.predictive_search.all' | t: terms: '%s' | escape }}"
  >
    <form
      class="predictive-search__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-testid="predictive-search-form"
    >
      <input type="hidden" name="type" value="product,article,page">
      <input type="hidden" name="options[prefix]" value="last">

      <label class="visually-hidden" for="PredictiveSearchInput">
        {{- 'blocks.predictive_search.input_label' | t -}}
      </label>
      <input
        class="predictive-search__input"
        id="PredictiveSearchInput"
        type="search"
        name="q"
        placeholder="{{ 'blocks.predictive_search.input_label' | t | escape }}"
        autofocus
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="PredictiveSearchListbox"
        aria-autocomplete="list"
        data-testid="predictive-search-input"
      >
      <button
        class="site-header__icon"
        type="submit"
        aria-label="{{ 'blocks.predictive_search.submit' | t | escape }}"
        data-testid="predictive-search-submit"
      >
        {% render 'header-icon', name: 'search' %}
      </button>
    </form>

    <div class="predictive-search__status" role="status" data-testid="predictive-search-status"></div>

    <div
      class="predictive-search__listbox"
      id="PredictiveSearchListbox"
      role="listbox"
      aria-label="{{ 'blocks.predictive_search.listbox_label' | t | escape }}"
      hidden
      data-testid="predictive-search-listbox"
    >
      <div
        role="group"
        aria-labelledby="PredictiveSearchGroup-products"
        hidden
        data-predictive-group="products"
        data-testid="predictive-search-group"
      >
        <div class="predictive-search__group-title" id="PredictiveSearchGroup-products">
          {{- 'blocks.predictive_search.group_products' | t -}}
        </div>
        <div data-predictive-options></div>
      </div>
      <div
        role="group"
        aria-labelledby="PredictiveSearchGroup-collections"
        hidden
        data-predictive-group="collections"
        data-testid="predictive-search-group"
      >
        <div class="predictive-search__group-title" id="PredictiveSearchGroup-collections">
          {{- 'blocks.predictive_search.group_collections' | t -}}
        </div>
        <div data-predictive-options></div>
      </div>
      <div
        role="group"
        aria-labelledby="PredictiveSearchGroup-pages"
        hidden
        data-predictive-group="pages"
        data-testid="predictive-search-group"
      >
        <div class="predictive-search__group-title" id="PredictiveSearchGroup-pages">
          {{- 'blocks.predictive_search.group_pages' | t -}}
        </div>
        <div data-predictive-options></div>
      </div>
      <div
        role="group"
        aria-labelledby="PredictiveSearchGroup-articles"
        hidden
        data-predictive-group="articles"
        data-testid="predictive-search-group"
      >
        <div class="predictive-search__group-title" id="PredictiveSearchGroup-articles">
          {{- 'blocks.predictive_search.group_articles' | t -}}
        </div>
        <div data-predictive-options></div>
      </div>

      <a
        class="predictive-search__option predictive-search__all"
        href="{{ routes.search_url }}"
        role="option"
        tabindex="-1"
        aria-selected="false"
        data-testid="predictive-search-all"
      >
        {{- 'blocks.predictive_search.view_all' | t -}}
      </a>
    </div>

    <template data-predictive-template="product">
      <a
        class="predictive-search__option"
        href="{{ routes.search_url }}"
        role="option"
        tabindex="-1"
        aria-selected="false"
        data-testid="predictive-search-option"
      >
        <img
          class="predictive-search__image"
          alt=""
          width="64"
          height="64"
          sizes="64px"
          loading="lazy"
          data-predictive-image
        >
        <span class="predictive-search__option-text">
          <span data-predictive-title></span>
          <span class="predictive-search__price" data-predictive-price></span>
        </span>
      </a>
    </template>

    <template data-predictive-template="link">
      <a
        class="predictive-search__option"
        href="{{ routes.search_url }}"
        role="option"
        tabindex="-1"
        aria-selected="false"
        data-testid="predictive-search-option"
      >
        <span class="predictive-search__option-text">
          <span data-predictive-title></span>
        </span>
      </a>
    </template>
  </predictive-search>

  <form class="predictive-search-dialog__close-form" method="dialog">
    {% # aria-label, not hidden text: the dialog is closed (display: none) on load, so a name from hidden content is empty. %}
    <button
      class="site-header__icon"
      type="submit"
      aria-label="{{ 'blocks.predictive_search.close' | t | escape }}"
      data-testid="predictive-search-close"
    >
      {% render 'header-icon', name: 'close' %}
    </button>
  </form>
</dialog>
