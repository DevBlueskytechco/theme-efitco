{% doc %}
  Renders one inline, decorative header icon. Stroke follows currentColor
  and --icon-stroke-width, so the icon inherits the header text color.

  @param {string} name - Icon name: 'menu', 'close', 'search', 'chevron' or 'bag'

  @example
  {% render 'header-icon', name: 'search' %}
{% enddoc %}

{%- case name -%}
  {%- when 'menu' -%}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" aria-hidden="true" focusable="false"><path d="M3 5.5h14M3 10h14M3 14.5h14" /></svg>
  {%- when 'close' -%}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" aria-hidden="true" focusable="false"><path d="m5 5 10 10M15 5 5 15" /></svg>
