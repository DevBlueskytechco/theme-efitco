{% doc %}
  Renders 5 stars for a rating from 0 to 5. The accessible name comes from the
  wrapper ("Rated 4 out of 5"), so each SVG is hidden from assistive tech. A
  rating of 0 still shows 5 empty stars. Values are rounded and clamped to 0-5.

  @param {number} rating - Number of filled stars, 0 to 5
  @param {string} [testid] - data-testid on the wrapper, for E2E tests

  @example
  {% render 'rating-stars', rating: 4 %}
  {% render 'rating-stars', rating: block.settings.rating, testid: 'testimonial-rating' %}
{% enddoc %}

{%- assign stars = rating | plus: 0 | round | at_least: 0 | at_most: 5 -%}

<span
  class="rating-stars"
  role="img"
  aria-label="{{ 'blocks.testimonials.rating_label' | t: rating: stars }}"
  {% if testid != blank %}
    data-testid="{{ testid }}"
  {% endif %}
>
  {%- for index in (1..5) -%}
    <svg
      class="rating-stars__star{% if index <= stars %} rating-stars__star--filled{% endif %}"
      viewBox="0 0 13 12"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12.9661 4.53466C12.881 4.2811 12.6475 4.10101 12.3713 4.07703L8.61913 3.74887L7.13543 0.403834C7.02603 0.158687 6.77688 0 6.50005 0C6.22323 0 5.97408 0.158687 5.86468 0.404407L4.38098 3.74887L0.628233 4.07703C0.3525 4.10159 0.119615 4.2811 0.0340186 4.53466C-0.0515776 4.78821 0.0274725 5.06632 0.236057 5.24163L3.07224 7.6375L2.23591 11.186C2.17472 11.4469 2.27985 11.7166 2.5046 11.8731C2.62541 11.9572 2.76675 12 2.90928 12C3.03217 12 3.15406 11.9681 3.26347 11.905L6.50005 10.0418L9.73545 11.905C9.9722 12.0422 10.2706 12.0297 10.4949 11.8731C10.7198 11.7162 10.8248 11.4464 10.7636 11.186L9.92727 7.6375L12.7635 5.24211C12.972 5.06632 13.0517 4.78869 12.9661 4.53466Z" />
    </svg>
  {%- endfor -%}
</span>
