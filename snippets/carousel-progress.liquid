{%- doc -%}
  Thin progress line under a horizontal list, in place of the browser scrollbar.
  assets/scroll-buttons.js sets --scroll-size and --scroll-pos on it. Decorative only:
  the list itself stays keyboard scrollable.

  @example
  {% render 'carousel-progress' %}
{%- enddoc -%}
<div class="carousel-progress" aria-hidden="true" data-scroll-progress>
  <span class="carousel-progress__thumb"></span>
</div>
