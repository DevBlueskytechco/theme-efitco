{% doc %}
  Renders one product card (Figma 1:502): square image, sale or sold out badge,
  title link, price and up to 5 color swatches.

  Every value (image, price, links, preselected swatch) comes from the card
  variant: `variant` when passed (a variant item in a multi-source collection),
  otherwise product.selected_or_first_available_variant.

  Swatches are native radio inputs and work without JavaScript (selection only).
  assets/product-swatch.js (BE) upgrades the root `product-swatch` element and
  swaps image, links and price from the data-* hooks below. No partial is used.

  JS hooks: on each swatch input `data-variant-id`, `data-variant-url`,
  `data-image-src`, `data-image-srcset`, `data-image-alt`, `data-badge`
  (sale | sold_out | none) and `data-badge-label` (translated text, empty for
  none); `data-card-image` on the img, `data-card-link` on the image and title
  links (the "+N" link keeps product.url and has no hook), `data-card-price` on
  the price wrapper; when the price varies, one
  `template[data-price-for="<variant id>"]` per swatch holds that variant's
  price markup.

  Badge: one `[data-card-badge]` element is always rendered, `hidden` when
  none. To show a swatch's badge, copy its data-badge to the badge's
  data-badge (CSS styles from it), set the text to data-badge-label, toggle
  `hidden` for none and set data-testid to product-card-badge-sale,
  product-card-badge-sold-out or product-card-badge.
  Rule: sold_out when the product or the variant is unavailable; sale when
  compare_at_price > price, label -N% (rounded) or Sale when N rounds to 0.

  New badge (AC-H14, ES1-T174): product tag `new`, lowercase, exact match. It is
  a separate element without data-card-badge, so assets/product-swatch.js leaves
  it alone. Only 1 badge shows on the start corner, Sold out > -N% > New: CSS
  hides New while `[data-card-badge]` is visible, also after a swatch change.

  Rating badge (AC-H13): reviews.rating metafield, .value.rating over
  .value.scale_max, brought to a scale of 5 as in blocks/featured-product. It sits
  on the end corner. Without the metafield there is no badge and no default value.
  Star and visible number are hidden from assistive tech; a translated
  visually hidden sentence is read instead.

  Test hooks for badges: product-card-badge-new, product-card-rating,
  product-card-rating-value.

  Storefront event shopify:product:view (ES1-T76, TE-4 AC12): the card sits in
  <s-view-event view-event-trigger="intersect"> with product |
  standard_event_data, so the event fires when the card scrolls into view.
  The element is defined by assets/standard-events.js (BE ES1-T81, layout).
  Context: collection (grids) or recommendation (product recommendations,
  ES1-T65); any other value falls back to collection.

  @param {product} product - The product to render
  @param {variant} [variant] - Variant to show. Default: product.selected_or_first_available_variant
  @param {string} [id_prefix] - Prefix for input ids and radio names, so the same product can appear twice on a page. Default: 'card'
  @param {string} [sizes] - The image sizes attribute. Default: '(min-width: 80rem) 25vw, (min-width: 48rem) 33vw, 50vw'
  @param {string} [loading] - The image loading attribute. Default: 'lazy'
  @param {string} [heading_level] - Tag for the title: h2 to h6. Default: 'h3'
  @param {string} [card_context] - View event context: 'collection' or 'recommendation'. Default: 'collection'
  @param {boolean} [show_swatches] - false: no swatch fieldset, for a card fixed to one variant (blocks/bundle-builder). Default: true

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, id_prefix: 'related', card_context: 'recommendation' %}
  {% render 'product-card', product: item.product, variant: item, id_prefix: 'featured', loading: 'eager' %}
{% enddoc %}

{%- liquid
  assign card_variant = variant | default: product.selected_or_first_available_variant

  assign uid = id_prefix | default: 'card' | append: '-' | append: product.id
  if variant != blank
    assign uid = uid | append: '-' | append: variant.id
  endif

  assign image_sizes = sizes | default: '(min-width: 80rem) 25vw, (min-width: 48rem) 33vw, 50vw'
  assign image_loading = loading | default: 'lazy'

  assign heading_tag = 'h3'
  case heading_level
    when 'h2', 'h3', 'h4', 'h5', 'h6'
      assign heading_tag = heading_level
  endcase

  assign view_context = 'collection'
  if card_context == 'recommendation'
    assign view_context = 'recommendation'
  endif

  assign card_image =card_variant.featured_image | default: product.featured_image
  assign card_alt = card_image.alt | default: product.title

  # Badge of the card variant. Same rule as data-badge on each swatch below.
  assign badge = 'none'
  assign badge_label = ''
  if product.available == false or card_variant.available == false
    assign badge = 'sold_out'
    assign badge_label = 'products.card.sold_out' | t
  elsif card_variant.compare_at_price > card_variant.price
    assign badge = 'sale'
    assign sale_percent = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round
    if sale_percent > 0
      assign badge_label = 'products.card.sale_percent' | t: percent: sale_percent
    else
      assign badge_label = 'products.card.sale' | t
    endif
  endif

  case badge
    when 'sale'
      assign badge_testid = 'product-card-badge-sale'
    when 'sold_out'
      assign badge_testid = 'product-card-badge-sold-out'
    else
      assign badge_testid = 'product-card-badge'
  endcase

  assign is_new = false
  if product.tags contains 'new'
    assign is_new = true
  endif

  assign rating_data = product.metafields.reviews.rating.value
  assign rating_value = rating_data.rating
  if rating_value != blank
    assign rating_scale = rating_data.scale_max | plus: 0
    if rating_scale <= 0
      assign rating_scale = 5
    endif
    assign rating_on_five = rating_value | times: 5.0 | divided_by: rating_scale | round: 1
  endif

  # custom.swatch_colors: hex colors separated by commas, for a color option without native swatches
  assign swatch_colors = product.metafields.custom.swatch_colors.value | split: ','
  assign swatch_option = nil
  for option in product.options_with_values
    if option.values.size > 1
      if option.values.first.swatch != blank or swatch_colors.size > 0
        assign swatch_option = option
        break
      endif
    endif
  endfor

  assign default_variant = false
  if card_variant.id == product.selected_or_first_available_variant.id
    assign default_variant = true
  endif
-%}

<s-view-event
  class="product-card__view"
  view-event-trigger="intersect"
  view-event-payload='{{ product | standard_event_data: "view", context: view_context | escape }}'
  data-testid="product-card-view-event"
>
<product-swatch class="product-card" data-testid="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media">
    <a
      class="product-card__media-link"
      href="{{ card_variant.url | default: product.url }}"
      tabindex="-1"
      aria-hidden="true"
      data-card-link
    >
      {%- if card_image -%}
        {{
          card_image
          | image_url: width: 1080
          | image_tag:
            widths: '360, 720, 1080',
            sizes: image_sizes,
            loading: image_loading,
            alt: card_alt,
            class: 'product-card__image',
            data-card-image: 'card',
            data-testid: 'product-card-image'
        }}
        {%- assign hover_media = product.media | where: 'media_type', 'image' -%}
        {%- if variant == blank and hover_media.size > 1 and swatch_option == nil -%}
          {{
            hover_media[1]
            | image_url: width: 720
            | image_tag:
              widths: '360, 720',
              sizes: image_sizes,
              loading: 'lazy',
              alt: '',
              class: 'product-card__image-hover'
          }}
        {%- endif -%}
      {%- else -%}
        <span class="product-card__placeholder" data-testid="product-card-placeholder-image">
          {{- 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' -}}
        </span>
      {%- endif -%}
    </a>

    <span
      class="product-card__badge"
      data-card-badge
      data-badge="{{ badge }}"
      data-testid="{{ badge_testid }}"
      {% if badge == 'none' %}
        hidden
      {% endif %}
    >
      {{- badge_label -}}
    </span>

    {%- if is_new -%}
      <span class="product-card__badge product-card__badge--new" data-testid="product-card-badge-new">
        {{- 'products.card.new' | t -}}
      </span>
    {%- endif -%}

    {%- if rating_value != blank -%}
      <span class="product-card__rating" data-testid="product-card-rating">
        <svg
          class="product-card__rating-star"
          viewBox="0 0 14 13"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M13.9635 4.91254C13.8718 4.63786 13.6204 4.44277 13.3229 4.41679L9.28214 4.06127L7.68431 0.437487C7.56649 0.171911 7.29817 0 7.00006 0C6.70194 0 6.43362 0.171911 6.31581 0.438108L4.71797 4.06127L0.676558 4.41679C0.379615 4.44339 0.128816 4.63786 0.0366355 4.91254C-0.0555451 5.18723 0.0295857 5.48851 0.254216 5.67843L3.30856 8.27396L2.40791 12.1182C2.342 12.4008 2.45523 12.693 2.69727 12.8626C2.82737 12.9536 2.97958 13 3.13307 13C3.26541 13 3.39669 12.9654 3.5145 12.8971L7.00006 10.8786L10.4843 12.8971C10.7393 13.0457 11.0607 13.0322 11.3022 12.8626C11.5444 12.6925 11.6575 12.4002 11.5916 12.1182L10.6909 8.27396L13.7453 5.67895C13.9699 5.48851 14.0557 5.18775 13.9635 4.91254Z" />
        </svg>
        <span aria-hidden="true" data-testid="product-card-rating-value">{{ rating_on_five }}</span>
        <span class="visually-hidden">{{ 'products.card.rating_label' | t: rating: rating_on_five }}</span>
      </span>
    {%- endif -%}
  </div>

  <{{ heading_tag }} class="product-card__title">
    <a
      class="product-card__link"
      href="{{ card_variant.url | default: product.url }}"
      data-card-link
      data-testid="product-card-title"
    >
      {{- product.title | escape -}}
    </a>
  </{{ heading_tag }}>

  <div class="product-card__price" data-card-price>
    {%- render 'price', product: product, variant: variant -%}
  </div>

  {%- if swatch_option and show_swatches != false -%}
    {%- assign option_index = swatch_option.position | minus: 1 -%}
    <fieldset class="product-card__swatches" data-testid="product-card-swatches">
      <legend class="visually-hidden">{{ swatch_option.name | escape }}</legend>

      {%- for value in swatch_option.values limit: 5 -%}
        {%- liquid
          # Variant for this value, keeping the card variant's other options (AC8)
          assign swatch_variant = value.variant
          unless default_variant
            assign swatch_variant = nil
            assign fallback_variant = nil
            for candidate in product.variants
              if candidate.options[option_index] == value.name
                if fallback_variant == nil
                  assign fallback_variant = candidate
                endif
                assign same_options = true
                for candidate_value in candidate.options
                  if forloop.index0 != option_index and candidate_value != card_variant.options[forloop.index0]
                    assign same_options = false
                    break
                  endif
                endfor
                if same_options
                  assign swatch_variant = candidate
                  break
                endif
              endif
            endfor
            if swatch_variant == nil
              assign swatch_variant = fallback_variant
            endif
          endunless

          assign swatch_image = swatch_variant.featured_image | default: product.featured_image
          assign swatch_alt = swatch_image.alt | default: product.title
          assign input_id = uid | append: '-swatch-' | append: forloop.index
          assign checked = false
          if card_variant.options[option_index] == value.name
            assign checked = true
          endif

          assign swatch_badge = 'none'
          assign swatch_badge_label = ''
          if product.available == false or swatch_variant.available == false
            assign swatch_badge = 'sold_out'
            assign swatch_badge_label = 'products.card.sold_out' | t
          elsif swatch_variant.compare_at_price > swatch_variant.price
            assign swatch_badge = 'sale'
            assign swatch_percent = swatch_variant.compare_at_price | minus: swatch_variant.price | times: 100.0 | divided_by: swatch_variant.compare_at_price | round
            if swatch_percent > 0
              assign swatch_badge_label = 'products.card.sale_percent' | t: percent: swatch_percent
            else
              assign swatch_badge_label = 'products.card.sale' | t
            endif
          endif
        -%}
        <input
          class="product-card__swatch-input visually-hidden"
          type="radio"
          id="{{ input_id }}"
          name="{{ uid }}-option"
          value="{{ value.name | escape }}"
          {% if checked %}
            checked
          {% endif %}
          {% if swatch_variant %}
            data-variant-id="{{ swatch_variant.id }}"
            data-variant-url="{{ swatch_variant.url }}"
            data-badge="{{ swatch_badge }}"
            data-badge-label="{{ swatch_badge_label | escape }}"
          {% endif %}
          {% if swatch_image %}
            data-image-src="{{ swatch_image | image_url: width: 1080 }}"
            data-image-srcset="{{ swatch_image | image_url: width: 360 }} 360w, {{ swatch_image | image_url: width: 720 }} 720w, {{ swatch_image | image_url: width: 1080 }} 1080w"
            data-image-alt="{{ swatch_alt | escape }}"
          {% endif %}
        >
        <label
          class="product-card__swatch"
          for="{{ input_id }}"
          data-testid="product-card-swatch"
          {% if value.swatch.image %}
            style="--swatch-image: url({{ value.swatch.image | image_url: width: 64 }});"
          {% elsif value.swatch.color %}
            style="--swatch-color: {{ value.swatch.color }};"
          {% elsif swatch_colors[forloop.index0] != blank %}
            style="--swatch-color: {{ swatch_colors[forloop.index0] | strip }};"
          {% endif %}
        >
          <span class="visually-hidden">{{ value.name | escape }}</span>
        </label>
        {%- if product.price_varies and swatch_variant -%}
          <template data-price-for="{{ swatch_variant.id }}">
            {%- render 'price', product: product, variant: swatch_variant -%}
          </template>
        {%- endif -%}
      {%- endfor -%}

      {%- if swatch_option.values.size > 5 -%}
        {%- assign more_count = swatch_option.values.size | minus: 5 -%}
        <a
          class="product-card__swatch-more"
          href="{{ product.url }}"
          tabindex="-1"
          aria-hidden="true"
          data-testid="product-card-swatch-more"
        >
          {{- 'products.card.more_swatches' | t: count: more_count -}}
        </a>
      {%- endif -%}
    </fieldset>
  {%- endif -%}
</product-swatch>
</s-view-event>
