{% doc %}
  Renders one decorative status icon for toasts, alert blocks and empty states
  (docs/ui-spec/foundation.md §17, §18). Stroke follows currentColor; the size
  comes from the parent class (.toast__icon 20, .alert__icon 24, .empty-state__icon 32).
  The caller supplies the text: the icon never carries meaning alone.
  Cart icons (TE-5, mini-cart-quickview.md §1): 'truck' free shipping, 'tag' discount,
  'trash' remove line, 'edit' order note, 'minus' and 'plus' quantity stepper.

  @param {string} name - Icon name: 'info', 'success', 'warning', 'error', 'cart', 'search', 'box', 'truck', 'tag', 'trash', 'edit', 'minus' or 'plus'

  @example
  {% render 'status-icon', name: 'success' %}
{% enddoc %}

{%- case name -%}
  {%- when 'info' -%}
    <svg class="status-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.25" /><path d="M12 11v5.5M12 7.5h.01" /></svg>
  {%- when 'success' -%}
    <svg class="status-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.25" /><path d="m7.75 12.25 2.75 2.75 5.75-6" /></svg>
  {%- when 'warning' -%}
    <svg class="status-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.3 4.2 2.6 17.6A2 2 0 0 0 4.3 20.6h15.4a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0Z" /><path d="M12 9.5V13M12 16.75h.01" /></svg>
  {%- when 'error' -%}
    <svg class="status-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.25" /><path d="M12 7.5V13M12 16.5h.01" /></svg>
  {%- when 'cart' -%}
    <svg class="status-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18.6 21.6H6a3 3 0 0 1-3-3.3l1-8.7a1.5 1.5 0 0 1 1.5-1.3h13.6a1.5 1.5 0 0 1 1.5 1.3l1 8.7a3 3 0 0 1-3 3.3Z" /><path d="M6.4 8.3a5.9 5.9 0 0 1 11.8 0" /></svg>
  {%- when 'search' -%}
