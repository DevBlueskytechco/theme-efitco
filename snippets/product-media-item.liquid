{% doc %}
  Content of one product media item, shared by blocks/product-media (PDP),
  blocks/featured-product and the quick view (ADR 0012). The caller owns the
  <li> (id, data-media-id, data-media-type, test hook) and the loop; this
  snippet renders only what goes inside it, by media.media_type:

  image → snippets/image.liquid, wrapped in a link to the 2048px image when
  zoom is on (zoom works without JS); video → <video> with controls,
  playsinline, preload none, never autoplay, media.sources and the preview
  image as poster, plus a fallback img; external_video → poster plus a link to
  the YouTube/Vimeo page, the iframe sits in a <template> so nothing loads from
  YouTube/Vimeo until assets/product-media.js (BE) clones it (NFR-6); model →
  model_viewer_tag over its preview image.

  loading 'eager' also sets fetchpriority high (the LCP media); any other value
  renders lazy with no fetchpriority.

  Test hooks (same as the PDP): product-media-image, product-media-zoom-link,
  product-media-video, product-media-external-video,
  product-media-external-video-template, product-media-model.

  @param {media} media - The media to render
  @param {product} product - Product of the media, its title is the fallback alt and video title
  @param {string} [loading] - 'eager' (with fetchpriority high) or 'lazy'. Default: 'lazy'
  @param {string} [sizes] - sizes attribute of the images. Default: '(min-width: 64rem) 58vw, 100vw'
  @param {string} [widths] - srcset widths of the images. Default: '360, 540, 720, 900, 1080, 1440, 1800'
  @param {string} [class_prefix] - BEM block of the classes. Default: 'product-media'
  @param {boolean} [zoom] - false renders images without the full size link. Default: true
  @param {number} [index] - Position of the media, for the zoom link name
  @param {number} [total] - Number of media, for the zoom link name

  @example
  {% render 'product-media-item',
    media: media,
    product: product,
    loading: 'lazy',
    index: forloop.index,
    total: ordered_media.size
  %}
{% enddoc %}

{%- liquid
  assign prefix = class_prefix | default: 'product-media'
  assign media_sizes = sizes | default: '(min-width: 64rem) 58vw, 100vw'
  assign media_widths = widths | default: '360, 540, 720, 900, 1080, 1440, 1800'
  assign preview = media.preview_image

  if loading == 'eager'
    assign item_loading = 'eager'
    assign item_priority = 'high'
  else
    assign item_loading = 'lazy'
    assign item_priority = nil
  endif

  assign show_zoom = true
  if zoom == false
    assign show_zoom = false
  endif

  assign image_class = prefix | append: '__image'
-%}

{%- case media.media_type -%}
  {%- when 'image' -%}
    {%- if show_zoom -%}
      <a
        class="{{ prefix }}__zoom"
        href="{{ media | image_url: width: 2048 }}"
        data-testid="product-media-zoom-link"
      >
        {% render 'image',
          image: media,
          class: image_class,
          widths: media_widths,
          sizes: media_sizes,
          loading: item_loading,
          fetchpriority: item_priority,
          inline: true,
          testid: 'product-media-image'
        %}
        <span class="visually-hidden">
          {{- 'blocks.product_media.zoom' | t: index: index, total: total -}}
        </span>
      </a>
    {%- else -%}
      {% render 'image',
        image: media,
        class: image_class,
        widths: media_widths,
        sizes: media_sizes,
        loading: item_loading,
        fetchpriority: item_priority,
        inline: true,
        testid: 'product-media-image'
      %}
    {%- endif -%}

  {%- when 'video' -%}
    {%- assign video_alt = media.alt | default: product.title -%}
    <div class="{{ prefix }}__video" data-testid="product-media-video">
      <video
        class="{{ prefix }}__video-tag"
        controls
        playsinline
        preload="none"
        {% if preview != blank %}
          poster="{{ preview | image_url: width: 1440 }}"
        {% endif %}
      >
        {%- for source in media.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
        {%- if preview != blank -%}
          {%- assign fallback_class = prefix | append: '__video-fallback' -%}
          {%- if item_priority -%}
            {{
              preview
              | image_url: width: 1440
              | image_tag:
                widths: '1440',
                sizes: media_sizes,
                alt: video_alt,
                loading: item_loading,
                fetchpriority: item_priority,
                class: fallback_class
            }}
          {%- else -%}
            {{
              preview
              | image_url: width: 1440
              | image_tag:
                widths: '1440',
                sizes: media_sizes,
                alt: video_alt,
                loading: item_loading,
                class: fallback_class
            }}
          {%- endif -%}
        {%- endif -%}
      </video>
    </div>

  {%- when 'external_video' -%}
    {%- liquid
      if media.host == 'youtube'
        assign external_url = 'https://www.youtube.com/watch?v=' | append: media.external_id
        assign external_host = 'YouTube'
      else
        assign external_url = 'https://vimeo.com/' | append: media.external_id
        assign external_host = 'Vimeo'
      endif
      assign video_title = media.alt | default: product.title
      assign iframe_class = prefix | append: '__iframe'
    -%}
    <a
      class="{{ prefix }}__external"
      href="{{ external_url }}"
      data-media-id="{{ media.id }}"
      data-testid="product-media-external-video"
    >
      {%- if preview != blank -%}
        {% render 'image',
          image: preview,
          class: image_class,
          widths: media_widths,
          sizes: media_sizes,
          loading: item_loading,
          fetchpriority: item_priority,
          inline: true,
          decorative: true
        %}
      {%- endif -%}
      <span class="{{ prefix }}__play">
        {% render 'slideshow-icon', name: 'play' %}
      </span>
      <span class="visually-hidden">
        {{- 'blocks.product_media.play_external' | t: title: video_title, host: external_host -}}
      </span>
    </a>
    <template data-media-id="{{ media.id }}" data-testid="product-media-external-video-template">
      {{- media | external_video_url: autoplay: true | external_video_tag: class: iframe_class, title: video_title -}}
    </template>

  {%- when 'model' -%}
    {%- liquid
      assign poster_class = image_class | append: ' ' | append: prefix | append: '__model-poster'
      assign viewer_class = prefix | append: '__model-viewer'
    -%}
    <div class="{{ prefix }}__model" data-testid="product-media-model">
      {%- if preview != blank -%}
        {% render 'image',
          image: preview,
          class: poster_class,
          widths: media_widths,
          sizes: media_sizes,
          loading: item_loading,
          fetchpriority: item_priority,
          inline: true,
          decorative: true
        %}
      {%- endif -%}
      {{ media | model_viewer_tag: image_size: '1440x', reveal: 'interaction', class: viewer_class }}
    </div>
{%- endcase -%}
