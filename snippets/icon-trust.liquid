{% doc %}
  Outputs one decorative trust bar icon. The text next to it carries the
  meaning, so the SVG is hidden from assistive tech.

  @param {string} icon - One of: truck, return, shield, support, quality.

  @example
  {% render 'icon-trust', icon: 'truck' %}
{% enddoc %}

<svg class="icon-trust" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M3 6h11v11H3zM14 9h4l3 3v5h-7z"/>
      <circle cx="7.5" cy="17.5" r="1.5"/>
      <circle cx="17.5" cy="17.5" r="1.5"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 0 1 0 10H9"/>
      <path d="M8 5 4 9l4 4"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/>
      <path d="m9 12 2 2 4-4"/>
    {%- when 'support' -%}
      <path d="M4 14v-2a8 8 0 0 1 16 0v2"/>
      <rect x="2.5" y="13" width="4" height="7" rx="1.5"/>
      <rect x="17.5" y="13" width="4" height="7" rx="1.5"/>
    {%- when 'quality' -%}
      <circle cx="12" cy="9" r="5"/>
      <path d="m9 13.5-1.5 7.5 4.5-2.5 4.5 2.5-1.5-7.5"/>
  {%- endcase -%}
</svg>
