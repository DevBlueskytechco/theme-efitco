{%- doc -%}
  Next and back buttons for a horizontal list. The parent is a scroll-buttons element
  (assets/scroll-buttons.js) that also holds the list with data-scroll-track. The script
  sets data-enhanced, and data-scrollable when the list is wider than the screen; until
  then CSS keeps the buttons invisible without changing the layout.

  @param {string} prefix - Start of the data-testid values, for example 'testimonials'
  @param {string} label_previous - Accessible name of the back button
  @param {string} label_next - Accessible name of the next button

  @example
  {% render 'carousel-nav', prefix: 'testimonials', label_previous: 'Previous reviews', label_next: 'Next reviews' %}
{%- enddoc -%}
<div class="carousel-nav" data-testid="{{ prefix }}-nav">
  <button
    type="button"
    class="carousel-nav__button carousel-nav__button--prev"
    aria-label="{{ label_previous | escape }}"
    data-scroll-prev
    data-testid="{{ prefix }}-prev"
  >
    {% render 'slideshow-icon', name: 'previous' %}
  </button>
  <button
    type="button"
    class="carousel-nav__button carousel-nav__button--next"
    aria-label="{{ label_next | escape }}"
    data-scroll-next
    data-testid="{{ prefix }}-next"
  >
    {% render 'slideshow-icon', name: 'next' %}
  </button>
</div>
