{% doc %}
  Cart totals and the checkout button (TE-5 AC1, AC4, AC5): subtotal, order-level
  automatic discounts, total, tax and duty note, checkout. Renders nothing when
  the cart is empty. Shared by blocks/cart-page.liquid and
  blocks/cart-drawer.liquid; render it inside their partial.

  The tax note shows only when the market price includes taxes or duties
  (cart.taxes_included, cart.duties_included).

  Test hooks: cart-subtotal, cart-discounts, cart-discount, cart-total,
  cart-tax-note, cart-checkout.

  @param {object} cart - The cart to total
  @param {string} context - Where it renders, 'page' or 'drawer'. Part of the form id

  @example
  {% render 'cart-summary', cart: cart, context: 'page' %}
{% enddoc %}

{%- if cart.item_count > 0 -%}
  {%- assign form_id = 'cart-form-' | append: context -%}

  <div class="cart-summary">
    <p class="cart-summary__row">
      <span>{{ 'cart.subtotal' | t }}</span>
      <span data-testid="cart-subtotal">{{ cart.items_subtotal_price | money }}</span>
    </p>

    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <ul class="cart-summary__discounts" role="list" data-testid="cart-discounts">
        {%- for discount in cart.cart_level_discount_applications -%}
          {%- assign discount_amount = discount.total_allocated_amount | money -%}
          <li class="cart-summary__row" data-testid="cart-discount">
            <span>{{ discount.title | escape }}</span>
            <span>{{ 'cart.discount_value' | t: amount: discount_amount }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <p class="cart-summary__row cart-summary__row--total">
      <span>{{ 'cart.total' | t }}</span>
      <span data-testid="cart-total">{{ cart.total_price | money }}</span>
    </p>

    {%- if cart.taxes_included or cart.duties_included -%}
      <p class="cart-summary__note" data-testid="cart-tax-note">
        {%- if cart.taxes_included and cart.duties_included -%}
          {{- 'cart.taxes_and_duties_included' | t -}}
        {%- elsif cart.taxes_included -%}
          {{- 'cart.taxes_included' | t -}}
        {%- else -%}
          {{- 'cart.duties_included' | t -}}
        {%- endif -%}
      </p>
    {%- endif -%}

    <button
      class="button cart-summary__checkout"
      type="submit"
      name="checkout"
      form="{{ form_id }}"
      data-testid="cart-checkout"
    >
      {{- 'cart.checkout' | t -}}
    </button>
  </div>
{%- endif -%}
