    </svg>
  {%- when 'instagram' -%}
    <svg class="icon-social" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'youtube' -%}
    <svg class="icon-social" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
