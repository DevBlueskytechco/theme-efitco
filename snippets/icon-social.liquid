{% doc %}
  Outputs one decorative social network icon. The caller names the link
  through a translated aria-label, so the SVG is hidden from assistive tech.

  @param {string} network - One of: tiktok, instagram, youtube, facebook, x, pinterest.

  @example
  {% render 'icon-social', network: 'instagram' %}
{% enddoc %}

{%- case network -%}
  {%- when 'tiktok' -%}
    <svg class="icon-social" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
