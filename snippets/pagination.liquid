{% doc %}
  Pagination links for a paginate object (TE-6 AC1, AC5): Previous, page parts,
  Next. Renders only when there is more than one page. Plain links, so it works
  without JavaScript; assets/collection-filters.js (BE) may intercept the clicks
  and must use the server-rendered href.

  Non-link parts are the current page (aria-current="page") or an ellipsis.

  Test hooks: pagination, pagination-previous, pagination-next, pagination-page,
  pagination-current.

  @param {object} paginate - The paginate object of the enclosing paginate tag
  @param {string} label - Translated aria-label of the nav

  @example
  {%- assign pagination_label = 'collections.pagination.label' | t -%}
  {% paginate collection.products by 24 %}
    {% render 'pagination', paginate: paginate, label: pagination_label %}
  {% endpaginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ label | escape }}" data-testid="pagination">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous.is_link -%}
        <li>
          <a class="pagination__link" href="{{ paginate.previous.url }}" data-testid="pagination-previous">
            {{- 'collections.pagination.previous' | t -}}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a
              class="pagination__link"
              href="{{ part.url }}"
              aria-label="{{ 'collections.pagination.page' | t: number: part.title }}"
              data-testid="pagination-page"
            >
              {{- part.title -}}
            </a>
          {%- else -%}
            {%- assign part_number = part.title | plus: 0 -%}
            {%- if part_number == paginate.current_page -%}
              <span class="pagination__link pagination__link--current" aria-current="page" data-testid="pagination-current">
                {{- part.title -}}
              </span>
            {%- else -%}
              <span class="pagination__gap">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next.is_link -%}
        <li>
          <a class="pagination__link" href="{{ paginate.next.url }}" data-testid="pagination-next">
            {{- 'collections.pagination.next' | t -}}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
