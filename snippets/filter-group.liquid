{% doc %}
  Renders one storefront filter as an open `details` group of native inputs, for
  a form GET (TE-6 AC2, AC9; docs/ui-spec/collection.md §5.2). Reads only
  `filter`, never `collection`, so search.filters can use it too (TE-8).

  Branches on filter.type, not on the filter name: Search and Discovery decides
  which filters exist. Parameter names and values come from the filter object.
  - boolean: filter.true_value, filter.false_value (either can be nil).
  - list: filter.values. filter.presentation swatch uses value.swatch, image uses
    value.image, otherwise text. Each value is snippets/filter-option.liquid: a
    native checkbox in a label that is the whole 44px row; the color name always
    shows next to the swatch.
    More than 6 values: the first 6, then a nested `details` "Show N more" with
    the rest (works without JavaScript; open when a hidden value is active).
  - price_range: 2 number inputs with a real label and the shop currency symbol
    as an aria-hidden prefix, plus the hint "Highest price is …".
    filter.min_value.value, filter.max_value.value and filter.range_max are in
    cents; the URL takes the shop currency's main unit (ES1-T104 #2), so they go
    through money_without_currency. step="any" keeps a price like 20.40 valid.

  Summary: label, "N selected" when the group has active values (list, boolean),
  chevron. A value with count 0 that is not active is disabled and struck through.

  JS hooks: data-filter-param on the group, to restore open or closed groups.
  Price error (BE, ES1-T111, on blur when min > max): show
  #<group id>-error (remove hidden), set aria-invalid="true" on both inputs and add
  the error id to their aria-describedby; do not fetch. CSS draws the 2px error
  border from aria-invalid.
  Test hooks: collection-filter-group, collection-filter-selected,
  collection-filter-more, collection-filter-price-min,
  collection-filter-price-max, collection-filter-price-hint,
  collection-filter-price-error, and the hooks of snippets/filter-option.liquid.

  @param {object} filter - The filter to render, from collection.filters or search.filters

  @example
  {% for filter in collection.filters %}
    {% render 'filter-group', filter: filter %}
  {% endfor %}
{% enddoc %}

{%- liquid
  # Fixed in code, not a setting (collection.md §2)
  assign visible_limit = 6
  assign group_id = 'filter-' | append: filter.param_name | handleize

  assign selected_count = 0
  if filter.type != 'price_range'
    assign selected_count = filter.active_values.size
  endif
-%}

<details class="filter-group" open data-filter-param="{{ filter.param_name | escape }}" data-testid="collection-filter-group">
  <summary class="filter-group__summary">
    <span class="filter-group__label">{{ filter.label | escape }}</span>
    {%- # Whitespace before the span keeps "Color 1 selected" apart in the accessible name %}
    {% if selected_count > 0 -%}
      <span class="filter-group__selected" data-testid="collection-filter-selected">
        {{- 'blocks.collection_filters.selected' | t: count: selected_count -}}
      </span>
    {%- endif -%}
    {% render 'header-icon', name: 'chevron' %}
  </summary>

  <div class="filter-group__body">
    {%- if filter.type == 'price_range' -%}
      {%- liquid
        assign price_ceiling = filter.range_max | money_without_currency | replace: ',', ''
        assign price_highest = filter.range_max | money | strip_html

        assign price_min = ''
        if filter.min_value.value != nil
          assign price_min = filter.min_value.value | money_without_currency | replace: ',', ''
        endif

        assign price_max = ''
        if filter.max_value.value != nil
          assign price_max = filter.max_value.value | money_without_currency | replace: ',', ''
        endif
      -%}
      <div class="filter-group__price">
        <div class="filter-group__price-field">
          <label class="filter-group__price-label" for="{{ group_id }}-min">
            {{- 'blocks.collection_filters.price_min' | t -}}
          </label>
          <div class="filter-group__money">
            {%- if cart.currency.symbol != blank -%}
              <span class="filter-group__currency" aria-hidden="true">{{ cart.currency.symbol }}</span>
            {%- endif -%}
            <input
              class="filter-group__price-input"
              id="{{ group_id }}-min"
              type="number"
              inputmode="decimal"
              name="{{ filter.min_value.param_name | escape }}"
              min="0"
              max="{{ price_ceiling }}"
              step="any"
              placeholder="0"
              value="{{ price_min }}"
              aria-describedby="{{ group_id }}-hint"
              data-testid="collection-filter-price-min"
            >
          </div>
        </div>
        <div class="filter-group__price-field">
          <label class="filter-group__price-label" for="{{ group_id }}-max">
            {{- 'blocks.collection_filters.price_max' | t -}}
          </label>
          <div class="filter-group__money">
            {%- if cart.currency.symbol != blank -%}
              <span class="filter-group__currency" aria-hidden="true">{{ cart.currency.symbol }}</span>
            {%- endif -%}
            <input
              class="filter-group__price-input"
              id="{{ group_id }}-max"
              type="number"
              inputmode="decimal"
              name="{{ filter.max_value.param_name | escape }}"
              min="0"
              max="{{ price_ceiling }}"
              step="any"
              placeholder="{{ price_ceiling }}"
              value="{{ price_max }}"
              aria-describedby="{{ group_id }}-hint"
              data-testid="collection-filter-price-max"
            >
          </div>
        </div>
        <p class="filter-group__price-hint" id="{{ group_id }}-hint" data-testid="collection-filter-price-hint">
          {{- 'blocks.collection_filters.price_highest' | t: price: price_highest -}}
        </p>
        <p class="filter-group__price-error" id="{{ group_id }}-error" hidden data-testid="collection-filter-price-error">
          {%- render 'status-icon', name: 'error' -%}
          <span>{{ 'blocks.collection_filters.price_invalid' | t }}</span>
        </p>
      </div>
    {%- else -%}
      {%- liquid
        assign option_total = filter.values.size
        if filter.type == 'boolean'
          assign option_total = 2
        endif

        assign more_count = option_total | minus: visible_limit
        assign more_open = false
        if more_count > 0
          for hidden_value in filter.values offset: visible_limit
            if hidden_value.active
              assign more_open = true
              break
            endif
          endfor
        endif

        assign first_total = option_total | at_most: visible_limit
      -%}
      <ul class="filter-group__options" role="list">
        {%- for option_number in (1..first_total) -%}
          {%- liquid
            if filter.type == 'boolean'
              if option_number == 1
                assign value = filter.true_value
              else
                assign value = filter.false_value
              endif
            else
              assign value_index = option_number | minus: 1
              assign value = filter.values[value_index]
            endif
          -%}
          {%- if value -%}
            <li>{% render 'filter-option', value: value, presentation: filter.presentation %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if more_count > 0 -%}
        <details
          class="filter-group__more"
          {% if more_open %}
            open
          {% endif %}
        >
          <summary class="filter-group__more-toggle" data-testid="collection-filter-more">
            <span class="filter-group__more-show">
              {{- 'blocks.collection_filters.show_more' | t: count: more_count -}}
            </span>
            <span class="filter-group__more-hide">{{ 'blocks.collection_filters.show_less' | t }}</span>
            <span class="visually-hidden">
              {{- 'blocks.collection_filters.show_more_label' | t: label: filter.label -}}
            </span>
          </summary>
          <ul class="filter-group__options" role="list">
            {%- for value in filter.values offset: visible_limit -%}
              <li>{% render 'filter-option', value: value, presentation: filter.presentation %}</li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    {%- endif -%}
  </div>
</details>
