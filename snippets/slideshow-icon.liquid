{% doc %}
  Renders one inline, decorative slideshow icon that follows currentColor.

  @param {string} name - Icon name: 'previous', 'next', 'pause', 'play', 'arrow' or 'send'

  @example
  {% render 'slideshow-icon', name: 'next' %}
{% enddoc %}

{%- case name -%}
  {%- when 'previous' -%}
