{% doc %}
  Decorative round seal on the featured product image (Figma 1:761, CR-7, SVG from
  drafts/designer/ES1-T174/seal-1-761.svg). Hidden from assistive tech and from the
  pointer. The ring text uses the locale and the shop name (ES1-T200 #5), so
  another merchant does not see Efitco on the image. The name is cut at 12
  characters, because a longer one would overlap on the ring.

  Test hook: data-testid="featured-product-seal".

  @param {string} id - Id of the ring path, unique on the page

  @example
  {% render 'featured-product-seal', id: 'FeaturedSeal-123' %}
{% enddoc %}

{%- liquid
  assign seal_label = 'blocks.featured_product.seal_label' | t | replace: ' ', '&#160;&#160;'
  assign seal_name = shop.name | truncate: 12, '' | escape
-%}

<svg class="featured-product__seal" viewBox="0 0 113 112" width="113" height="112" fill="currentColor" aria-hidden="true" focusable="false" data-testid="featured-product-seal">
  <path d="M44 45c0-3.500 5-5 12.500-5S69 41.500 69 45c0 2.600-1 4.600-2.700 6.600l-2.700-2c1.200-1.400 1.800-2.800 1.800-4 0-1.200-3.800-2-8.900-2s-8.900.8-8.900 2c0 1.200.6 2.600 1.800 4l-2.700 2C45 49.600 44 47.600 44 45Z"/>
  <path fill-rule="evenodd" d="M56.500 49a11.500 11.500 0 1 1 0 23 11.500 11.500 0 0 1 0-23Zm0 4.750a6.750 6.750 0 1 0 0 13.500 6.750 6.750 0 0 0 0-13.500Z"/>
  <path id="{{ id }}" fill="none" d="M99.030 57.170A41.850 41.850 0 1 1 15.330 57.170 41.850 41.850 0 1 1 99.030 57.170" transform="rotate(-16 57.180 57.170)"/>
  <text opacity=".4" font-size="16" font-weight="600" letter-spacing="-.32">
    <textPath href="#{{ id }}" textLength="262" lengthAdjust="spacing">{{ seal_label }}&#160;&#160;&#160;-&#160;&#160;&#160;{{ seal_name }}&#160;&#160;-&#160;&#160;</textPath>
  </text>
</svg>
