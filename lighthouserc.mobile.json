{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "${PREVIEW_URL}/",
        "${PREVIEW_URL}/products/${BENCH_PRODUCT}",
        "${PREVIEW_URL}/collections/${BENCH_COLLECTION}"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.98
          }
        ]
      }
    }
  }
}
