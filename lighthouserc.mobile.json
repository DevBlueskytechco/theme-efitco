{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "puppeteerScript": "scripts/lhci-auth.js",
      "puppeteerLaunchOptions": {
        "args": [
          "--no-sandbox"
        ]
      },
      "settings": {
        "disableStorageReset": true
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.78
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
