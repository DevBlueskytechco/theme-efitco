<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? and settings.type_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {% unless settings.type_primary_font.system? %}
      {% comment %} Preload only the body font base variant (ADR 0003: preload 1 font) {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <div class="header-sticky-sentinel" data-testid="header-sticky-sentinel" aria-hidden="true"></div>

    {% block 'container', tag: 'div' %}
      {% block 'announcement-bar' -%}{%- endblock %}
    {% endblock %}

    {% block 'container', tag: 'div' %}
      {% block 'header' -%}{%- endblock %}
    {% endblock %}

    <main>
      {{ content_for_layout }}
    </main>

    {% block 'container', tag: 'div' %}
      {% block 'footer', newsletter_image: images['efx-news.jpg'] -%}{%- endblock %}
    {% endblock %}

    {% # No container: the dialog sits outside the page flow, it is not a band. %}
    {% block 'cart-drawer' -%}{%- endblock %}

    {% comment %}
      ES1-T415: no module script in <head>. Shopify adds the import map for
      @shopify/partial-rendering after content_for_header; a module requested
      before it stops the map from applying. Modules defer, so order is safe here.
    {% endcomment %}
    <script src="{{ 'standard-events.js' | asset_url }}" type="module"></script>
    <script src="{{ 'motion.js' | asset_url }}" type="module"></script>
  </body>
</html>
