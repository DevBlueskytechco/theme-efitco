{% doc %}
  Related or complementary products for the global `product` (TE-4 AC7
  markup, drafts/techlead/ES1-T59/task-split.md D7). Recommendations can't be
  rendered on the server here (they need a section id), so this block renders
  an empty shell and assets/product-recommendations.js (BE ES1-T68) fills it.

  Root custom element product-recommendations, `hidden` on the storefront.
  JS hooks on the root: data-intent (related | complementary), data-url
  (routes.product_recommendations_url, JS appends .json?product_id=&limit=&intent=),
  data-product-id, data-limit (products_to_show), data-money-format
  (shop.money_format, escaped). With results, JS appends one clone of the
  template content per product to the list and removes `hidden`; 0 results
  or an error keeps it hidden.

  Template card (no swatch): `li` > card with
  - [data-card-link] on the image link and the title link (set href),
  - [data-card-image] img (set src/srcset, width/height from JSON; alt stays
    empty because the title link names the product; remove it when the
    product has no image, the link keeps the cream background),
  - [data-card-title] title link text,
  - [data-card-price] `.price`: add class price--on-sale when
    compare_at_price > price, fill [data-card-price-current] and
    [data-card-price-compare]. Screen reader labels follow
    snippets/price.liquid and are switched by CSS from that class,
  - [data-card-sold-out] badge, `hidden`: remove hidden when available is false.

  Theme editor (request.design_mode): the root is not hidden and shows a hint
  plus placeholder cards in [data-recommendations-placeholder]; JS does not
  fetch while that element exists. Outside the product template (no
  product) the block renders only in the editor.

  Test hooks: product-recommendations, product-recommendations-heading,
  product-recommendations-list, product-recommendations-template,
  product-recommendations-placeholder; in the template:
  product-recommendations-card, product-recommendations-card-title,
  product-recommendations-card-price, product-recommendations-card-sold-out.

  Self-contained: callers must leave the body empty.

  @param {string} id - Static block id, so the related and complementary blocks keep their own settings. Also used for the heading id
  @param {string} [intent] - Recommendation intent: 'related' or 'complementary'. Default: 'related'

  @example
  {% block 'container', id: 'product-related' %}
    {% block 'product-recommendations', id: 'product-recommendations-related', intent: 'related' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign rec_intent = 'related'
  if intent == 'complementary'
    assign rec_intent = 'complementary'
  endif

  if rec_intent == 'complementary'
    assign default_heading = 'blocks.product_recommendations.heading_complementary' | t
    assign placeholder_hint = 'blocks.product_recommendations.placeholder_complementary' | t
  else
    assign default_heading = 'blocks.product_recommendations.heading_related' | t
    assign placeholder_hint = 'blocks.product_recommendations.placeholder_related' | t
  endif

  assign heading = block.settings.heading | default: default_heading
  assign heading_id = id | default: block.id | append: '-heading'

  assign limit = block.settings.products_to_show
  assign columns = block.settings.columns_desktop
  assign columns_tablet = columns
  if columns > 3
    assign columns_tablet = 3
  endif

  assign image_sizes = '(min-width: 1280px) calc(1416px / ' | append: columns | append: '), (min-width: 768px) calc(100vw / ' | append: columns_tablet | append: '), 50vw'
-%}

{%- if product != blank or request.design_mode -%}
  <product-recommendations
    class="product-recommendations"
    style="--columns: {{ columns }}; --columns-tablet: {{ columns_tablet }};"
    data-intent="{{ rec_intent }}"
    data-url="{{ routes.product_recommendations_url }}"
    data-product-id="{{ product.id }}"
    data-limit="{{ limit }}"
    data-money-format="{{ shop.money_format | escape }}"
    {% unless request.design_mode %}
      hidden
    {% endunless %}
    data-testid="product-recommendations"
    {{ block.shopify_attributes }}
  >
    <h2 class="product-recommendations__heading" id="{{ heading_id }}" data-testid="product-recommendations-heading">
      {{- heading | escape -}}
    </h2>

    {%- if request.design_mode -%}
      <div
        class="product-recommendations__placeholder"
        data-recommendations-placeholder
        data-testid="product-recommendations-placeholder"
      >
        <p class="product-recommendations__hint">{{ placeholder_hint }}</p>
        <ul class="product-recommendations__list" role="list">
          {%- for i in (1..limit) -%}
            {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
            {%- assign placeholder_name = 'product-' | append: placeholder_index -%}
            <li class="product-recommendations__item">
              <span class="product-recommendations__placeholder-media">
                {{- placeholder_name | placeholder_svg_tag: 'product-recommendations__placeholder-svg' -}}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <ul
      class="product-recommendations__list"
      role="list"
      aria-labelledby="{{ heading_id }}"
      data-recommendations-list
      data-testid="product-recommendations-list"
    ></ul>

    <template data-recommendations-template data-testid="product-recommendations-template">
      <li class="product-recommendations__item">
        <div class="product-card" data-testid="product-recommendations-card">
          <div class="product-card__media">
            <a class="product-card__media-link" href="" tabindex="-1" aria-hidden="true" data-card-link>
              <img
                class="product-card__image"
                alt=""
                width="1080"
                height="1080"
                sizes="{{ image_sizes }}"
                loading="lazy"
                data-card-image
              >
            </a>
            <span
              class="product-card__badge"
              data-badge="sold_out"
              hidden
              data-card-sold-out
              data-testid="product-recommendations-card-sold-out"
            >
              {{- 'products.card.sold_out' | t -}}
            </span>
          </div>

          <h3 class="product-card__title">
            <a
              class="product-card__link"
              href=""
              data-card-link
              data-card-title
              data-testid="product-recommendations-card-title"
            ></a>
          </h3>

          <div class="product-card__price" data-testid="product-recommendations-card-price">
            <div class="price" data-card-price>
              <span class="visually-hidden price__label-regular">{{ 'products.price.regular_price' | t }}</span>
              <span class="visually-hidden price__label-sale">{{ 'products.price.sale_price' | t }}</span>
              <span class="price__current" data-card-price-current></span>
              <span class="price__compare-group">
                <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
                <s class="price__compare" data-card-price-compare></s>
              </span>
            </div>
          </div>
        </div>
      </li>
    </template>
  </product-recommendations>
  <script src="{{ 'product-recommendations.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:general.product_recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.product_recommendations_heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns_desktop",
      "info": "t:info.product_recommendations_columns",
      "default": 4
    }
  ]
}
{% endschema %}
