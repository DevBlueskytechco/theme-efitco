{% doc %}
  Renders the Browse Categories row: heading, back and next buttons, and a list
  of collection-card blocks that scrolls sideways with scroll-snap, touch and
  keyboard without JavaScript (assets/base.css, "Hàng ngang"). The list runs to the
  viewport edge, so the first card lines up with the heading and the next card shows
  at least 25% (TE-15 AC1: 252 at 360, 307 at 768, about 271 at 1280, 336 at 1920).

  The parent cannot read its children: the body is a rendered string, so a shorter
  list just shows fewer cards. When no card renders, the editor shows a placeholder
  and the storefront renders nothing, so the container leaves no empty band.

  Buttons and progress line come from snippets/carousel-nav and
  snippets/carousel-progress (same as testimonials, video-carousel, blog-posts).
  They stay invisible until a script sets data-enhanced on the root, always stay
  hidden below 48rem, and stay hidden when the row fits (data-static).
  assets/lazy-module.js imports assets/scroll-buttons.js when the block comes near
  the viewport (ES1-T185).

  JavaScript hooks (TE-7-R2-BE1): custom element scroll-buttons (root),
  data-enhanced and data-static (root, set by the script), data-lazy-module (root,
  URL of assets/scroll-buttons.js), data-scroll-track (list), data-scroll-prev,
  data-scroll-next (buttons), data-scroll-progress (progress line).

  Test hooks: data-testid="collection-list", "collection-list-heading",
  "collection-list-nav", "collection-list-prev", "collection-list-next",
  "collection-list-track", "carousel-progress", "collection-list-placeholder".

  @param {string} [id] - Static block id, needed when a template has more than one collection-list block
  @param {string} content - One collection-card block call per card

  @example
  {% block 'container', id: 'home-collection-list', background: 'dark' %}
    {% block 'collection-list' %}
      {% block 'collection-card', id: 'collection-card-1' %}{% endblock %}
      {% block 'collection-card', id: 'collection-card-2' %}{% endblock %}
    {% endblock %}
  {% endblock %}
{% enddoc %}

{%- assign items = content | strip -%}

{%- if items != blank -%}
  <scroll-buttons
    class="collection-list full-width"
    {% if id != blank %}
      data-collection-list-id="{{ id }}"
    {% endif %}
    data-lazy-module="{{ 'scroll-buttons.js' | asset_url }}"
    data-testid="collection-list"
    {{ block.shopify_attributes }}
  >
    <div class="collection-list__header">
      {%- if block.settings.heading != blank -%}
        <h2 class="collection-list__heading" data-testid="collection-list-heading">
          {{- block.settings.heading | escape -}}
        </h2>
      {%- endif -%}
      {%- liquid
        assign nav_previous = 'blocks.collection_list.previous' | t
        assign nav_next = 'blocks.collection_list.next' | t
      -%}
      {% render 'carousel-nav', prefix: 'collection-list', label_previous: nav_previous, label_next: nav_next %}
    </div>
    {%- comment -%}
      role="list": list-style none removes the list role in Safari, and tabindex lets
      keyboard users scroll the list (same as blocks/testimonials.liquid).
    {%- endcomment -%}
    <ul
      class="collection-list__track"
      role="list"
      tabindex="0"
      aria-label="{{ 'blocks.collection_list.list_label' | t }}"
      data-scroll-track
      data-testid="collection-list-track"
    >
      {{ content }}
    </ul>
    {% render 'carousel-progress' %}

    <script src="{{ 'lazy-module.js' | asset_url }}" type="module"></script>
  </scroll-buttons>
{%- elsif request.design_mode -%}
  <p
    class="collection-list--placeholder"
    data-testid="collection-list-placeholder"
    {{ block.shopify_attributes }}
  >
    {{ 'blocks.collection_list.placeholder' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:general.collection_list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.collection_list_heading",
      "default": "Browse Categories"
    }
  ]
}
{% endschema %}
