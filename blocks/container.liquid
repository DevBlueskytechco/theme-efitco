{% doc %}
  Wraps composed page content in a semantic HTML element. Every template
  composes its page through a container block: the block owns the outer
  layout element and renders the composed body via {{ content }}. When the body
  is empty the storefront renders nothing, so an empty band takes no space; the
  editor still renders the wrapper so the merchant can select the blocks inside.

  @param {string} [content] - The composed page content for this band
  @param {string} [id] - Static block id. Set it when a template has more than one container so each keeps its own settings, such as 'home-intro'.
  @param {string} [tag] - HTML element for the wrapper. Default: 'section'.
  @param {string} [background] - Background color token: 'alt', 'cream', 'sand' or 'dark'. Empty: no background.

  @example Default section wrapper
  {% block 'container' %}
    <h1>{{ page.title }}</h1>
    {{ page.content }}
  {% endblock %}

  @example Override the wrapper element
  {% block 'container', tag: 'div' %}
    ...
  {% endblock %}

  @example Sand background, with an id so it keeps its own settings
  {% block 'container', id: 'home-intro', background: 'sand' %}
    ...
  {% endblock %}
{% enddoc %}

{%- liquid
  assign tag = tag | default: 'section'
  assign background_class = ''
  case background
    when 'alt', 'cream', 'sand', 'dark'
      assign background_class = ' block-container--' | append: background
  endcase

  # Setting values stay left/right; CSS gets start/end so RTL flips without rewrites
  case block.settings.alignment
    when 'center'
      assign text_align = 'center'
    when 'right'
      assign text_align = 'end'
    else
      assign text_align = 'start'
  endcase

  assign body = content | strip
-%}

{%- if body != blank or request.design_mode -%}
  <{{ tag }}
    class="block-container{{ background_class }}"
    style="--text-align: {{ text_align }};"
    {% if id != blank %}
      data-testid="container-{{ id }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ content }}
  </{{ tag }}>
{%- endif -%}

{% schema %}
{
  "name": "t:general.container",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
