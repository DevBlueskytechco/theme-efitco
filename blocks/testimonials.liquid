{% doc %}
  Renders customer reviews: eyebrow, heading and a list of testimonial-item
  blocks. No JavaScript: under 48rem the list scrolls sideways with scroll-snap
  and takes keyboard focus, from 48rem it is a grid, and from 120rem exactly 4
  reviews are 456px cards that run past the viewport edge and scroll sideways with
  mouse and keyboard (assets/base.css).

  The parent cannot read its children: the body is a rendered string, so columns
  come from CSS and adding a review means adding one line in the template. When
  the body is empty, the editor shows a placeholder and the storefront renders
  nothing.

  Sample content (plan ES1-T169 D1): the template passes default_eyebrow and
  default_heading from locales. They have other names than the settings, so a value
  the merchant saved always wins. Text from the t filter may already be escaped, so
  it goes through escape_once.

  Test hooks: data-testid="testimonials", "testimonials-heading",
  "testimonials-list", "testimonials-placeholder".

  @param {string} [id] - Static block id, needed when a template has more than one testimonials block
  @param {string} [default_eyebrow] - Sample text used when the eyebrow setting is empty
  @param {string} [default_heading] - Sample text used when the heading setting is empty
  @param {string} content - One testimonial-item block call per review, 1 to 6

  @example
  {% assign sample_heading = 'blocks.testimonials.default_heading' | t %}
  {% block 'container', id: 'home-testimonials', background: 'cream' %}
    {% block 'testimonials', default_heading: sample_heading %}
      {% block 'testimonial-item', id: 'testimonial-1' %}{% endblock %}
      {% block 'testimonial-item', id: 'testimonial-2' %}{% endblock %}
    {% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign items = content | strip
  assign testimonials_eyebrow = block.settings.eyebrow | default: default_eyebrow
  assign testimonials_heading = block.settings.heading | default: default_heading
-%}

{%- if items != blank -%}
  <scroll-buttons
    class="testimonials"
    {% if id != blank %}
      data-testimonials-id="{{ id }}"
    {% endif %}
    data-lazy-module="{{ 'scroll-buttons.js' | asset_url }}"
    data-testid="testimonials"
    {{ block.shopify_attributes }}
  >
    <div class="testimonials__header">
        {%- if testimonials_eyebrow != blank -%}
          <p class="testimonials__eyebrow">{{ testimonials_eyebrow | escape_once }}</p>
        {%- endif -%}
        {%- if testimonials_heading != blank -%}
          <h2 class="testimonials__heading" data-testid="testimonials-heading">
            {{- testimonials_heading | escape_once -}}
          </h2>
        {%- endif -%}
      {%- liquid
        assign nav_previous = 'blocks.testimonials.previous' | t
        assign nav_next = 'blocks.testimonials.next' | t
      -%}
      {% render 'carousel-nav', prefix: 'testimonials', label_previous: nav_previous, label_next: nav_next %}
    </div>
    {%- comment -%}
      role="list": a ul with any other role makes each li fail the axe rule
      listitem (serious). It also keeps list semantics with list-style: none.
    {%- endcomment -%}
    <ul
      class="testimonials__list"
      role="list"
      tabindex="0"
      aria-label="{{ 'blocks.testimonials.list_label' | t }}"
      data-scroll-track
      data-testid="testimonials-list"
    >
      {{ content }}
    </ul>
    {% render 'carousel-progress' %}
    <script src="{{ 'lazy-module.js' | asset_url }}" type="module"></script>
  </scroll-buttons>
{%- elsif request.design_mode -%}
  <p
    class="testimonials testimonials--placeholder"
    data-testid="testimonials-placeholder"
    {{ block.shopify_attributes }}
  >
    {{ 'blocks.testimonials.placeholder' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:general.testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.testimonials_eyebrow",
      "info": "t:info.sample_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.testimonials_heading",
      "info": "t:info.sample_text"
    }
  ]
}
{% endschema %}
