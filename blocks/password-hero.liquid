{% doc %}
  Password page hero (docs/ui-spec/password.md §2, TE-21 AC9 to AC12), rendered
  by templates/password.liquid inside layout/password.liquid (dark page with
  noise, no header or footer).

  Order: top bar with the theme logo (settings.logo, alt shop.name, not a link)
  or shop.name as text; eyebrow (hidden when empty); h1 (inline rich text, <em>
  in accent color, empty: locale string); shop.password_message (hidden when
  empty); newsletter form (customer form, tags newsletter and password-page);
  "Have a password?" divider; <details> "Enter Using Password" holding the
  storefront password form; image card; footer with the admin login link and
  powered_by_link.

  Show newsletter off: no newsletter form, no divider, the password form is
  open. A wrong password reloads the page with form.errors: the details render
  open and the input gets aria-invalid. Both forms work without JavaScript.
  Empty image: a translucent card from 48rem, nothing below.

  JavaScript hooks (BE, not loaded by this block): data-password-toggle on the
  hidden show-password button (remove hidden, flip aria-pressed and the input
  type, swap the label between data-label-show and data-label-hide);
  aria-busy on the submit buttons while sending.

  Test hooks: data-testid="password-hero", "password-logo", "password-heading",
  "password-message", "password-newsletter", "password-newsletter-email",
  "password-newsletter-submit", "password-newsletter-error",
  "password-newsletter-success", "password-details", "password-input",
  "password-error", "password-toggle", "password-submit", "password-media".

  @example
  {% block 'container', id: 'password' %}
    {% block 'password-hero' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign eyebrow = block.settings.eyebrow | strip
  assign heading = block.settings.heading | strip
  assign image = block.settings.image
  assign show_newsletter = block.settings.show_newsletter
-%}

<div
  class="password-hero{% if image == blank %} password-hero--no-image{% endif %}"
  data-testid="password-hero"
  {{ block.shopify_attributes }}
>
  <p class="password-hero__bar password-logo" data-testid="password-logo">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 200
        | image_tag: alt: shop.name, class: 'password-logo__image', widths: '100, 200', sizes: '100px', loading: 'eager'
      }}
    {%- else -%}
      <span class="password-logo__text">{{ shop.name | escape }}</span>
    {%- endif -%}
  </p>

  <div class="password-hero__content">
    {%- if eyebrow != blank -%}
      <p class="password-hero__eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="password-hero__heading" data-testid="password-heading">
      {%- if heading != blank -%}
        {{- heading -}}
      {%- else -%}
        {{- 'password.title' | t -}}
      {%- endif -%}
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="password-hero__message" data-testid="password-message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if show_newsletter -%}
      {%- form 'customer', id: 'PasswordNewsletter', class: 'password-hero__newsletter', data-testid: 'password-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        {%- if form.posted_successfully? -%}
          <div class="password-hero__success" role="status" tabindex="-1" data-testid="password-newsletter-success">
            <p class="password-hero__success-title">{{ 'password.newsletter_success' | t }}</p>
            <p>{{ 'password.newsletter_success_text' | t }}</p>
          </div>
        {%- else -%}
          <label class="password-hero__label" for="PasswordNewsletterEmail">{{ 'password.newsletter_label' | t }}</label>
          <div class="password-hero__field">
            <input
              class="password-hero__input"
              id="PasswordNewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              placeholder="{{ 'password.newsletter_placeholder' | t }}"
              aria-describedby="PasswordNewsletterNote{% if form.errors %} PasswordNewsletterError{% endif %}"
              data-testid="password-newsletter-email"
              {% if form.errors %}
                value="{{ form.email | escape }}"
                aria-invalid="true"
              {% endif %}
            >
            <button class="button password-hero__submit" type="submit" data-testid="password-newsletter-submit">
              {%- render 'slideshow-icon', name: 'send' -%}
              <span>{{ 'password.notify' | t }}</span>
            </button>
          </div>
          {%- if form.errors -%}
            <div class="password-hero__error" id="PasswordNewsletterError" role="alert" data-testid="password-newsletter-error">
              {{- form.errors | default_errors -}}
            </div>
          {%- else -%}
            <p class="password-hero__invalid password-hero__error" aria-hidden="true">
              {{- 'password.newsletter_invalid' | t -}}
            </p>
          {%- endif -%}
          <p class="password-hero__note" id="PasswordNewsletterNote">{{ 'password.newsletter_note' | t }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="password-hero__divider">{{ 'password.have_password' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password', id: 'PasswordForm', class: 'password-hero__password-form' -%}
      <details
        class="password-hero__details"
        data-testid="password-details"
        {% if form.errors or show_newsletter == false %}
          open
        {% endif %}
      >
        <summary class="button button--secondary password-hero__summary">
          <span class="password-hero__lock" aria-hidden="true"></span>
          <span>{{ 'password.enter_using' | t }}</span>
          {%- render 'header-icon', name: 'chevron' -%}
        </summary>
        <div class="password-hero__details-body">
          <label class="password-hero__label" for="PasswordInput">{{ 'password.password' | t }}</label>
          <div class="password-hero__password-field">
            <input
              class="password-hero__input"
              id="PasswordInput"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              data-testid="password-input"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="PasswordError"
              {% endif %}
            >
            <button
              class="password-hero__toggle"
              type="button"
              aria-pressed="false"
              aria-controls="PasswordInput"
              aria-label="{{ 'password.show_password' | t }}"
              data-password-toggle
              data-label-show="{{ 'password.show_password' | t }}"
              data-label-hide="{{ 'password.hide_password' | t }}"
              data-testid="password-toggle"
              hidden
            >
              <svg class="password-hero__eye" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M1.5 10S4.5 4 10 4s8.5 6 8.5 6-3 6-8.5 6-8.5-6-8.5-6Z"/><circle cx="10" cy="10" r="2.5"/></svg>
            </button>
          </div>
          {%- if form.errors -%}
            <p class="password-hero__error" id="PasswordError" role="alert" data-testid="password-error">
              {{- 'password.error' | t -}}
            </p>
          {%- endif -%}
          <button class="button password-hero__enter" type="submit" data-testid="password-submit">
            {{- 'password.enter_store' | t -}}
          </button>
        </div>
      </details>
    {%- endform -%}
  </div>

  <div class="password-hero__media" data-testid="password-media">
    {%- if image != blank -%}
      {% render 'image',
        image: image,
        class: 'password-hero__image',
        decorative: true,
        width: 1440,
        widths: '720, 1080, 1440',
        sizes: '(min-width: 64rem) 50vw, 100vw',
        loading: 'eager',
        fetchpriority: 'high'
      %}
    {%- endif -%}
  </div>

  <p class="password-hero__footer">
    <span>
      {{- 'password.owner' | t }}
      <a href="/admin" class="password-hero__footer-link">{{ 'password.owner_link' | t }}</a>
    </span>
    <span class="password-hero__powered">{{ powered_by_link }}</span>
  </p>
</div>

{% schema %}
{
  "name": "t:general.password_hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.password_eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.password_heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.password_image",
      "info": "t:info.password_image"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:labels.password_show_newsletter",
      "info": "t:info.password_show_newsletter",
      "default": true
    }
  ]
}
{% endschema %}
