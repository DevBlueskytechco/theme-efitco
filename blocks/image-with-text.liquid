{% doc %}
  Renders eyebrow, heading, rich text and a button next to images. No JavaScript.

  Layout split (Figma 1:992): main image and text side by side from 64rem, image
  above text below 64rem. The image_position setting swaps the columns with CSS
  order. Accent images 1 and 2 sit at the inline-end edge of the text column from
  80rem and are hidden below. Accent image 3 is not rendered. Without a main image
  the storefront keeps the dark frame and the editor adds a hint inside it.

  Layout banner (Figma 1:625): no main image, image_position has no effect, text
  is centered. Accent images 1, 2 and 3 are scattered from 80rem and form a row
  above the text below 80rem.

  Sample content (plan ES1-T169 D1): the template passes default_* from locales, a
  different set for each of the 2 uses on the home page. They have other names than
  the settings, so they stay plain variables and a value the merchant saved always
  wins. Clearing a setting brings the sample back, so show_item is how a merchant
  hides the block. Text from the t filter may already be escaped, so it goes through
  escape_once; default_heading and default_body are HTML.

  Empty accent images are skipped. When show_item is off, or all text and all images
  of the layout are empty, the editor shows a placeholder and the storefront renders
  nothing. Colors follow the band set by the parent container. On a sand banner, a
  strong element in default_heading stays dark and the rest of the heading is muted
  (Figma 1:629). Self-contained: callers must leave the body empty.

  Test hooks: data-testid="image-with-text", "image-with-text-image",
  "image-with-text-image-placeholder", "image-with-text-content",
  "image-with-text-accent", "image-with-text-eyebrow", "image-with-text-heading",
  "image-with-text-body", "image-with-text-button", "image-with-text-placeholder".

  @param {string} [id] - Static block id, needed when a template has more than one image-with-text block
  @param {string} [layout] - 'split' or 'banner'. Default: 'split'. Set in the template, not a merchant setting
  @param {string} [default_eyebrow] - Sample text used when the eyebrow setting is empty
  @param {string} [default_heading] - Sample heading as HTML, used when the heading setting is empty
  @param {string} [default_body] - Sample text as HTML, used when the text setting is empty
  @param {string} [default_button_label] - Sample text used when the button label setting is empty

  @example
  {% assign sample_heading = 'blocks.image_with_text.banner_heading_html' | t %}
  {% block 'container', id: 'home-inspiration', background: 'sand' %}
    {% block 'image-with-text', id: 'inspiration', layout: 'banner', default_heading: sample_heading %}{% endblock %}
  {% endblock %}

  @example
  {% block 'container', id: 'home-why-choose', background: 'dark' %}
    {% block 'image-with-text', id: 'why-choose' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign eyebrow = block.settings.eyebrow | default: default_eyebrow
  assign heading = block.settings.heading | escape | default: default_heading
  assign body = block.settings.body | default: default_body
  assign button_label = block.settings.button_label | default: default_button_label
  assign button_url = block.settings.button_url | default: routes.all_products_collection_url
  assign image = block.settings.image
  assign accent_image_1 = block.settings.accent_image_1
  assign accent_image_2 = block.settings.accent_image_2
  assign accent_image_3 = block.settings.accent_image_3

  assign is_banner = false
  if layout == 'banner'
    assign is_banner = true
  endif

  if is_banner
    assign layout_class = 'image-with-text--banner full-width'
    assign accent_1_sizes = '(min-width: 80rem) min(280px, 14.58vw), (min-width: 48rem) 200px, 30vw'
    assign accent_2_sizes = '(min-width: 80rem) min(187px, 9.74vw), (min-width: 48rem) 200px, 30vw'
    assign accent_3_sizes = '(min-width: 80rem) min(200px, 10.42vw), (min-width: 48rem) 200px, 30vw'
  else
    assign layout_class = 'image-with-text--split full-width'
    if block.settings.image_position == 'right'
      assign layout_class = 'image-with-text--split image-with-text--image-right full-width'
    endif
    assign accent_1_sizes = 'min(201px, 10.47vw)'
    assign accent_2_sizes = 'min(120px, 6.25vw)'
  endif

  assign has_text = false
  if eyebrow != blank or heading != blank or body != blank or button_label != blank
    assign has_text = true
  endif
-%}

{%- capture accents -%}
  {%- if accent_image_1 != blank -%}
    {% render 'image',
      image: accent_image_1,
      class: 'image-with-text__accent image-with-text__accent--1',
      width: 560,
      height: 560,
      crop: 'center',
      widths: '120, 240, 360, 560',
      sizes: accent_1_sizes,
      loading: 'lazy',
      testid: 'image-with-text-accent'
    %}
  {%- endif -%}
  {%- if accent_image_2 != blank -%}
    {% render 'image',
      image: accent_image_2,
      class: 'image-with-text__accent image-with-text__accent--2',
      width: 560,
      height: 560,
      crop: 'center',
      widths: '120, 240, 360, 560',
      sizes: accent_2_sizes,
      loading: 'lazy',
      testid: 'image-with-text-accent'
    %}
  {%- endif -%}
  {%- if is_banner and accent_image_3 != blank -%}
    {% render 'image',
      image: accent_image_3,
      class: 'image-with-text__accent image-with-text__accent--3',
      width: 560,
      height: 560,
      crop: 'center',
      widths: '120, 240, 360, 560',
      sizes: accent_3_sizes,
      loading: 'lazy',
      testid: 'image-with-text-accent'
    %}
  {%- endif -%}
{%- endcapture -%}

{%- capture text -%}
  {%- if has_text -%}
    <div class="image-with-text__content" data-testid="image-with-text-content">
      {%- if eyebrow != blank -%}
        <p class="image-with-text__eyebrow" data-testid="image-with-text-eyebrow">{{ eyebrow | escape_once }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="image-with-text__heading" data-testid="image-with-text-heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if body != blank -%}
        <div class="image-with-text__body" data-testid="image-with-text-body">{{ body }}</div>
      {%- endif -%}
      {%- if button_label != blank -%}
        <a class="button image-with-text__button" href="{{ button_url }}" data-testid="image-with-text-button">
          {{- button_label | escape_once -}}
          {%- render 'slideshow-icon', name: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign accents = accents | strip

  assign has_image = false
  if accents != blank
    assign has_image = true
  elsif is_banner == false and image != blank
    assign has_image = true
  endif

  assign show_item = false
  if has_text or has_image
    assign show_item = true
  endif
  if block.settings.show_item == false
    assign show_item = false
  endif
-%}

{%- if show_item -%}
  <div
    class="image-with-text {{ layout_class }}"
    {% if id != blank %}
      data-image-with-text-id="{{ id }}"
    {% endif %}
    data-testid="image-with-text"
    {{ block.shopify_attributes }}
  >
    {%- if is_banner -%}
      {%- if accents != blank -%}
        <div class="image-with-text__accents">{{ accents }}</div>
      {%- endif -%}
      {{ text }}
    {%- else -%}
      {%- if image != blank -%}
        {% render 'image',
          image: image,
          class: 'image-with-text__media',
          width: 1840,
          widths: '360, 720, 1080, 1440, 1840',
          sizes: '(min-width: 64rem) 48vw, 100vw',
          loading: 'lazy',
          testid: 'image-with-text-image'
        %}
      {%- else -%}
        <div class="image-with-text__media image-with-text__media--empty" data-testid="image-with-text-image-placeholder">
          {%- if request.design_mode -%}
            <p class="image-with-text__media-hint">{{ 'blocks.image_with_text.image_placeholder' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="image-with-text__panel">
        {{ text }}
        {%- if accents != blank -%}
          <div class="image-with-text__accents">{{ accents }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <p
    class="image-with-text image-with-text--placeholder"
    data-testid="image-with-text-placeholder"
    {{ block.shopify_attributes }}
  >
    {{ 'blocks.image_with_text.placeholder' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_item",
      "label": "t:labels.image_with_text_show_item",
      "info": "t:info.image_with_text_show_item",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.image_with_text_eyebrow",
      "info": "t:info.image_with_text_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.image_with_text_heading",
      "info": "t:info.sample_text"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.image_with_text_body",
      "info": "t:info.sample_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.image_with_text_button_label",
      "info": "t:info.sample_text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.image_with_text_button_url",
      "info": "t:info.rich_text_button_url"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image_with_text_image",
      "info": "t:info.image_with_text_image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_with_text_image_position",
      "info": "t:info.image_with_text_image_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.image_position.left"
        },
        {
          "value": "right",
          "label": "t:options.image_position.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "accent_image_1",
      "label": "t:labels.image_with_text_accent_image_1",
      "info": "t:info.image_with_text_accent_image"
    },
    {
      "type": "image_picker",
      "id": "accent_image_2",
      "label": "t:labels.image_with_text_accent_image_2",
      "info": "t:info.image_with_text_accent_image"
    },
    {
      "type": "image_picker",
      "id": "accent_image_3",
      "label": "t:labels.image_with_text_accent_image_3",
      "info": "t:info.image_with_text_accent_image_3"
    }
  ]
}
{% endschema %}
