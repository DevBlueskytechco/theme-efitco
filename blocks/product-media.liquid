{% doc %}
  Product page gallery (TE-4 AC1). Reads the global `product`. The featured
  media of product.selected_or_first_available_variant comes first (so
  ?variant= deep links open on the variant image), then the rest of
  product.media in admin order without duplicates.

  Media filters by type: image → snippets/image.liquid wrapped in a link to
  the 2048px image (zoom works without JS); video → <video> with controls,
  preload none, media.sources and the preview image as poster, plus a
  fallback img (alt = media.alt or product.title, same loading and
  fetchpriority rule as the other media); external_video → poster plus
  a link to the YouTube/Vimeo page, the iframe sits in a <template> so nothing
  loads from YouTube/Vimeo until assets/product-media.js (BE) clones it
  (NFR-6); model → model_viewer_tag over its preview image. No media → one
  placeholder_svg_tag tile.

  Below 64rem the list scrolls sideways with scroll-snap; from 64rem it stacks.
  Thumbnails (2 media or more) are in-page links to #ProductMedia-{media.id},
  so they move the gallery without JS. aria-current on thumbnails is set by JS
  only. The zoom dialog is empty; JS opens it and fills the image. The close
  button uses form method="dialog", so it closes without JS.

  Root custom element: product-media-gallery (CSS display: block).
  Test hooks: product-media, product-media-list, product-media-item,
  product-media-image, product-media-video, product-media-external-video,
  product-media-external-video-template, product-media-model,
  product-media-placeholder, product-media-thumbnails,
  product-media-thumbnail, product-media-zoom-link,
  product-media-zoom-dialog, product-media-zoom-image,
  product-media-zoom-close.

  Self-contained: callers must leave the body empty.

  @example
  {% block 'container', id: 'product-main' %}
    {% block 'product-media' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media

  assign ordered_media = product.media
  if featured != blank
    assign featured_list = product.media | where: 'id', featured.id
    assign other_media = product.media | reject: 'id', featured.id
    assign ordered_media = featured_list | concat: other_media
  endif

  assign media_total = ordered_media.size
  assign dialog_id = 'ProductMediaZoom-' | append: block.id
  assign media_sizes = '(min-width: 64rem) 58vw, 100vw'
  assign media_widths = '360, 540, 720, 900, 1080, 1440, 1800'
-%}

<product-media-gallery
  class="product-media"
  data-media-count="{{ media_total }}"
  data-testid="product-media"
  {{ block.shopify_attributes }}
>
  <ul
    class="product-media__list"
    role="list"
    aria-label="{{ 'blocks.product_media.label' | t }}"
    data-testid="product-media-list"
  >
    {%- for media in ordered_media -%}
      {%- liquid
        assign position = forloop.index
        assign preview = media.preview_image
        if forloop.first
          assign item_loading = 'eager'
          assign item_priority = 'high'
        else
          assign item_loading = 'lazy'
          assign item_priority = nil
        endif
      -%}
      <li
        id="ProductMedia-{{ media.id }}"
        class="product-media__item"
        data-media-id="{{ media.id }}"
        data-media-type="{{ media.media_type }}"
        style="--media-ratio: {{ preview.aspect_ratio | default: 1 }};"
        data-testid="product-media-item"
      >
        {%- case media.media_type -%}
          {%- when 'image' -%}
            <a
              class="product-media__zoom"
              href="{{ media | image_url: width: 2048 }}"
              data-testid="product-media-zoom-link"
            >
              {% render 'image',
                image: media,
                class: 'product-media__image',
                widths: media_widths,
                sizes: media_sizes,
                loading: item_loading,
                fetchpriority: item_priority,
                inline: true,
                testid: 'product-media-image'
              %}
              <span class="visually-hidden">
                {{- 'blocks.product_media.zoom' | t: index: position, total: media_total -}}
              </span>
            </a>

          {%- when 'video' -%}
            {%- assign video_alt = media.alt | default: product.title -%}
            <div class="product-media__video" data-testid="product-media-video">
              <video
                class="product-media__video-tag"
                controls
                playsinline
                preload="none"
                {% if preview != blank %}
                  poster="{{ preview | image_url: width: 1440 }}"
                {% endif %}
              >
                {%- for source in media.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
                {%- if preview != blank -%}
                  {%- if item_priority -%}
                    {{
                      preview
                      | image_url: width: 1440
                      | image_tag:
                        widths: '1440',
                        sizes: media_sizes,
                        alt: video_alt,
                        loading: item_loading,
                        fetchpriority: item_priority,
                        class: 'product-media__video-fallback'
                    }}
                  {%- else -%}
                    {{
                      preview
                      | image_url: width: 1440
                      | image_tag:
                        widths: '1440',
                        sizes: media_sizes,
                        alt: video_alt,
                        loading: item_loading,
                        class: 'product-media__video-fallback'
                    }}
                  {%- endif -%}
                {%- endif -%}
              </video>
            </div>

          {%- when 'external_video' -%}
            {%- liquid
              if media.host == 'youtube'
                assign external_url = 'https://www.youtube.com/watch?v=' | append: media.external_id
                assign external_host = 'YouTube'
              else
                assign external_url = 'https://vimeo.com/' | append: media.external_id
                assign external_host = 'Vimeo'
              endif
              assign video_title = media.alt | default: product.title
            -%}
            <a
              class="product-media__external"
              href="{{ external_url }}"
              data-media-id="{{ media.id }}"
              data-testid="product-media-external-video"
            >
              {%- if preview != blank -%}
                {% render 'image',
                  image: preview,
                  class: 'product-media__image',
                  widths: media_widths,
                  sizes: media_sizes,
                  loading: item_loading,
                  fetchpriority: item_priority,
                  inline: true,
                  decorative: true
                %}
              {%- endif -%}
              <span class="product-media__play">
                {% render 'slideshow-icon', name: 'play' %}
              </span>
              <span class="visually-hidden">
                {{- 'blocks.product_media.play_external' | t: title: video_title, host: external_host -}}
              </span>
            </a>
            <template data-media-id="{{ media.id }}" data-testid="product-media-external-video-template">
              {{- media | external_video_url: autoplay: true | external_video_tag: class: 'product-media__iframe', title: video_title -}}
            </template>

          {%- when 'model' -%}
            <div class="product-media__model" data-testid="product-media-model">
              {%- if preview != blank -%}
                {% render 'image',
                  image: preview,
                  class: 'product-media__image product-media__model-poster',
                  widths: media_widths,
                  sizes: media_sizes,
                  loading: item_loading,
                  fetchpriority: item_priority,
                  inline: true,
                  decorative: true
                %}
              {%- endif -%}
              {{ media | model_viewer_tag: image_size: '1440x', reveal: 'interaction', class: 'product-media__model-viewer' }}
            </div>
        {%- endcase -%}
      </li>
    {%- else -%}
      <li class="product-media__item" data-testid="product-media-item">
        <div class="product-media__placeholder" data-testid="product-media-placeholder">
          {{- 'product-1' | placeholder_svg_tag: 'product-media__placeholder-svg' -}}
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if media_total > 1 -%}
    <ul
      class="product-media__thumbnails"
      role="list"
      aria-label="{{ 'blocks.product_media.thumbnails_label' | t }}"
      data-testid="product-media-thumbnails"
    >
      {%- for media in ordered_media -%}
        <li class="product-media__thumbnail-item">
          <a
            class="product-media__thumbnail"
            href="#ProductMedia-{{ media.id }}"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            data-testid="product-media-thumbnail"
          >
            {%- if media.preview_image != blank -%}
              {{
                media.preview_image
                | image_url: width: 160, height: 160, crop: 'center'
                | image_tag: alt: '', loading: 'lazy', class: 'product-media__thumbnail-image'
              }}
            {%- endif -%}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <span class="product-media__thumbnail-badge">
                {% render 'slideshow-icon', name: 'play' %}
              </span>
            {%- endif -%}
            <span class="visually-hidden">
              {{- 'blocks.product_media.load_media' | t: index: forloop.index, total: media_total -}}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if ordered_media.size > 0 -%}
    <dialog
      id="{{ dialog_id }}"
      class="product-media__dialog"
      scroll-lock
      aria-label="{{ 'blocks.product_media.zoom_dialog_label' | t }}"
      data-testid="product-media-zoom-dialog"
    >
      <form class="product-media__dialog-form" method="dialog">
        {% # aria-label, not hidden text: the dialog is closed (display: none) on load, so a name from hidden content is empty. %}
        <button
          class="product-media__dialog-close"
          type="submit"
          aria-label="{{ 'blocks.product_media.close' | t | escape }}"
          data-testid="product-media-zoom-close"
        >
          <span class="product-media__close-icon" aria-hidden="true"></span>
        </button>
      </form>
      {% # No src until JS sets src, alt, width and height from the clicked image, then removes hidden. %}
      <img
        class="product-media__dialog-image"
        alt=""
        width="2048"
        height="2048"
        hidden
        data-testid="product-media-zoom-image"
      >

    </dialog>
    <script src="{{ 'product-media.js' | asset_url }}" type="module"></script>
  {%- endif -%}
</product-media-gallery>

{% schema %}
{
  "name": "t:general.product_media",
  "settings": []
}
{% endschema %}
