{% doc %}
  Contact form of the contact page (docs/ui-spec/page.md §2, §6; TE-21 AC3–AC6):
  h2 and "* Required fields", exactly 3 fields (Name, Email, Message with an
  order number hint), an optional privacy sentence that links to the shop's
  privacy policy, and the primary "Send Message" button. Works without
  JavaScript: the browser checks required fields, Shopify returns form.errors
  after the page reloads and the same error slots show them.

  States, all rendered by Liquid:
  - field error: input aria-invalid + aria-describedby, sentence with icon under
    the field; the summary box (role="alert") lists a link per wrong field;
  - general error (form.errors contains 'form', for example a spam check): an
    .alert box (no tone class = error, role="alert") above the fields, typed values stay in the fields;
  - success (form.posted_successfully?): an .alert--success box (role="status",
    shared tone of foundation.md §35) with a secondary "Continue Shopping" link
    replaces the fields.
  Empty heading setting uses the locale heading; no privacy policy in the shop
  hides the privacy sentence. Self-contained: callers must leave the body empty.

  JavaScript hooks for assets/contact-form.js (ES1-T474): assets/lazy-module.js imports it on
  the first interaction with the form (data-lazy-module, data-lazy-on="interaction"); after a
  submit with field errors, or on success, it loads at once to move focus there:
  - form data-contact-form, data-label-sending ("Sending your message…");
  - live region data-contact-live (role="status", empty until sending);
  - summary data-contact-summary (hidden when no field error), title
    data-contact-summary-title, data-label-1..3 hold "Check {n} field(s)",
    list items data-contact-summary-for="<input id>" (hidden when that field is fine);
  - error sentences #ContactNameError, #ContactEmailError, #ContactBodyError
    (hidden when the field is fine); the hint #ContactBodyHint is always described.
  Loading: the script sets aria-busy="true" on the submit button (spinner from
  .button[aria-busy='true']) and readonly on the fields.

  Test hooks: data-testid="contact-form-block", "contact-form",
  "contact-form-heading", "contact-errors", "contact-error-summary-link",
  "contact-form-error", "contact-name-error", "contact-email-error",
  "contact-body-error", "contact-privacy", "contact-submit", "contact-live",
  "contact-status", "contact-continue".

  @example
  {% block 'contact-form' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign heading = block.settings.heading | strip | escape
  if heading == blank
    assign heading = 'blocks.contact_form.heading' | t
  endif

  assign privacy_policy = shop.privacy_policy
  assign show_privacy = false
  if block.settings.show_privacy_note and privacy_policy != blank
    assign show_privacy = true
  endif

  assign sending_label = 'contact.sending' | t
  assign summary_label_1 = 'contact.check_fields' | t: count: 1
  assign summary_label_2 = 'contact.check_fields' | t: count: 2
  assign summary_label_3 = 'contact.check_fields' | t: count: 3
  assign contact_form_js = 'contact-form.js' | asset_url
-%}

<div class="contact-form" data-testid="contact-form-block" {{ block.shopify_attributes }}>
  {%- form 'contact',
    class: 'contact-form__form',
    data-contact-form: '',
    data-label-sending: sending_label,
    data-lazy-module: contact_form_js,
    data-lazy-on: 'interaction',
    data-testid: 'contact-form'
  -%}
    {%- if form.posted_successfully? -%}
      <div class="alert alert--success contact-form__status" role="status" tabindex="-1" data-testid="contact-status">
        <span class="alert__icon">{% render 'status-icon', name: 'success' %}</span>
        <div class="alert__body">
          <p class="alert__title">{{ 'contact.success_title' | t }}</p>
          <p class="alert__text">{{ 'contact.success_text' | t }}</p>
          <div class="alert__actions">
            <a
              class="button button--secondary"
              href="{{ routes.all_products_collection_url }}"
              data-testid="contact-continue"
            >
              {{- 'contact.continue_shopping' | t -}}
            </a>
          </div>
        </div>
      </div>
      <script src="{{ contact_form_js }}" type="module"></script>
    {%- else -%}
      {%- liquid
        assign name_error = false
        assign email_error = false
        assign body_error = false
        assign form_error = false
        if form.errors contains 'name'
          assign name_error = true
        endif
        if form.errors contains 'email'
          assign email_error = true
        endif
        if form.errors contains 'body'
          assign body_error = true
        endif
        if form.errors contains 'form'
          assign form_error = true
        endif

        assign field_error_count = 0
        if name_error
          assign field_error_count = field_error_count | plus: 1
        endif
        if email_error
          assign field_error_count = field_error_count | plus: 1
        endif
        if body_error
          assign field_error_count = field_error_count | plus: 1
        endif

        assign name_value = form.name
        assign email_value = form.email
        if name_value == blank and customer
          assign name_value = customer.name | escape
        endif
        if email_value == blank and customer
          assign email_value = customer.email | escape
        endif
      -%}

      <div class="contact-form__head">
        <h2 class="contact-form__heading" data-testid="contact-form-heading">{{ heading }}</h2>
        <p class="contact-form__required">{{ 'contact.required_note' | t }}</p>
      </div>

      {%- if form_error -%}
        <div class="alert contact-form__alert" role="alert" data-testid="contact-form-error">
          <span class="alert__icon">{% render 'status-icon', name: 'error' %}</span>
          <div class="alert__body">
            <p class="alert__title">{{ 'contact.error_form_title' | t }}</p>
            <p class="alert__text">{{ 'contact.error_form_text' | t }}</p>
          </div>
        </div>
      {%- endif -%}

      <div
        class="alert contact-form__summary"
        role="alert"
        tabindex="-1"
        data-contact-summary
        data-label-1="{{ summary_label_1 | escape }}"
        data-label-2="{{ summary_label_2 | escape }}"
        data-label-3="{{ summary_label_3 | escape }}"
        data-testid="contact-errors"
        {% if field_error_count == 0 %}
          hidden
        {% endif %}
      >
        <span class="alert__icon">{% render 'status-icon', name: 'error' %}</span>
        <div class="alert__body">
          <p class="alert__title" data-contact-summary-title>
            {%- if field_error_count > 0 -%}
              {{- 'contact.check_fields' | t: count: field_error_count -}}
            {%- endif -%}
          </p>
          <ul class="contact-form__summary-list" role="list">
            <li
              data-contact-summary-for="ContactName"
              {% unless name_error %}
                hidden
              {% endunless %}
            >
              <a class="contact-form__link" href="#ContactName" data-testid="contact-error-summary-link">{{ 'contact.error_name' | t }}</a>
            </li>
            <li
              data-contact-summary-for="ContactEmail"
              {% unless email_error %}
                hidden
              {% endunless %}
            >
              <a class="contact-form__link" href="#ContactEmail" data-testid="contact-error-summary-link">{{ 'contact.error_email' | t }}</a>
            </li>
            <li
              data-contact-summary-for="ContactBody"
              {% unless body_error %}
                hidden
              {% endunless %}
            >
              <a class="contact-form__link" href="#ContactBody" data-testid="contact-error-summary-link">{{ 'contact.error_body' | t }}</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="contact-form__fields">
        <div class="form-field">
          <label for="ContactName" class="form-field__label">
            {{- 'contact.name' | t }} <span class="form-field__required" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            name="contact[name]"
            id="ContactName"
            class="form-field__input"
            value="{{ name_value }}"
            autocomplete="name"
            required
            aria-required="true"
            {% if name_error %}
              aria-invalid="true"
              aria-describedby="ContactNameError"
            {% endif %}
          >
          <p
            id="ContactNameError"
            class="form-field__error"
            data-testid="contact-name-error"
            {% unless name_error %}
              hidden
            {% endunless %}
          >
            {%- render 'status-icon', name: 'error' -%}
            {{- 'contact.error_name' | t -}}
          </p>
        </div>

        <div class="form-field">
          <label for="ContactEmail" class="form-field__label">
            {{- 'contact.email' | t }} <span class="form-field__required" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            name="contact[email]"
            id="ContactEmail"
            class="form-field__input"
            value="{{ email_value }}"
            autocomplete="email"
            spellcheck="false"
            required
            aria-required="true"
            {% if email_error %}
              aria-invalid="true"
              aria-describedby="ContactEmailError"
            {% endif %}
          >
          <p
            id="ContactEmailError"
            class="form-field__error"
            data-testid="contact-email-error"
            {% unless email_error %}
              hidden
            {% endunless %}
          >
            {%- render 'status-icon', name: 'error' -%}
            {{- 'contact.error_email' | t -}}
          </p>
        </div>

        <div class="form-field contact-form__field--full">
          <label for="ContactBody" class="form-field__label">
            {{- 'contact.message' | t }} <span class="form-field__required" aria-hidden="true">*</span>
          </label>
          <textarea
            name="contact[body]"
            id="ContactBody"
            class="form-field__input form-field__input--textarea"
            rows="6"
            required
            aria-required="true"
            aria-describedby="ContactBodyHint{% if body_error %} ContactBodyError{% endif %}"
            {% if body_error %}
              aria-invalid="true"
            {% endif %}
          >{{ form.body }}</textarea>
          <p id="ContactBodyHint" class="form-field__hint">{{ 'contact.message_hint' | t }}</p>
          <p
            id="ContactBodyError"
            class="form-field__error"
            data-testid="contact-body-error"
            {% unless body_error %}
              hidden
            {% endunless %}
          >
            {%- render 'status-icon', name: 'error' -%}
            {{- 'contact.error_body' | t -}}
          </p>
        </div>
      </div>

      {%- if show_privacy -%}
        {%- capture privacy_link -%}
          <a class="contact-form__link" href="{{ privacy_policy.url }}">{{ privacy_policy.title | escape }}</a>
        {%- endcapture -%}
        <p class="contact-form__privacy" data-testid="contact-privacy">
          {{- 'contact.privacy_html' | t: link: privacy_link -}}
        </p>
      {%- endif -%}

      <button type="submit" class="button contact-form__submit" data-testid="contact-submit">
        {%- render 'slideshow-icon', name: 'send' -%}
        <span class="button__label">{{ 'contact.submit' | t }}</span>
      </button>
      <div class="visually-hidden" role="status" data-contact-live data-testid="contact-live"></div>
      {%- if field_error_count > 0 -%}
        <script src="{{ contact_form_js }}" type="module"></script>
      {%- endif -%}
    {%- endif -%}
  {%- endform -%}
  <script src="{{ 'lazy-module.js' | asset_url }}" type="module"></script>
</div>

{% schema %}
{
  "name": "t:general.contact_form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.contact_form_heading"
    },
    {
      "type": "checkbox",
      "id": "show_privacy_note",
      "label": "t:labels.contact_form_show_privacy_note",
      "info": "t:info.contact_form_show_privacy_note",
      "default": true
    }
  ]
}
{% endschema %}
