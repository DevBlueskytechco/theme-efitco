{% doc %}
  Article comments (SRS TE-20 AC11, AC12; docs/ui-spec/article.md §1.4, §5,
  decisions 10/11 A3): heading with the count, the comment list, shared
  pagination (10 per page, nav "Comment pages", links to #comments) and the
  Shopify new_comment form. Same 46rem reading column as article-main.

  No settings: comments are turned on, off and moderated in Shopify admin
  (Content > Blog posts > Manage blogs). When blog.comments_enabled? is false the
  storefront renders nothing and the editor shows how to turn comments on.

  The form works without JavaScript: Shopify posts it and reloads the article.
  - form.errors: summary .form-message--error #CommentFormErrors (role="alert",
    tabindex -1, foundation §12) "Check {n} field(s)" plus a link per wrong field
    (.form-message__list, href #CommentAuthor / #CommentEmail / #CommentBody), an
    error with an icon under each field (aria-invalid, aria-describedby), typed text
    kept. Summary, list items and sentences are always rendered, hidden when fine,
    so a client check can open them: data-form-summary (data-label-1..3),
    data-form-summary-title, li[data-form-summary-for="<input id>"], #<input id>Error.
  - form.posted_successfully?: role="status" box (tabindex -1) at the top of the
    form, "in review" text when blog.moderated?, fields empty.
  - blog.moderated?: note "Comments are reviewed before they appear." above the fields.

  Hooks for BE: assets/article-comments.js (data-lazy-module on the root, imported
  near the viewport by assets/lazy-module.js; ES1-T473) focuses
  [data-testid=comment-status] or #CommentFormErrors after the reload;
  [data-testid=comment-submit] takes aria-busy while posting (.button[aria-busy]
  spinner already in base.css). No partial.

  Self-contained: callers must leave the body empty.

  Test hooks: data-testid="article-comments", "article-comments-heading",
  "article-comments-list", "article-comment", "article-comments-empty",
  "comment-form", "comment-moderated-note", "comment-status", "comment-errors",
  "comment-error-summary-link", "comment-submit", "article-comments-placeholder"; pagination hooks in
  snippets/pagination.liquid.

  @example
  {% block 'container', id: 'article-comments' %}
    {% block 'article-comments' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- if blog.comments_enabled? and article != blank -%}
  <div
    class="article-comments"
    id="comments"
    data-lazy-module="{{ 'article-comments.js' | asset_url }}"
    data-testid="article-comments"
    {{ block.shopify_attributes }}
  >
    <h2 class="article-comments__heading" id="ArticleCommentsHeading" data-testid="article-comments-heading">
      {%- if article.comments_count > 0 -%}
        {{- 'blog.comments_count' | t: count: article.comments_count -}}
      {%- else -%}
        {{- 'blog.article_comments' | t -}}
      {%- endif -%}
    </h2>

    {%- if article.comments_count > 0 -%}
      {% paginate article.comments by 10, window_size: 1 %}
        <ol
          class="article-comments__list"
          role="list"
          aria-labelledby="ArticleCommentsHeading"
          data-testid="article-comments-list"
        >
          {%- for comment in article.comments -%}
            <li class="article-comments__item" data-testid="article-comment">
              <span class="article-comments__avatar" aria-hidden="true">
                {{- comment.author | strip | slice: 0 | upcase | escape -}}
              </span>
              <p class="article-comments__head">
                <span class="article-comments__author">{{ comment.author | escape }}</span>
                <span class="article-comments__date">{{ comment.created_at | time_tag: format: 'date' }}</span>
              </p>
              <div class="article-comments__body">{{ comment.content }}</div>
            </li>
          {%- endfor -%}
        </ol>
        {%- assign comments_label = 'blog.comments_pagination_label' | t -%}
        {% render 'pagination', paginate: paginate, label: comments_label, anchor: '#comments' %}
      {% endpaginate %}
    {%- else -%}
      <p class="article-comments__empty" data-testid="article-comments-empty">{{ 'blog.no_comments' | t }}</p>
    {%- endif -%}

    {% form 'new_comment', article, class: 'comment-form', data-testid: 'comment-form' %}
      <h2 class="comment-form__title">{{ 'blog.comment_form_title' | t }}</h2>

      {%- liquid
        assign author_error = false
        assign email_error = false
        assign body_error = false
        assign form_error = false
        assign field_errors = 0
        if form.errors
          if form.errors contains 'form'
            assign form_error = true
          endif
          if form.errors contains 'author'
            assign author_error = true
            assign field_errors = field_errors | plus: 1
          endif
          if form.errors contains 'email'
            assign email_error = true
            assign field_errors = field_errors | plus: 1
          endif
          if form.errors contains 'body'
            assign body_error = true
            assign field_errors = field_errors | plus: 1
          endif
        endif
        assign summary_label_1 = 'blog.comment_errors_summary' | t: count: 1
        assign summary_label_2 = 'blog.comment_errors_summary' | t: count: 2
        assign summary_label_3 = 'blog.comment_errors_summary' | t: count: 3

        assign value_author = form.author
        assign value_email = form.email
        assign value_body = form.body
        if form.posted_successfully?
          assign value_author = ''
          assign value_email = ''
          assign value_body = ''
        endif
      -%}

      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success" role="status" tabindex="-1" data-testid="comment-status">
          <span class="form-status__icon">{% render 'status-icon', name: 'success' %}</span>
          <div class="form-status__body">
            {%- if blog.moderated? -%}
              <p class="form-status__title">{{ 'blog.comment_pending_title' | t }}</p>
              <p>{{ 'blog.comment_pending_body' | t }}</p>
            {%- else -%}
              <p class="form-status__title">{{ 'blog.comment_posted' | t }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div
        class="form-message form-message--error"
        role="alert"
        tabindex="-1"
        id="CommentFormErrors"
        data-form-summary
        data-label-1="{{ summary_label_1 | escape }}"
        data-label-2="{{ summary_label_2 | escape }}"
        data-label-3="{{ summary_label_3 | escape }}"
        data-testid="comment-errors"
        {% unless form.errors %}
          hidden
        {% endunless %}
      >
        {%- render 'status-icon', name: 'error' -%}
        <div class="form-message__body">
          <strong class="form-message__title" data-form-summary-title>
            {%- if field_errors > 0 -%}
              {{- 'blog.comment_errors_summary' | t: count: field_errors -}}
            {%- elsif form.errors -%}
              {{- 'blog.comment_errors_title' | t -}}
            {%- endif -%}
          </strong>
          {%- if form_error -%}
            <p>{{ form.errors.messages['form'] }}</p>
          {%- endif -%}
          <ul class="form-message__list" role="list">
            <li
              data-form-summary-for="CommentAuthor"
              {% unless author_error %}
                hidden
              {% endunless %}
            >
              <a href="#CommentAuthor" data-testid="comment-error-summary-link">{{ 'blog.comment_summary_author' | t }}</a>
            </li>
            <li
              data-form-summary-for="CommentEmail"
              {% unless email_error %}
                hidden
              {% endunless %}
            >
              <a href="#CommentEmail" data-testid="comment-error-summary-link">{{ 'blog.comment_summary_email' | t }}</a>
            </li>
            <li
              data-form-summary-for="CommentBody"
              {% unless body_error %}
                hidden
              {% endunless %}
            >
              <a href="#CommentBody" data-testid="comment-error-summary-link">{{ 'blog.comment_summary_body' | t }}</a>
            </li>
          </ul>
        </div>
      </div>

      {%- if blog.moderated? -%}
        <p class="comment-form__note" data-testid="comment-moderated-note">
          {%- render 'status-icon', name: 'info' -%}
          <span>{{ 'blog.comment_moderated_note' | t }}</span>
        </p>
      {%- endif -%}

      <div class="comment-form__fields">
        <div class="form-field">
          <label for="CommentAuthor" class="form-field__label">
            {{- 'blog.comment_form_name' | t }} <span aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            name="comment[author]"
            id="CommentAuthor"
            class="form-field__input"
            value="{{ value_author }}"
            autocomplete="name"
            required
            aria-required="true"
            {% if author_error %}
              aria-invalid="true"
              aria-describedby="CommentAuthorError"
            {% endif %}
          >
          <p
            id="CommentAuthorError"
            class="form-field__error"
            {% unless author_error %}
              hidden
            {% endunless %}
          >
            {%- render 'status-icon', name: 'error' -%}
            <span>{{ 'blog.comment_error_author' | t }}</span>
          </p>
        </div>

        <div class="form-field">
          <label for="CommentEmail" class="form-field__label">
            {{- 'blog.comment_form_email' | t }} <span aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            name="comment[email]"
            id="CommentEmail"
            class="form-field__input"
            value="{{ value_email }}"
            autocomplete="email"
            spellcheck="false"
            required
            aria-required="true"
            {% if email_error %}
              aria-invalid="true"
              aria-describedby="CommentEmailError CommentEmailHint"
            {% else %}
              aria-describedby="CommentEmailHint"
            {% endif %}
          >
          <p
            id="CommentEmailError"
            class="form-field__error"
            {% unless email_error %}
              hidden
            {% endunless %}
          >
            {%- render 'status-icon', name: 'error' -%}
            <span>{{ 'blog.comment_error_email' | t }}</span>
          </p>
          <p id="CommentEmailHint" class="form-field__hint">{{ 'blog.email_hint' | t }}</p>
        </div>

        <div class="form-field comment-form__body">
          <label for="CommentBody" class="form-field__label">
            {{- 'blog.comment_form_body' | t }} <span aria-hidden="true">*</span>
          </label>
          <textarea
            name="comment[body]"
            id="CommentBody"
            class="form-field__input"
            rows="5"
            required
            aria-required="true"
            {% if body_error %}
              aria-invalid="true"
              aria-describedby="CommentBodyError"
            {% endif %}
          >{{ value_body }}</textarea>
          <p
            id="CommentBodyError"
            class="form-field__error"
            {% unless body_error %}
              hidden
            {% endunless %}
          >
            {%- render 'status-icon', name: 'error' -%}
            <span>{{ 'blog.comment_error_body' | t }}</span>
          </p>
        </div>
      </div>

      <div class="comment-form__actions">
        <button type="submit" class="button" data-testid="comment-submit">
          {{- 'blog.comment_form_submit' | t -}}
        </button>
        <p class="form-field__hint">{{ 'blog.required_note' | t }}</p>
      </div>
    {% endform %}
    <script src="{{ 'lazy-module.js' | asset_url }}" type="module"></script>
  </div>
{%- elsif request.design_mode -%}
  <p class="article-comments--placeholder" data-testid="article-comments-placeholder" {{ block.shopify_attributes }}>
    {{ 'blog.comments_placeholder' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:general.article_comments",
  "settings": []
}
{% endschema %}
