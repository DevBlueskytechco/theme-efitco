{% doc %}
  Renders one slide inside the slideshow block: image or video, overlay, and
  text with up to two buttons. Composed in the template, in the body of
  slideshow. When both image and video are set, the video wins and its preview
  image sits underneath. Without media, the editor shows a placeholder and the
  storefront shows the dark background color. Self-contained: callers must
  leave the body empty.

  Test hooks: data-testid="slideshow-slide", "slideshow-image",
  "slideshow-video", "slideshow-heading", "slideshow-button-primary",
  "slideshow-button-secondary".

  @param {boolean} [priority] - True on the first slide only: renders the h1 and loads its image eagerly with high fetch priority. Move this parameter when reordering slides.

  @example
  {% block 'slideshow-slide', priority: true %}{% endblock %}
{% enddoc %}

{%- liquid
  assign slide_video = block.settings.video
  assign slide_image = block.settings.image

  if slide_video != blank
    assign slide_image = slide_video.preview_image
  endif

  assign heading_tag = 'h2'
  assign image_loading = 'lazy'
  assign image_fetchpriority = null

  if priority
    assign heading_tag = 'h1'
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign button_url = block.settings.button_url | default: routes.all_products_collection_url
  assign button_2_url = block.settings.button_2_url | default: routes.all_products_collection_url
  assign image_sizes = '(min-width: 80rem) 94vw, calc(100vw - 40px)'
-%}

<div
  class="slideshow__slide"
  role="group"
  aria-roledescription="slide"
  data-alignment="{{ block.settings.content_alignment }}"
  style="--overlay-opacity: {{ block.settings.overlay_opacity }}%;"
  data-testid="slideshow-slide"
  {{ block.shopify_attributes }}
>
  {%- if slide_image != blank -%}
    <div class="slideshow__media" data-testid="slideshow-image">
      {% render 'image',
        image: slide_image,
        width: 1800,
        widths: '360, 540, 720, 1080, 1440, 1800',
        sizes: image_sizes,
        loading: image_loading,
        fetchpriority: image_fetchpriority
      %}
    </div>
  {%- elsif slide_video == blank and request.design_mode -%}
    <div class="slideshow__media">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__placeholder' }}
    </div>
  {%- endif -%}

  {%- if slide_video != blank -%}
    <div class="slideshow__media" data-testid="slideshow-video">
      {{
        slide_video
        | video_tag:
          autoplay: true,
          muted: true,
          loop: true,
          playsinline: true,
          controls: false,
          aria-hidden: 'true'
      }}
    </div>
  {%- endif -%}

  <div class="slideshow__overlay"></div>

  <div class="slideshow__content">
    {%- if block.settings.eyebrow != blank -%}
      <p class="slideshow__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if block.settings.heading != blank -%}
      <{{ heading_tag }} class="slideshow__heading" data-testid="slideshow-heading">
        {{- block.settings.heading | escape -}}
      </{{ heading_tag }}>
    {%- endif -%}
    {%- if block.settings.subheading != blank -%}
      <p class="slideshow__subheading">{{ block.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if block.settings.button_label != blank or block.settings.button_2_label != blank -%}
      <div class="slideshow__buttons">
        {%- if block.settings.button_label != blank -%}
          <a class="button" href="{{ button_url }}" data-testid="slideshow-button-primary">
            {{- block.settings.button_label | escape -}}
            {%- render 'slideshow-icon', name: 'arrow' -%}
          </a>
        {%- endif -%}
        {%- if block.settings.button_2_label != blank -%}
          <a class="button button--secondary" href="{{ button_2_url }}" data-testid="slideshow-button-secondary">
            {{- block.settings.button_2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.slideshow_slide",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.slide_image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.slide_video",
      "info": "t:info.slide_video"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.slide_overlay_opacity",
      "default": 30
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.slide_eyebrow",
      "default": "Trusted by 10,000+ athletes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.slide_heading",
      "default": "Level Up Your Fitness"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.slide_subheading",
      "default": "Upgrade your journey with Efitco gear made for every workout."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.slide_button_label",
      "info": "t:info.slide_button_label",
      "default": "Explore Equipment"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.slide_button_url"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "t:labels.slide_button_2_label",
      "info": "t:info.slide_button_label"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "t:labels.slide_button_2_url"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:labels.slide_content_alignment",
      "info": "t:info.slide_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
