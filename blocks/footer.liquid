{% doc %}
  Renders the theme's storefront footer: newsletter band (optional image,
  heading with italic words in the accent color, text, form, note), logo,
  description, footer menu, social
  links, Follow on Shop, trust bar, wordmark, localization, payment icons,
  and copyright line. Works without JavaScript. Composed directly in
  layout/theme.liquid so it appears on every page.

  Layout (docs/ui-spec/foundation.md §4, SRS TE-1 AC11): 3 tiers. Menu
  columns are a closed <details> under 48rem and open from 48rem (CSS);
  trust bar 2 x 2 under 48rem, 4 columns from 48rem. The wordmark is
  decorative (aria-hidden). Follow on Shop sits under the social row and is
  never restyled (foundation §27, §29).

  Social URLs are global settings (config/settings_schema.json, Social
  group); everything else is a block setting. Text settings default to empty
  (ADR 0011): an empty heading, text, description or trust item is not
  rendered. The newsletter heading is rich text: italic words show in the
  accent color. The submit button uses the button label setting, then the
  "Subscribe" locale string. Payment icons come only from
  shop.enabled_payment_types, full color. Logo order (ADR 0011): the block
  logo, then the theme logo (Theme settings, Logo and favicon), then the shop
  name as text. Self-contained: callers must leave the body empty.

  Localization (TE-1 AC5, AC10; localization.md; contract TE-1-R2-FE5 /
  TE-1-R2-BE2): only when Shopify Markets sells more than one country or
  language, no setting. Hooks for assets/localization-picker.js:
  - <localization-picker> wraps the localization form. data-country-count,
    data-label-status ("[count] countries found"), data-label-status-one,
    data-label-no-results ("[query]"), data-label-error ("[name]"),
    data-label-updating ("[name]"). data-tabs on the host (set by BE) shows
    the tabs: sheet and drawer level 2 only.
  - footer-localization-toggle: <summary id="FooterLocalizationToggle">.
    From 48rem BE keeps the <details> popover and syncs aria-expanded
    (page-layers); Esc, click outside, focusout close it.
  - footer-localization-panel: <dialog class="dialog"> inside
    <modal-dialog data-layer="localization" data-sheet-below="48rem">.
    Below 48rem BE sets details.open = true, then modal-dialog.open(summary):
    :modal turns it into the bottom sheet with title and close button.
  - Lists, search, status, error: snippets/localization-lists.liquid.

  @example
  {% block 'footer' -%}{%- endblock %}
{% enddoc %}

{%- liquid
  assign menu_links = block.settings.menu.links
  assign logo = block.settings.logo | default: settings.logo
  assign newsletter_image = block.settings.newsletter_image
  assign newsletter_heading = block.settings.newsletter_heading | strip
  assign newsletter_text = block.settings.newsletter_text
  assign newsletter_button_label = block.settings.newsletter_button_label | strip
  if newsletter_button_label == blank
    assign newsletter_button_label = 'blocks.footer.newsletter_submit' | t
  endif

  assign social_networks = 'tiktok,instagram,youtube,facebook,x,pinterest' | split: ','
  assign has_social = false
  for network in social_networks
    assign social_key = 'social_' | append: network | append: '_link'
    if settings[social_key] != blank
      assign has_social = true
    endif
  endfor

  assign has_trust_items = false
  for index in (1..4)
    assign trust_key = 'trust_text_' | append: index
    assign trust_text = block.settings[trust_key] | strip
    if trust_text != blank
      assign has_trust_items = true
    endif
  endfor

  assign show_countries = false
  if localization.available_countries.size > 1
    assign show_countries = true
  endif

  assign show_languages = false
  if localization.available_languages.size > 1
    assign show_languages = true
  endif

  # Button text: only the part with more than one entry (localization.md §2)
  assign locale_code = ''
  if show_countries
    assign locale_code = localization.country.currency.iso_code
  endif
  if show_countries and show_languages
    assign locale_code = locale_code | append: ' / '
  endif
  if show_languages
    assign language_code = localization.language.iso_code | upcase
    assign locale_code = locale_code | append: language_code
  endif

  # Labels for assets/localization-picker.js; [count], [query], [name] are replaced in JS
  assign label_status = 'blocks.footer.country_results' | t: total: '[count]'
  assign label_status_one = 'blocks.footer.country_result_one' | t
  assign label_no_results = 'blocks.footer.country_no_results' | t: query: '[query]'
  assign label_error = 'blocks.footer.error' | t: name: '[name]'
  assign label_updating = 'blocks.footer.updating' | t: name: '[name]'

  assign show_payment_icons = false
  if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0
    assign show_payment_icons = true
  endif
-%}

<footer class="site-footer full-width" data-testid="footer" {{ block.shopify_attributes }}>
  <div class="site-footer__band{% if newsletter_image %} site-footer__band--media{% endif %}">
    {%- if newsletter_image -%}
      <div class="site-footer__newsletter-media">
        {%- render 'image',
          image: newsletter_image,
          class: 'site-footer__newsletter-image',
          width: 294,
          height: 369,
          crop: 'center',
          widths: '98, 196, 294',
          sizes: '98px',
          testid: 'footer-newsletter-image'
        -%}
      </div>
    {%- endif -%}

    {%- if newsletter_heading != blank or newsletter_text != blank -%}
      <div class="site-footer__newsletter">
        {%- if newsletter_heading != blank -%}
          <h2 class="site-footer__newsletter-heading" data-testid="footer-newsletter-heading">
            {{- block.settings.newsletter_heading -}}
          </h2>
        {%- endif -%}
        {%- if newsletter_text != blank -%}
          <p class="site-footer__newsletter-text" data-testid="footer-newsletter-text">{{ newsletter_text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- form 'customer', id: 'footer-newsletter', class: 'site-footer__form', data-testid: 'footer-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="site-footer__field">
        <label class="site-footer__hidden-label" for="footer-newsletter-email">
          {{- 'blocks.footer.newsletter_email' | t -}}
        </label>
        <input
          class="site-footer__input"
          id="footer-newsletter-email"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          placeholder="{{ 'blocks.footer.newsletter_email' | t }}"
          data-testid="footer-newsletter-email"
          {% if form.errors %}
            value="{{ form.email | escape }}"
            aria-invalid="true"
            aria-describedby="footer-newsletter-error"
          {% endif %}
        >
        <button class="site-footer__submit" type="submit" data-testid="footer-newsletter-submit">
          {%- render 'slideshow-icon', name: 'send' -%}
          <span>{{ newsletter_button_label | escape }}</span>
        </button>
      </div>

      {% comment %}
        Error text is white with a red icon: --color-sale on the dark background is
        2.73:1 (foundation §2, §4). Client check: JS toggles [data-invalid] on the form
        and aria-invalid on the input; aria-describedby="footer-newsletter-invalid" is BE's.
      {% endcomment %}
      <p class="site-footer__invalid" id="footer-newsletter-invalid" data-testid="footer-newsletter-invalid">
        {%- render 'status-icon', name: 'error' -%}
        <span>{{ 'blocks.footer.newsletter_invalid' | t }}</span>
      </p>
      <p class="site-footer__note" data-testid="footer-newsletter-note">
        {{- 'blocks.footer.newsletter_note' | t -}}
      </p>

      {%- if form.errors -%}
        <div
          class="site-footer__message site-footer__message--error"
          id="footer-newsletter-error"
          role="alert"
          data-testid="footer-newsletter-error"
        >
          {%- render 'status-icon', name: 'error' -%}
          <div class="site-footer__message-body">{{ form.errors | default_errors }}</div>
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div
          class="site-footer__message form-message form-message--success"
          role="status"
          data-testid="footer-newsletter-success"
        >
          {%- render 'status-icon', name: 'success' -%}
          <p class="site-footer__message-body">{{ 'blocks.footer.newsletter_success' | t }}</p>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>

  <div class="site-footer__main">
    <div class="site-footer__main-top">
      <div class="site-footer__brand">
        <a
          class="site-footer__logo"
          href="{{ routes.root_url }}"
          data-testid="footer-logo"
          {% if logo %}
            aria-label="{{ shop.name | escape }}"
            style="--logo-width: {{ block.settings.logo_width }}px;"
          {% endif %}
        >
          {%- if logo -%}
            {%- assign logo_render_width = block.settings.logo_width | times: 2 -%}
            {%- render 'image', image: logo, class: 'site-footer__logo-image', width: logo_render_width -%}
          {%- else -%}
            <span class="site-footer__logo-text">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>

        {%- if block.settings.description != blank -%}
          <p class="site-footer__description" data-testid="footer-description">{{ block.settings.description }}</p>
        {%- endif -%}

        <div class="site-footer__follow-group">
          {%- if has_social -%}
            <ul class="site-footer__social" aria-label="{{ 'blocks.footer.social_label' | t }}">
              {%- for network in social_networks -%}
                {%- assign social_key = 'social_' | append: network | append: '_link' -%}
                {%- if settings[social_key] != blank -%}
                  {%- case network -%}
                    {%- when 'tiktok' -%}
                      {%- assign social_name = 'blocks.footer.social.tiktok' | t -%}
                    {%- when 'instagram' -%}
                      {%- assign social_name = 'blocks.footer.social.instagram' | t -%}
                    {%- when 'youtube' -%}
                      {%- assign social_name = 'blocks.footer.social.youtube' | t -%}
                    {%- when 'facebook' -%}
                      {%- assign social_name = 'blocks.footer.social.facebook' | t -%}
                    {%- when 'x' -%}
                      {%- assign social_name = 'blocks.footer.social.x' | t -%}
                    {%- when 'pinterest' -%}
                      {%- assign social_name = 'blocks.footer.social.pinterest' | t -%}
                  {%- endcase -%}
                  <li>
                    <a
                      class="site-footer__social-link"
                      href="{{ settings[social_key] }}"
                      aria-label="{{ 'blocks.footer.social_link' | t: shop: shop.name, network: social_name | escape }}"
                      data-testid="footer-social-link"
                    >
                      {%- render 'icon-social', network: network -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- elsif request.design_mode -%}
            <p class="site-footer__placeholder">{{ 'blocks.footer.social_placeholder' | t }}</p>
          {%- endif -%}

          {%- if shop.features.follow_on_shop? -%}
            <div class="site-footer__shop-follow" data-testid="footer-shop-follow">{{ shop | login_button: action: 'follow' }}</div>
          {%- endif -%}
        </div>
      </div>

      {%- if menu_links.size > 0 -%}
        {%- assign has_flat_links = false -%}
        <nav class="site-footer__nav" aria-label="{{ 'blocks.footer.menu_label' | t }}">
          {%- for link in menu_links -%}
            {%- if link.links.size > 0 -%}
              {% comment %}
                Under 48rem the column is a closed <details> (row 52, links 44). From 48rem
                CSS forces the content open and swaps the summary for the plain title, so
                the title is never an <h*> (foundation §4, SRS TE-1 AC11).
              {% endcomment %}
              <div class="site-footer__column" data-testid="footer-menu-column">
                <p class="site-footer__column-heading">{{ link.title | escape }}</p>
                <details class="site-footer__menu">
                  <summary class="site-footer__menu-summary" data-testid="footer-menu-toggle">
                    <span>{{ link.title | escape }}</span>
                    <svg aria-hidden="true" focusable="false" class="site-footer__chevron" width="9" height="5" viewBox="0 0 9 5" fill="none"><path d="M0.17192 0.168975C0.401146 -0.0563249 0.77273 -0.0563249 1.00196 0.168975L4.49999 3.60715L7.998 0.168975C8.22722 -0.056325 8.59887 -0.056325 8.82809 0.168975C9.0573 0.394275 9.0573 0.759568 8.82809 0.984845L4.91501 4.831C4.80497 4.93923 4.65565 5 4.49999 5C4.34433 5 4.19501 4.93923 4.08497 4.831L0.17192 0.984845C-0.0573072 0.759568 -0.0573072 0.394275 0.17192 0.168975Z" fill-rule="evenodd" clip-rule="evenodd" fill="currentColor"/></svg>
                  </summary>
                  <ul class="site-footer__list">
                    {%- for child_link in link.links -%}
                      <li>
                        <a class="site-footer__link" href="{{ child_link.url }}" data-testid="footer-menu-link">
                          {{- child_link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              </div>
            {%- else -%}
              {%- assign has_flat_links = true -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_flat_links -%}
            <ul class="site-footer__list site-footer__column">
              {%- for link in menu_links -%}
                {%- if link.links.size == 0 -%}
                  <li>
                    <a class="site-footer__link" href="{{ link.url }}" data-testid="footer-menu-link">
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </nav>
      {%- elsif request.design_mode -%}
        <p class="site-footer__placeholder">{{ 'blocks.footer.menu_placeholder' | t }}</p>
      {%- endif -%}
    </div>

    {%- if has_trust_items -%}
      <ul class="site-footer__trust" aria-label="{{ 'blocks.footer.trust_label' | t }}">
        {%- for index in (1..4) -%}
          {%- assign trust_key = 'trust_text_' | append: index -%}
          {%- assign trust_icon_key = 'trust_icon_' | append: index -%}
          {%- assign trust_text = block.settings[trust_key] | strip -%}
          {%- if trust_text != blank -%}
            <li class="site-footer__trust-item" data-testid="footer-trust-item">
              {%- render 'icon-trust', icon: block.settings[trust_icon_key] -%}
              <span>{{ trust_text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="site-footer__placeholder">{{ 'blocks.footer.trust_placeholder' | t }}</p>
    {%- endif -%}
  </div>

  {% comment %}
    DOM order follows 360 (wordmark, localization + payment, copyright); from
    80rem the grid places copyright left, wordmark middle, commerce right.
  {% endcomment %}
  <div class="site-footer__bottom">
    {%- if block.settings.show_wordmark -%}
      <p class="site-footer__wordmark" aria-hidden="true" data-testid="footer-wordmark">{{ shop.name | escape }}</p>
    {%- endif -%}

    <div class="site-footer__commerce-group">
      {%- if show_countries or show_languages -%}
        {% comment %}
          Localization (TE-1 AC5, AC10; localization.md). One combined button: the text shows only
          the part with more than one entry (USD, EN or USD / EN). Without JS, and from 48rem, the
          <details> opens the white panel as a popover above the button (2 columns when both
          lists, 1 otherwise). Below 48rem with JS, BE (localization-picker.js) opens the same
          <dialog> with showModal() as a bottom sheet (.dialog), with tabs when both lists.
        {% endcomment %}
        <localization-picker
          data-country-count="{{ localization.available_countries.size }}"
          data-label-status="{{ label_status | escape }}"
          data-label-status-one="{{ label_status_one | escape }}"
          data-label-no-results="{{ label_no_results | escape }}"
          data-label-error="{{ label_error | escape }}"
          data-label-updating="{{ label_updating | escape }}"
        >
          {%- form 'localization', id: 'footer-localization', class: 'site-footer__localization' -%}
            <details class="site-footer__disclosure">
              <summary
                class="site-footer__summary"
                id="FooterLocalizationToggle"
                aria-controls="FooterLocalizationPanel"
                data-testid="footer-localization-toggle"
              >
                <span class="site-footer__hidden-label">{{ 'blocks.footer.localization_label' | t }}</span>
                {{ localization.country | image_url: width: 52 | image_tag: class: 'site-footer__flag', width: 26, height: 26, alt: '', loading: 'lazy' }}
                <span class="site-footer__locale-code">{{ locale_code }}</span>
                <span class="site-footer__hidden-label">
                  , {{ localization.country.name | escape }}, {{ localization.language.endonym_name | escape -}}
                </span>
                <svg aria-hidden="true" focusable="false" class="site-footer__chevron" width="9" height="5" viewBox="0 0 9 5" fill="none"><path d="M0.17192 0.168975C0.401146 -0.0563249 0.77273 -0.0563249 1.00196 0.168975L4.49999 3.60715L7.998 0.168975C8.22722 -0.056325 8.59887 -0.056325 8.82809 0.168975C9.0573 0.394275 9.0573 0.759568 8.82809 0.984845L4.91501 4.831C4.80497 4.93923 4.65565 5 4.49999 5C4.34433 5 4.19501 4.93923 4.08497 4.831L0.17192 0.984845C-0.0573072 0.759568 -0.0573072 0.394275 0.17192 0.168975Z" fill-rule="evenodd" clip-rule="evenodd" fill="currentColor"/></svg>
              </summary>

              <modal-dialog data-layer="localization" data-sheet-below="48rem" data-return-focus="FooterLocalizationToggle">
                <dialog
                  class="dialog site-footer__panel{% if show_countries and show_languages %} site-footer__panel--both{% endif %}{% if localization.available_countries.size > 10 %} site-footer__panel--tall{% endif %}"
                  id="FooterLocalizationPanel"
                  aria-labelledby="FooterLocalizationTitle"
                  data-testid="footer-localization-panel"
                >
                  <div class="dialog__header site-footer__panel-header">
                    <p class="dialog__title" id="FooterLocalizationTitle">{{ 'blocks.footer.localization_title' | t }}</p>
                    <button
                      type="button"
                      class="close-button dialog__close"
                      aria-label="{{ 'blocks.footer.close' | t }}"
                    >
                      {%- render 'header-icon', name: 'close' -%}
                    </button>
                  </div>
                  <div class="dialog__body site-footer__panel-body">
                    {%- render 'localization-lists',
                      id: 'Footer',
                      testid: 'footer',
                      show_countries: show_countries,
                      show_languages: show_languages
                    -%}
                  </div>
                </dialog>
              </modal-dialog>
            </details>
          {%- endform -%}
        </localization-picker>
      {%- endif -%}

      {%- if show_payment_icons -%}
        <ul class="site-footer__payment" aria-label="{{ 'blocks.footer.payment_label' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li data-testid="footer-payment-icon">{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="site-footer__copyright" data-testid="footer-copyright">
      &copy;
      {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "t:labels.show_wordmark",
      "info": "t:info.show_wordmark",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 60,
      "max": 240,
      "step": 2,
      "unit": "px",
      "default": 86
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "t:labels.footer_description",
      "info": "t:info.footer_hide_empty"
    },
    {
      "type": "header",
      "content": "t:general.newsletter"
    },
    {
      "type": "image_picker",
      "id": "newsletter_image",
      "label": "t:labels.newsletter_image",
      "info": "t:info.newsletter_image"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "label": "t:labels.newsletter_heading",
      "info": "t:info.newsletter_heading"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_text",
      "label": "t:labels.newsletter_text",
      "info": "t:info.footer_hide_empty"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "t:labels.newsletter_button_label",
      "info": "t:info.newsletter_button_label"
    },
    {
      "type": "header",
      "content": "t:general.trust_item_1"
    },
    {
      "type": "select",
      "id": "trust_icon_1",
      "label": "t:labels.trust_icon",
      "options": [
        { "value": "truck", "label": "t:options.trust_icon.truck" },
        { "value": "return", "label": "t:options.trust_icon.return" },
        { "value": "shield", "label": "t:options.trust_icon.shield" },
        { "value": "support", "label": "t:options.trust_icon.support" },
        { "value": "quality", "label": "t:options.trust_icon.quality" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "trust_text_1",
      "label": "t:labels.trust_text",
      "info": "t:info.trust_text"
    },
    {
      "type": "header",
      "content": "t:general.trust_item_2"
    },
    {
      "type": "select",
      "id": "trust_icon_2",
      "label": "t:labels.trust_icon",
      "options": [
        { "value": "truck", "label": "t:options.trust_icon.truck" },
        { "value": "return", "label": "t:options.trust_icon.return" },
        { "value": "shield", "label": "t:options.trust_icon.shield" },
        { "value": "support", "label": "t:options.trust_icon.support" },
        { "value": "quality", "label": "t:options.trust_icon.quality" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "trust_text_2",
      "label": "t:labels.trust_text",
      "info": "t:info.trust_text"
    },
    {
      "type": "header",
      "content": "t:general.trust_item_3"
    },
    {
      "type": "select",
      "id": "trust_icon_3",
      "label": "t:labels.trust_icon",
      "options": [
        { "value": "truck", "label": "t:options.trust_icon.truck" },
        { "value": "return", "label": "t:options.trust_icon.return" },
        { "value": "shield", "label": "t:options.trust_icon.shield" },
        { "value": "support", "label": "t:options.trust_icon.support" },
        { "value": "quality", "label": "t:options.trust_icon.quality" }
      ],
      "default": "quality"
    },
    {
      "type": "text",
      "id": "trust_text_3",
      "label": "t:labels.trust_text",
      "info": "t:info.trust_text"
    },
    {
      "type": "header",
      "content": "t:general.trust_item_4"
    },
    {
      "type": "select",
      "id": "trust_icon_4",
