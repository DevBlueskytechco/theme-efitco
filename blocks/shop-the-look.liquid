{% doc %}
  Shop the look (TE-12 AC5, AC-H19, AC-H20, Figma 1:560): eyebrow, h2 heading,
  optional link, a large image with 4 hotspots, a Fits note, the product rows from
  the body and a totals panel. One column with the image on top below 64rem, two
  columns from 64rem. No image: the list takes the full width.

  Works without JavaScript: a POST form to routes.cart_add_url with one hidden input
  (name id[]) per row in stock. The rows keep their prices; the count, totals and
  hotspots need JavaScript, so they stay hidden. CSS hides the panel when no row is
  in stock, and hides a hotspot when its row does not exist.

  A parent cannot read its children and Liquid cannot add them up (AGENTS.md), so
  assets/bundle-form.js sums data-price. Discounts are display only (R8): Liquid only
  outputs data-tiers, the real price comes from an automatic discount. With a tier
  above 0 the note always shows (AC-H19): an empty setting takes the locale text. No
  tier above 0: no data-tiers, discount row or note.

  Hooks for assets/bundle-form.js (BE ES1-T149; same contract as bundle-builder, no
  checkboxes, no progress and no line list). Rename only with a ticket comment.
  - Root: data-lazy-module (assets/lazy-module.js imports the module near the viewport),
    data-tiers, data-cart-add-url, data-cart-url, data-cart-type, data-currency,
    data-locale, data-label-count-one, data-label-count-other, data-label-discount (%p),
    data-label-status (%n, %t), data-label-error. JS sets data-enhanced on the root.
  - Panel: data-bundle-live (hidden by CSS until data-enhanced, space kept; display none
    without scripting), data-bundle-count, data-bundle-subtotal, data-bundle-discount-row,
    data-bundle-discount-label, data-bundle-discount (amount without a sign, CSS adds the
    minus), data-bundle-total, data-bundle-submit, data-bundle-status, data-bundle-error.
  - Hotspot: data-hotspot (1 to 4, matches data-look-row of a row), aria-pressed (the
    selected hotspot has a ring; hotspot 1 starts selected as in Figma, JS moves it).

  Test hooks: shop-the-look, shop-the-look-eyebrow, shop-the-look-heading,
  shop-the-look-link, shop-the-look-image, shop-the-look-hotspot, shop-the-look-note,
  shop-the-look-rows, shop-the-look-panel, shop-the-look-count, shop-the-look-subtotal,
  shop-the-look-discount-row, shop-the-look-discount, shop-the-look-total,
  shop-the-look-discount-note, shop-the-look-submit, shop-the-look-status,
  shop-the-look-error, shop-the-look-placeholder.

  Empty state: no row with a product → a hint in the theme editor, nothing on the
  storefront (ES1-T168 Q1).

  @param {string} [content] - The shop-the-look-row blocks, at most 6
  @param {string} [id] - Static block id, so this block keeps its own settings. Also used for the heading id. Default: block.id

  @example
  {% block 'container', id: 'home-shop-the-look', tag: 'div' %}
    {% block 'shop-the-look', id: 'shop-the-look' %}
      {% block 'shop-the-look-row', id: 'look-row-1', look_row: 1 %}{% endblock %}
    {% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign rows = content | strip

  assign tiers = ''
  if block.settings.tier_1_percent > 0
    assign tiers = tiers | append: block.settings.tier_1_quantity | append: ':' | append: block.settings.tier_1_percent | append: ','
  endif
  if block.settings.tier_2_percent > 0
    assign tiers = tiers | append: block.settings.tier_2_quantity | append: ':' | append: block.settings.tier_2_percent | append: ','
  endif
  if block.settings.tier_3_percent > 0
    assign tiers = tiers | append: block.settings.tier_3_quantity | append: ':' | append: block.settings.tier_3_percent | append: ','
  endif
  # split drops the trailing empty value, so the last comma goes away
  assign tiers = tiers | split: ',' | join: ','

  assign eyebrow = block.settings.eyebrow
  assign heading = block.settings.heading
  assign link_label = block.settings.link_label
  assign link_url = block.settings.link_url | default: routes.all_products_collection_url
  assign look_image = block.settings.image
  assign note_title = block.settings.note_title
  assign note_text = block.settings.note_text
  assign note_icon = block.settings.note_icon
  assign discount_note = 'blocks.shop_the_look.discount_note' | t
  assign discount_note = block.settings.discount_note | default: discount_note
  assign block_key = id | default: block.id
  assign heading_id = block_key | append: '-heading'
  assign cart_type = settings.cart_type | default: 'drawer'

  assign label_count_one = 'blocks.shop_the_look.count_one' | t
  assign label_count_other = 'blocks.shop_the_look.count_other' | t
  assign label_discount = 'blocks.shop_the_look.discount' | t
  assign label_status = 'blocks.shop_the_look.status' | t
  assign label_error = 'blocks.shop_the_look.error' | t
-%}

{%- if rows != blank -%}
  <bundle-form
    class="shop-the-look"
    {% if tiers != blank %}
      data-tiers="{{ tiers }}"
    {% endif %}
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-cart-url="{{ routes.cart_url }}"
    data-cart-type="{{ cart_type | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-locale="{{ request.locale.iso_code }}"
    data-label-count-one="{{ label_count_one | escape }}"
    data-label-count-other="{{ label_count_other | escape }}"
    data-label-discount="{{ label_discount | escape }}"
    data-label-status="{{ label_status | escape }}"
    data-label-error="{{ label_error | escape }}"
    data-lazy-module="{{ 'bundle-form.js' | asset_url }}"
    data-testid="shop-the-look"
    {{ block.shopify_attributes }}
  >
    {%- if eyebrow != blank or heading != blank or link_label != blank -%}
      <div class="shop-the-look__header">
        {%- if eyebrow != blank or heading != blank -%}
          <div class="shop-the-look__titles">
            {%- if eyebrow != blank -%}
              <p class="shop-the-look__eyebrow" data-testid="shop-the-look-eyebrow">{{ eyebrow | escape }}</p>
            {%- endif -%}
            {%- if heading != blank -%}
              <h2 class="shop-the-look__heading" id="{{ heading_id }}" data-testid="shop-the-look-heading">
                {{- heading -}}
              </h2>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if link_label != blank -%}
          <a class="shop-the-look__link" href="{{ link_url }}" data-testid="shop-the-look-link">
            {{- link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="shop-the-look__body">
      {%- if look_image != blank -%}
        <div class="shop-the-look__media" data-testid="shop-the-look-image">
          {% render 'image',
            image: look_image,
            class: 'shop-the-look__image',
            width: 1872,
            widths: '360, 720, 936, 1200, 1872',
            sizes: '(min-width: 120rem) 936px, (min-width: 64rem) 62vw, 100vw',
            loading: 'lazy'
          %}
          {%- for hotspot in (1..4) -%}
            {%- liquid
              assign hotspot_x_key = 'hotspot_' | append: hotspot | append: '_x'
              assign hotspot_y_key = 'hotspot_' | append: hotspot | append: '_y'
            -%}
            <button
              class="shop-the-look__hotspot"
              type="button"
              style="--hotspot-x: {{ block.settings[hotspot_x_key] }}; --hotspot-y: {{ block.settings[hotspot_y_key] }};"
              aria-label="{{ 'blocks.shop_the_look.hotspot' | t: index: hotspot }}"
              aria-pressed="{% if hotspot == 1 %}true{% else %}false{% endif %}"
              data-hotspot="{{ hotspot }}"
              data-testid="shop-the-look-hotspot"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <form
        class="shop-the-look__form"
        method="post"
        action="{{ routes.cart_add_url }}"
        {% if heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- if note_title != blank or note_text != blank -%}
          <div class="shop-the-look__note" data-testid="shop-the-look-note">
            {%- if note_icon == blank -%}
              <div class="shop-the-look__note-icon"><svg aria-hidden="true" focusable="false" width="52" height="52" viewBox="0 0 52 52" fill="none"><circle cx="26" cy="26" r="26" fill="white"/><path d="M32.774 26.6156L33.494 25.8957C33.4937 25.8959 33.4942 25.8954 33.494 25.8957C33.4942 25.8954 33.4951 25.8945 33.4953 25.8943L36.0352 23.3544L38.5764 20.8133L39.972 19.4176C40.42 18.9697 40.6667 18.3741 40.6667 17.7406C40.6667 17.1071 40.42 16.5115 39.972 16.0637L35.9366 12.0282C35.4887 11.5803 34.8931 11.3335 34.2597 11.3335C33.6261 11.3335 33.0306 11.5802 32.5827 12.0282L25.3846 19.2262L20.4988 14.3404C19.6809 13.5225 18.6558 12.9403 17.5343 12.6568L12.4034 11.3597C12.1101 11.2855 11.7991 11.3712 11.5851 11.5853C11.3711 11.7993 11.2854 12.1101 11.3596 12.4035L12.6567 17.5345C12.9402 18.6559 13.5224 19.681 14.3403 20.4989L19.2261 25.3847L12.028 32.5827C11.5801 33.0307 11.3334 33.6262 11.3334 34.2597C11.3334 34.8933 11.5801 35.4887 12.028 35.9367L16.0635 39.9721C16.5115 40.4201 17.107 40.6668 17.7405 40.6668C18.374 40.6668 18.9696 40.4201 19.4175 39.9722L23.3521 36.0376C23.3527 36.037 23.3533 36.0364 23.3539 36.0358C23.3545 36.0352 23.3551 36.0346 23.3557 36.034L26.6155 32.7742L33.2327 39.3914C34.0817 40.2403 35.1968 40.6649 36.312 40.6649C37.4271 40.6649 38.5423 40.2404 39.3912 39.3914C41.0892 37.6935 41.0892 34.9308 39.3912 33.2329L32.774 26.6156ZM14.323 17.1132L13.379 13.3792L17.1131 14.3232C17.9341 14.5307 18.6846 14.957 19.2834 15.5558L19.9609 16.2333L16.2331 19.9612L15.5555 19.2836C14.9567 18.6848 14.5305 17.9343 14.323 17.1132ZM17.4484 21.1764L21.1763 17.4486L24.1692 20.4415L20.4414 24.1694L17.4484 21.1764ZM17.7405 38.9481C17.5661 38.9481 17.4022 38.8801 17.2789 38.7568L13.2434 34.7214C13.1201 34.5981 13.0522 34.4341 13.0522 34.2597C13.0522 34.0853 13.1201 33.9214 13.2434 33.798L33.798 13.2435C33.9212 13.1202 34.0853 13.0522 34.2597 13.0522C34.4341 13.0522 34.598 13.1202 34.7213 13.2435L38.7568 17.279C38.8801 17.4022 38.948 17.5662 38.948 17.7406C38.948 17.915