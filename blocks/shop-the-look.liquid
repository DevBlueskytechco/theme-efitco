    {
      "type": "range",
      "id": "hotspot_3_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "t:labels.unit_percent",
      "label": "t:labels.shop_the_look_hotspot_3_y",
      "default": 64
    },
    {
      "type": "range",
      "id": "hotspot_4_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "t:labels.unit_percent",
      "label": "t:labels.shop_the_look_hotspot_4_x",
      "default": 46
    },
    {
      "type": "range",
      "id": "hotspot_4_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "t:labels.unit_percent",
      "label": "t:labels.shop_the_look_hotspot_4_y",
      "default": 58
    }
  ]
}
{% endschema %}
