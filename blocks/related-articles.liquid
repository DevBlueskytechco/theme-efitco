{% doc %}
  Related articles under an article (SRS TE-20 AC13, AC15; docs/ui-spec/article.md
  §1.5, §3): eyebrow, heading and a horizontal row of article cards (h3 titles,
  snippets/article-card.liquid). Articles with the current article's first tag
  come first, then the newest articles; the current article is never listed.
  Up to "Articles to show" (2–8) cards.

  Same row as blocks/blog-posts.liquid (assets/base.css "Hàng ngang"): swipe with
  the next card peeking at 360; from 48rem round 52 buttons at the top of the
  block and a progress line; with at most 4 cards, from 80rem a static grid
  without buttons or progress line. Works without JavaScript (scroll-snap,
  keyboard scrolling of the list).

  Empty setting texts: no eyebrow; the heading falls back to the locale string
  blog.related_heading (ES1-T308 #1, no brand name). A blog with only this
  article renders nothing on the storefront; the editor shows a placeholder.

  Hooks for BE (TE-7-R2-BE1 contract, task-split ES1-T307 §4): custom element
  scroll-buttons (root), data-enhanced and data-static (root), data-scroll-track
  (list), data-scroll-prev, data-scroll-next, data-scroll-progress,
  data-lazy-module (root, URL of assets/scroll-buttons.js, imported near the
  viewport by assets/lazy-module.js; BE, ES1-T473). Until the module runs the
  buttons stay hidden and the row scrolls natively.

  Self-contained: callers must leave the body empty.

  Test hooks: data-testid="related-articles", "related-articles-eyebrow",
  "related-articles-heading", "related-articles-nav", "related-articles-prev",
  "related-articles-next", "related-articles-list", "carousel-progress",
  "related-articles-placeholder"; cards in snippets/article-card.liquid.

  @example
  {% block 'container', id: 'article-related' %}
    {% block 'related-articles' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign limit = block.settings.articles_to_show
  assign other_count = blog.articles_count | default: 0 | minus: 1
  assign shown_count = other_count | at_most: limit
  assign first_tag = article.tags | first
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'blog.related_heading' | t
  endif
-%}

{%- if article != blank and other_count > 0 -%}
  <scroll-buttons
    class="blog-posts related-articles full-width{% if shown_count <= 4 %} blog-posts--grid{% endif %}"
    data-lazy-module="{{ 'scroll-buttons.js' | asset_url }}"
    data-motion-src="{{ 'scroll-extras.js' | asset_url }}"
    data-testid="related-articles"
    {{ block.shopify_attributes }}
  >
    <div class="blog-posts__header">
      {%- if block.settings.eyebrow != blank -%}
        <p class="blog-posts__eyebrow" data-testid="related-articles-eyebrow">
          {{- block.settings.eyebrow | escape -}}
        </p>
      {%- endif -%}
      <h2 class="blog-posts__heading" data-testid="related-articles-heading">{{ heading | escape }}</h2>
      {%- liquid
        assign nav_previous = 'blocks.blog_posts.previous' | t
        assign nav_next = 'blocks.blog_posts.next' | t
      -%}
      {% render 'carousel-nav', prefix: 'related-articles', label_previous: nav_previous, label_next: nav_next %}
    </div>
    {%- comment -%}
      role="list": list-style none removes the list role in Safari; tabindex lets
      keyboard users scroll the list (same as blocks/blog-posts.liquid).
    {%- endcomment -%}
    <ul
      class="blog-posts__list"
      role="list"
      tabindex="0"
      aria-label="{{ heading | escape }}"
      data-scroll-track
      data-testid="related-articles-list"
    >
      {%- liquid
        assign rendered = 0
        if first_tag != blank
          for post in blog.articles
            if rendered >= limit
              break
            endif
            if post.id != article.id and post.tags contains first_tag
              render 'article-card', article: post
              assign rendered = rendered | plus: 1
            endif
          endfor
        endif

        for post in blog.articles
          if rendered >= limit
            break
          endif
          if post.id == article.id
            continue
          endif
          if first_tag != blank and post.tags contains first_tag
            continue
          endif
          render 'article-card', article: post
          assign rendered = rendered | plus: 1
        endfor
      -%}
    </ul>
    {% render 'carousel-progress' %}
    <script src="{{ 'lazy-module.js' | asset_url }}" type="module"></script>
  </scroll-buttons>
{%- elsif request.design_mode -%}
  <p class="blog-posts--placeholder" data-testid="related-articles-placeholder" {{ block.shopify_attributes }}>
    {{ 'blog.related_placeholder' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:general.related_articles",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.related_articles_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.related_articles_heading"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "t:labels.blog_posts_articles_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
