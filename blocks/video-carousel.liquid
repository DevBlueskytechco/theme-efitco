{% doc %}
  Renders the video demo row (TE-13 AC3, Figma 1:817): eyebrow, heading, optional
  subheading, link and 3 stats, then a list of video-card blocks that scrolls
  sideways with scroll-snap, mouse, touch and keyboard without JavaScript
  (assets/base.css). The list runs to the viewport edge, so the first card lines up
  with the heading and the last one can be cut off.

  The parent cannot read its children: the body is a rendered string, so 8 cards at
  most means 8 lines in the template. When no card renders, the editor shows a
  placeholder and the storefront renders nothing, so the container leaves no empty
  band.

  Stats, subheading and link are hidden in Figma (1:826, 1:827), so their defaults
  stay empty. A stat without a value stays hidden; the link needs both a label and
  a URL.

  JavaScript hooks are on the video-card block; data-lazy-module on the root is the
  URL of assets/video-carousel.js, read by assets/lazy-module.js.

  Test hooks: data-testid="video-carousel", "video-carousel-eyebrow",
  "video-carousel-heading", "video-carousel-subheading", "video-carousel-link",
  "video-carousel-stat", "video-carousel-list", "video-carousel-placeholder".

  @param {string} [id] - Static block id, needed when a template has more than one video-carousel block
  @param {string} content - One video-card block call per card, 8 at most

  @example
  {% block 'container', id: 'home-video-carousel', background: 'alt' %}
    {% block 'video-carousel', id: 'video-carousel' %}
      {% block 'video-card', id: 'video-card-1' %}{% endblock %}
      {% block 'video-card', id: 'video-card-2' %}{% endblock %}
    {% endblock %}
  {% endblock %}
{% enddoc %}

{%- assign items = content | strip -%}

{%- if items != blank -%}
  {%- capture stats -%}
    {%- for index in (1..3) -%}
      {%- liquid
        assign value_key = 'stat_' | append: index | append: '_value'
        assign label_key = 'stat_' | append: index | append: '_label'
        assign stat_value = block.settings[value_key]
        assign stat_label = block.settings[label_key]
      -%}
      {%- if stat_value != blank -%}
        <li class="video-carousel__stat" data-testid="video-carousel-stat">
          <span class="video-carousel__stat-value">{{ stat_value | escape }}</span>
          {%- if stat_label != blank -%}
            <span class="video-carousel__stat-label">{{ stat_label | escape }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    assign has_link = false
    if block.settings.link_label != blank and block.settings.link_url != blank
      assign has_link = true
    endif
  -%}

  <div
    class="video-carousel full-width"
    data-lazy-module="{{ 'video-carousel.js' | asset_url }}"
    {% if id != blank %}
      data-video-carousel-id="{{ id }}"
    {% endif %}
    data-testid="video-carousel"
    {{ block.shopify_attributes }}
  >
    {%- comment -%}
      display: contents keeps the header and list in the block's own layout. Such an element has
      no box for lazy-module.js to observe, so scroll-buttons.js loads as a deferred module.
    {%- endcomment -%}
    <scroll-buttons class="video-carousel__scroller">
    <div class="video-carousel__header">
      <div class="video-carousel__row">
        <div class="video-carousel__title">
          {%- if block.settings.eyebrow != blank -%}
            <p class="video-carousel__eyebrow" data-testid="video-carousel-eyebrow">
              {{- block.settings.eyebrow | escape -}}
            </p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="video-carousel__heading" data-testid="video-carousel-heading">
              {{- block.settings.heading | escape -}}
            </h2>
          {%- endif -%}
        </div>
        {%- if has_link -%}
          <a class="video-carousel__link" href="{{ block.settings.link_url }}" data-testid="video-carousel-link">
            {{- block.settings.link_label | escape -}}
          </a>
        {%- endif -%}
        {%- liquid
          assign nav_previous = 'blocks.video_carousel.previous' | t
          assign nav_next = 'blocks.video_carousel.next' | t
        -%}
        {% render 'carousel-nav', prefix: 'video-carousel', label_previous: nav_previous, label_next: nav_next %}
      </div>

      {%- if stats != blank or block.settings.subheading != blank -%}
        <div class="video-carousel__row">
          {%- if stats != blank -%}
            <ul class="video-carousel__stats" role="list">{{ stats }}</ul>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="video-carousel__subheading" data-testid="video-carousel-subheading">
              {{- block.settings.subheading | escape -}}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      role="list": list-style none removes the list role in Safari, and tabindex lets
      keyboard users scroll the list (same as blocks/testimonials.liquid).
    {%- endcomment -%}
    <ul
      class="video-carousel__list"
      role="list"
      tabindex="0"
      aria-label="{{ 'blocks.video_carousel.list_label' | t }}"
      data-scroll-track
      data-testid="video-carousel-list"
    >
      {{ content }}
    </ul>
    {% render 'carousel-progress' %}
    </scroll-buttons>
    <script src="{{ 'scroll-buttons.js' | asset_url }}" type="module"></script>
    <script src="{{ 'lazy-module.js' | asset_url }}" type="module"></script>
  </div>
{%- elsif request.design_mode -%}
  <p
    class="video-carousel--placeholder"
    data-testid="video-carousel-placeholder"
    {{ block.shopify_attributes }}
  >
    {{ 'blocks.video_carousel.placeholder' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:general.video_carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.video_carousel_eyebrow",
      "default": "Video demo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.video_carousel_heading",
      "default": "See Real Equipment In Action, Before You Buy"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.video_carousel_subheading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.video_carousel_link_label",
      "info": "t:info.video_carousel_link"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.video_carousel_link_url"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "t:labels.video_carousel_stat_1_value",
      "info": "t:info.video_carousel_stat"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "t:labels.video_carousel_stat_1_label"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "t:labels.video_carousel_stat_2_value",
      "info": "t:info.video_carousel_stat"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "t:labels.video_carousel_stat_2_label"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "t:labels.video_carousel_stat_3_value",
      "info": "t:info.video_carousel_stat"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "t:labels.video_carousel_stat_3_label"
    }
  ]
}
{% endschema %}
