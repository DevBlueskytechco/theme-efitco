{% # ES1-T407 (TS-FE7): cover image widths/sizes + comment status/errors (Shopify 7 Article, 17; audit B#24, B#46; article.md §5). Full design: TE-20-R2-FE2 (ES1-T382). %}
{% block 'container' %}
  {% if article.image %}
    {% render 'image',
      image: article.image,
      width: 1200,
      widths: '360, 540, 720, 900, 1200',
      sizes: '(min-width: 80rem) 1200px, 100vw',
      loading: 'eager',
      fetchpriority: 'high',
      testid: 'article-cover'
    %}
  {% endif %}

  <h1>{{ article.title }}</h1>

  {% assign date = article.published_at | time_tag: format: 'date' %}
  <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>

  <div class="rte" data-testid="article-content">
    {{- article.content -}}
  </div>

  {% if blog.comments_enabled? %}
    <h2>{{ 'blog.article_comments' | t }}</h2>

    <div id="comments">
      {% paginate article.comments by 10 %}
        {% for comment in article.comments %}
          <div>
            <p>{{ comment.author }}</p>
            <p>
              {{- comment.created_at | time_tag: format: 'date' -}}
            </p>
            <p>{{ comment.content }}</p>
          </div>
        {% endfor %}

        {{ paginate | default_pagination: anchor: 'comments' }}
      {% endpaginate %}
    </div>

    {% form 'new_comment', article, class: 'comment-form', data-testid: 'comment-form' %}
      <h2>{{ 'blog.comment_form_title' | t }}</h2>

      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success" role="status" tabindex="-1" data-testid="comment-status">
          {%- if blog.moderated? -%}
            <p class="form-status__title">{{ 'blog.comment_pending_title' | t }}</p>
            <p>{{ 'blog.comment_pending_body' | t }}</p>
          {%- else -%}
            <p class="form-status__title">{{ 'blog.comment_posted' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div
          class="form-status form-status--error"
          role="alert"
          tabindex="-1"
          id="CommentFormErrors"
          data-testid="comment-errors"
        >
          <p class="form-status__title">{{ 'blog.comment_errors_title' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <p class="form-field__hint">{{ 'blog.required_note' | t }}</p>

      {%- liquid
        assign author_error = false
        assign email_error = false
        assign body_error = false
        if form.errors contains 'author'
          assign author_error = true
        endif
        if form.errors contains 'email'
          assign email_error = true
        endif
        if form.errors contains 'body'
          assign body_error = true
        endif
      -%}

      <div class="form-field">
        <label for="CommentAuthor" class="form-field__label">
          {{- 'blog.comment_form_name' | t }} <span aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          name="comment[author]"
          id="CommentAuthor"
          class="form-field__input"
          value="{{ form.author }}"
          autocomplete="name"
          required
          aria-required="true"
          {% if author_error %}
            aria-invalid="true"
            aria-describedby="CommentAuthorError"
          {% endif %}
        >
        {%- if author_error -%}
          <p id="CommentAuthorError" class="form-field__error">{{ 'blog.comment_error_author' | t }}</p>
        {%- endif -%}
      </div>

      <div class="form-field">
        <label for="CommentEmail" class="form-field__label">
          {{- 'blog.comment_form_email' | t }} <span aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          name="comment[email]"
          id="CommentEmail"
          class="form-field__input"
          value="{{ form.email }}"
          autocomplete="email"
          spellcheck="false"
          required
          aria-required="true"
          {% if email_error %}
            aria-invalid="true"
            aria-describedby="CommentEmailError"
          {% endif %}
        >
        {%- if email_error -%}
          <p id="CommentEmailError" class="form-field__error">{{ 'blog.comment_error_email' | t }}</p>
        {%- endif -%}
      </div>

      <div class="form-field">
        <label for="CommentBody" class="form-field__label">
          {{- 'blog.comment_form_body' | t }} <span aria-hidden="true">*</span>
        </label>
        <textarea
          name="comment[body]"
          id="CommentBody"
          class="form-field__input"
          rows="5"
          required
          aria-required="true"
          {% if body_error %}
            aria-invalid="true"
            aria-describedby="CommentBodyError"
          {% endif %}
        >{{ form.body }}</textarea>
        {%- if body_error -%}
          <p id="CommentBodyError" class="form-field__error">{{ 'blog.comment_error_body' | t }}</p>
        {%- endif -%}
      </div>

      <button type="submit" class="button" data-testid="comment-submit">
        {{- 'blog.comment_form_submit' | t -}}
      </button>
    {% endform %}
  {% endif %}
{% endblock %}
