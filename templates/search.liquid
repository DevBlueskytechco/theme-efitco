{% # TE-8 composition (drafts/techlead/ES1-T123/task-split.md D1, D4). The GET form works without JavaScript; hidden type and options[prefix] are the ES1-T124 #4 defaults. <collection-filters> stays here because it wraps 2 blocks; assets/collection-filters.js (BE) reads data-results-partial for the name of the results partial. %}
{%- liquid
  assign search_types = 'product,article,page'
  assign search_prefix = 'last'
-%}

{% block 'container', id: 'search-header' %}
  <div class="search-header">
    <h1 class="search-header__title" data-testid="search-title">{{ 'search.title' | t }}</h1>

    <form
      class="search-form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-testid="search-form"
    >
      <label class="visually-hidden" for="search-page-input">{{ 'search.input_label' | t }}</label>
      <input
        class="search-form__input"
        type="search"
        id="search-page-input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        data-testid="search-input"
      >
      <input type="hidden" name="type" value="{{ search_types }}">
      <input type="hidden" name="options[prefix]" value="{{ search_prefix }}">
      <button class="button search-form__submit" type="submit" data-testid="search-submit">
        {{- 'search.submit' | t -}}
      </button>
    </form>
  </div>
{% endblock %}

{% if search.performed %}
  {%- liquid
    # Filters and Clear filters keep the current search: same q and types (a link with type=product stays product only)
    assign current_types = search.types | join: ','
    if current_types == blank
      assign current_types = search_types
    endif
    assign encoded_terms = search.terms | url_encode
    assign encoded_types = current_types | url_encode
    assign encoded_prefix = search_prefix | url_encode
    assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&type=' | append: encoded_types | append: '&options%5Bprefix%5D=' | append: encoded_prefix
  -%}

  {% block 'container', id: 'search-main' %}
    <collection-filters
      class="collection-layout"
      data-results-partial="search-results"
      data-label-price-invalid="{{ 'blocks.collection_filters.price_invalid' | t | escape }}"
    >
      {% block 'collection-filters', filters: search.filters, action_url: routes.search_url, clear_url: clear_url %}
        <input type="hidden" name="q" value="{{ search.terms | escape }}">
        <input type="hidden" name="type" value="{{ current_types | escape }}">
        <input type="hidden" name="options[prefix]" value="{{ search_prefix }}">
      {% endblock %}
      {% block 'search-results', clear_url: clear_url %}{% endblock %}
    </collection-filters>
  {% endblock %}
{% endif %}
