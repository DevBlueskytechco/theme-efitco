{% comment %}
  TE-13 test template, opened with /?view=te13 (drafts/techlead/ES1-T142/task-split.md D11,
  plan ES1-T169 D4): one featured product with several variants, so its partials stay
  unique, plus the video carousel cases. Other countdown and stock states:
  templates/index.te13-states.liquid.
  A branch preview has no block settings, so this file sets them through block
  parameters and uses Figma copy. Handles come from tests/e2e/store-data.json.
  The YouTube and Vimeo ids are public test videos, used when the test product has no
  external video; nothing loads from them until a click.
  Remove this file before a real store release.
{% endcomment %}

{%- liquid
  assign te13_featured = all_products['te13-featured']
  if te13_featured == blank
    assign te13_featured = all_products['variant-co-ảnh-rieng']
  endif
  assign te13_sale = all_products['sale-gia-nhỏ']
  assign te13_single = all_products['sản-phẩm-chỉ-1-variant']

  assign te13_now = 'now' | date: '%s' | plus: 0
  assign te13_future_epoch = te13_now | plus: 172800
  assign te13_future = te13_future_epoch | date: '%Y-%m-%d %H:%M'

  # data-end expected on the featured product: the future time with its seconds dropped
  assign te13_seconds = te13_future_epoch | modulo: 60
  assign te13_expected_end = te13_future_epoch | minus: te13_seconds

  # TE13_VIDEO_READY: this product has a Shopify video and an external video (ES1-T153)
  assign te13_media = all_products['media-dủ-loại'].media
  assign te13_video = te13_media | where: 'media_type', 'video' | first
  assign te13_external = te13_media | where: 'media_type', 'external_video' | first
  assign te13_video_id = te13_external.external_id | default: 'aqz-KE-bpKQ'
  assign te13_video_host = te13_external.host | default: 'youtube'
-%}

{% block 'container', id: 'te13-title' %}
  <h1 class="visually-hidden">{{ shop.name }}</h1>
  <div hidden data-testid="te13-meta" data-expected-end="{{ te13_expected_end }}"></div>
{% endblock %}

{% comment %} Figma 1:759: one block, several variants; countdown shows when the variant has a compare-at price. {% endcomment %}
{% block 'container', id: 'te13-a', tag: 'div' %}
  {% block 'featured-product',
    id: 'te13-featured-a',
    product: te13_featured,
    eyebrow: 'Featured Product · Free Weights',
    countdown_end: te13_future,
    spec_1_label: 'Weight range',
    spec_2_label: 'Footprint',
    spec_3_label: 'Materials',
    spec_4_label: 'Assembly'
  %}{% endblock %}
{% endblock %}

{%- comment -%}
  Set of 8 (Figma 1:817 copy; stats, subheading and link are hidden in Figma, shown here only):
  1 video and URL, the video wins; 2 YouTube with badge; 3 Vimeo; 4 no poster, no product;
  5 poster, no product; 6 to 8 other products.
{%- endcomment -%}
{% block 'container', id: 'te13-video', background: 'alt' %}
  {% block 'video-carousel',
    id: 'te13-video-carousel',
    subheading: 'Short vertical demos. See it move before you buy.',
    link_label: 'View Preset Bundles',
    link_url: routes.collections_url,
    stat_1_value: '360+',
    stat_1_label: 'How-to reels',
    stat_2_value: '1:15',
    stat_2_label: 'Average length',
    stat_3_value: '4K',
    stat_3_label: 'Shot in studio'
  %}
    {% block 'video-card',
      id: 'te13-video-1',
      video: te13_video,
      video_id: te13_video_id,
      video_host: te13_video_host,
      product: te13_sale
    %}{% endblock %}
    {% block 'video-card',
      id: 'te13-video-2',
      video_id: 'aqz-KE-bpKQ',
      video_host: 'youtube',
      product: te13_featured,
      badge: 'Dumbbells'
    %}{% endblock %}
    {% block 'video-card',
      id: 'te13-video-3',
      video_id: '1084537',
      video_host: 'vimeo',
      product: te13_single
    %}{% endblock %}
    {% block 'video-card', id: 'te13-video-4', video_id: 'aqz-KE-bpKQ', video_host: 'youtube' %}{% endblock %}
    {% block 'video-card',
      id: 'te13-video-5',
      video_id: 'aqz-KE-bpKQ',
      video_host: 'youtube',
      poster: te13_sale.featured_image
    %}{% endblock %}
    {% block 'video-card', id: 'te13-video-6', video_id: 'aqz-KE-bpKQ', video_host: 'youtube', product: te13_sale %}{% endblock %}
    {% block 'video-card', id: 'te13-video-7', video_id: '1084537', video_host: 'vimeo', product: te13_featured %}{% endblock %}
    {% block 'video-card', id: 'te13-video-8', video_id: '1084537', video_host: 'vimeo', product: te13_single %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} One card with a source, one without: 1 card renders. Stat 2 has no value: stays hidden. {% endcomment %}
{% block 'container', id: 'te13-video-mixed', background: 'alt' %}
  {% block 'video-carousel',
    id: 'te13-video-carousel-mixed',
    stat_1_value: '360+',
    stat_1_label: 'How-to reels',
    stat_2_label: 'Label without value'
  %}
    {% block 'video-card', id: 'te13-video-mixed-1', video_id: 'aqz-KE-bpKQ', video_host: 'youtube' %}{% endblock %}
    {% block 'video-card', id: 'te13-video-mixed-2', product: te13_sale, badge: 'No source' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} No card has a source: no carousel, no band. {% endcomment %}
{% block 'container', id: 'te13-video-empty', background: 'alt' %}
  {% block 'video-carousel', id: 'te13-video-carousel-empty' %}
    {% block 'video-card', id: 'te13-video-empty-1', product: te13_sale %}{% endblock %}
  {% endblock %}
{% endblock %}
