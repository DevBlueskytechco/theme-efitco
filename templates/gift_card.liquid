{% layout none %}
{% # ES1-T384 (TE-21 AC13 to AC15, R7.9; docs/ui-spec/gift-card.md): own document, printed and shared outside the storefront layout. %}
{% # JS hooks for TS-BE1 (ES1-T410), no script here: data-gift-card-qr (QR frame), data-gift-card-copy, data-gift-card-print, data-gift-card-status. %}

{%- liquid
  assign inactive = false
  if gift_card.expired or gift_card.enabled == false
    assign inactive = true
  endif
  assign balance = gift_card.balance | money
  assign initial_value = gift_card.initial_value | money
  assign shop_name = shop.name | escape
  assign contact_page = pages['contact']
-%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Charset, viewport (width=device-width,initial-scale=1), social, title. One viewport tag only: it lives in meta-tags. %}
    {% render 'meta-tags' %}
    <meta name="robots" content="noindex">

    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <header class="gift-card__bar">
      <a class="gift-card__logo" href="{{ routes.root_url }}" data-testid="gift-card-logo">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 200
            | image_tag: alt: shop.name, class: 'gift-card__logo-image', widths: '100, 200', sizes: '100px', loading: 'eager'
          }}
        {%- else -%}
          <span class="gift-card__logo-text">{{ shop_name }}</span>
        {%- endif -%}
      </a>
    </header>

    <main class="gift-card">
      <div class="gift-card__intro">
        <p class="gift-card__eyebrow">{{ 'gift_card.card' | t }}</p>
        <h1 class="gift-card__title">{{ 'gift_card.title' | t: shop: shop_name }}</h1>
        <p class="gift-card__lead">{{ 'gift_card.use_at_checkout' | t }}</p>
      </div>

      <div class="gift-card__layout">
        <div class="gift-card__card{% if inactive %} gift-card__card--inactive{% endif %}" data-testid="gift-card-card">
          <div class="gift-card__card-top">
            {%- if settings.logo != blank -%}
              {{
                settings.logo
                | image_url: width: 200
                | image_tag: alt: '', class: 'gift-card__card-logo', widths: '100, 200', sizes: '100px', loading: 'eager'
              }}
            {%- else -%}
              <span class="gift-card__card-name">{{ shop_name }}</span>
            {%- endif -%}
            <span class="gift-card__pill">
              {%- if inactive -%}
                {{- 'gift_card.expired_label' | t -}}
              {%- else -%}
                {{- 'gift_card.card' | t -}}
              {%- endif -%}
            </span>
          </div>
          <p class="gift-card__balance" data-testid="gift-card-balance">
            <span class="gift-card__balance-label">{{ 'gift_card.balance' | t }}</span>
            {% if inactive %}<s class="gift-card__amount">{{ balance }}</s>{% else %}<span class="gift-card__amount">{{ balance }}</span>{% endif %}
            {%- if gift_card.balance < gift_card.initial_value %}
              <span class="gift-card__initial">{{ 'gift_card.of_initial' | t: value: initial_value }}</span>
            {%- endif -%}
          </p>
        </div>

        <div class="gift-card__panel">
          {%- if inactive -%}
            <div class="alert" role="alert" data-testid="gift-card-alert">
              <span class="alert__icon">{% render 'status-icon', name: 'error' %}</span>
              <div class="alert__body">
                {%- if gift_card.enabled == false -%}
                  <p class="alert__title">{{ 'gift_card.disabled' | t }}</p>
                  <p class="alert__text">{{ 'gift_card.disabled_text' | t }}</p>
                {%- else -%}
                  <p class="alert__title">{{ 'gift_card.expired' | t }}</p>
                  {%- if gift_card.expires_on -%}
                    {%- assign expired_on = gift_card.expires_on | date: '%B %e, %Y' -%}
                    <p class="alert__text">{{ 'gift_card.expired_text' | t: date: expired_on }}</p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <div class="gift-card__code-group" role="group" aria-labelledby="GiftCardCodeLabel">
            <p class="gift-card__code-label" id="GiftCardCodeLabel">{{ 'gift_card.code_label' | t }}</p>
            <p class="gift-card__code" data-testid="gift-card-code">{{ gift_card.code | format_code }}</p>
            {%- unless inactive -%}
              <button
                type="button"
                class="button button--secondary gift-card__copy"
                data-gift-card-copy="{{ gift_card.code | escape }}"
                data-label-copied="{{ 'gift_card.copied' | t | escape }}"
                data-label-status="{{ 'gift_card.copied_status' | t | escape }}"
                data-testid="gift-card-copy"
                hidden
              >
                {{- 'gift_card.copy' | t -}}
              </button>
              <p class="visually-hidden" role="status" data-gift-card-status></p>
            {%- endunless -%}
          </div>

          {% # ES1-T408 (TS-FE8): QR frame 144 x 144 (Shopify 7 Gift card, audit A#60). TS-BE1 draws the QR inside and hides the fallback; without JS the fallback text stays. %}
          {%- unless gift_card.expired or gift_card.enabled == false -%}
            <div class="gift-card__pay">
              <div
                class="gift-card__qr"
                data-gift-card-qr
                data-identifier="{{ gift_card.qr_identifier | escape }}"
                data-label="{{ 'gift_card.qr_alt' | t | escape }}"
                data-testid="gift-card-qr"
              >
                <p class="gift-card__qr-fallback" data-testid="gift-card-qr-fallback">
                  {{- 'gift_card.qr_fallback' | t -}}
                </p>
              </div>
              <div class="gift-card__pay-text">
                <p class="gift-card__pay-title">{{ 'gift_card.qr_title' | t }}</p>
                <p>{{ 'gift_card.qr_text' | t }}</p>
              </div>
            </div>
          {%- endunless -%}

          <dl class="gift-card__meta">
            <div>
              <dt>{{ 'gift_card.initial_value' | t }}</dt>
              <dd>{{ initial_value }}</dd>
            </div>
            {%- if gift_card.expires_on -%}
              {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
              <div>
                <dt>{{ 'gift_card.expires_label' | t }}</dt>
                <dd>{{ expires_on }}</dd>
              </div>
            {%- endif -%}
          </dl>

          <div class="gift-card__actions">
            {%- if inactive -%}
              <a
                class="button button--secondary"
                href="{% if contact_page != blank %}{{ contact_page.url }}{% else %}mailto:{{ shop.email }}{% endif %}"
                data-testid="gift-card-contact"
              >
                {{- 'gift_card.contact' | t -}}
              </a>
            {%- else -%}
              {%- if gift_card.pass_url -%}
                <a href="{{ gift_card.pass_url }}" class="gift-card__wallet" data-testid="gift-card-wallet">
                  <img
                    src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                    alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                    width="200"
                    height="60"
                  >
                </a>
              {%- endif -%}
              <a class="button gift-card__start" href="{{ routes.root_url }}" data-testid="gift-card-start">
                {{- 'gift_card.start_shopping' | t -}}
              </a>
              <button
                type="button"
                class="button button--secondary gift-card__print"
                data-gift-card-print
                data-testid="gift-card-print"
                hidden
              >
                {{- 'gift_card.print' | t -}}
              </button>
            {%- endif -%}
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
