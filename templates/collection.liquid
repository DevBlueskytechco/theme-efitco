{% # TE-6 composition (drafts/techlead/ES1-T103/task-split.md D1). <collection-filters> stays here because it wraps 2 blocks and a block cannot call a block; assets/collection-filters.js (BE) upgrades it and reads data-label-price-invalid. %}
{% block 'container', id: 'collection-banner' %}
  {% block 'collection-banner' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'collection-main' %}
  <collection-filters
    class="collection-layout"
    data-label-price-invalid="{{ 'blocks.collection_filters.price_invalid' | t | escape }}"
  >
    {% block 'collection-filters' %}{% endblock %}
    {% block 'collection-products' %}{% endblock %}
  </collection-filters>
{% endblock %}
