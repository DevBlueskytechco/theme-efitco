{% # TE-6 composition (docs/ui-spec/collection.md §1): collection-banner (breadcrumb, h1, .page-banner when the collection has an image) → <collection-filters> [filter column 3/12 + results 9/12 from 64rem]. <collection-filters> stays here because it wraps 2 blocks and a block cannot call a block; the BE script (ES1-T110) upgrades it and reads data-label-price-invalid. %}
{% block 'container', id: 'collection-banner' %}
  {% block 'collection-banner' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'collection-main' %}
  <collection-filters
    class="collection-layout"
    data-label-price-invalid="{{ 'blocks.collection_filters.price_invalid' | t | escape }}"
  >
    {% block 'collection-filters' %}{% endblock %}
    {% block 'collection-products' %}{% endblock %}
  </collection-filters>
{% endblock %}
