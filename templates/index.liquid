{%- comment -%} Home page: resources and sample copy on the template (CTO 07/11: no view=figma). A setting the merchant saved wins; a store without these Files and products falls back to empty blocks. {%- endcomment -%}

{%- liquid
  assign figma_featured_collection = collections['figma-tab-all']
  unless figma_featured_collection.products_count > 0
    assign figma_featured_collection = collections.all
  endunless

  assign figma_bundle = collections['figma-bundle']
  unless figma_bundle.products_count > 0
    assign figma_bundle = collections.all
  endunless

  assign figma_featured_product = all_products['figma-ativafit-lava-featured']
  unless figma_featured_product.id
    assign figma_featured_product = collections.all.products[0]
  endunless

  assign figma_setup = collections['figma-setup']
  unless figma_setup.products_count > 0
    assign figma_setup = collections.all
  endunless
  assign figma_setup_1 = figma_setup.products[0]
  assign figma_setup_2 = figma_setup.products[1]
  assign figma_setup_3 = figma_setup.products[2]
  assign figma_setup_4 = figma_setup.products[3]

  # Figma has no video files (ES1-T199 #3). A figma-* product uses its own video; until
  # then the cards share the test product video, then a public YouTube id, so 6 cards
  # always render. Cards 7 and 8 have no source and render nothing, as in Figma.
  assign figma_video_media = all_products['media-dủ-loại'].media
  assign figma_video_fallback = figma_video_media | where: 'media_type', 'video' | first
  assign figma_video_external = figma_video_media | where: 'media_type', 'external_video' | first
  assign figma_video_id = figma_video_external.external_id | default: 'aqz-KE-bpKQ'
  assign figma_video_host = figma_video_external.host | default: 'youtube'

  assign figma_video_product_1 = all_products['figma-ativafit-lava']
  assign figma_video_product_2 = all_products['figma-compact-power-rack']
  assign figma_video_product_3 = all_products['figma-olympic-plate-set']
  assign figma_video_product_4 = all_products['figma-home-starter-kit']
  assign figma_video_product_5 = all_products['figma-recovery-roller-pro']
  assign figma_video_product_6 = all_products['figma-resistance-band-set-pro']
  unless figma_video_product_1.id
    assign figma_video_product_1 = collections.all.products[0]
  endunless
  unless figma_video_product_2.id
    assign figma_video_product_2 = collections.all.products[1]
  endunless
  unless figma_video_product_3.id
    assign figma_video_product_3 = collections.all.products[2]
  endunless
  unless figma_video_product_4.id
    assign figma_video_product_4 = collections.all.products[3]
  endunless
  unless figma_video_product_5.id
    assign figma_video_product_5 = collections.all.products[4]
  endunless
  unless figma_video_product_6.id
    assign figma_video_product_6 = collections.all.products[5]
  endunless
  assign figma_video_1 = figma_video_product_1.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_2 = figma_video_product_2.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_3 = figma_video_product_3.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_4 = figma_video_product_4.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_5 = figma_video_product_5.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_6 = figma_video_product_6.metafields.custom.demo_video.value | default: figma_video_fallback


  # Ảnh đúng vị trí trên store dev: Content, Files (ES1-T178). Store khác không có file nên rơi về trống, block vẫn chạy.
  assign fi_slide_1 = images['efx-slide-1.jpg']
  assign fi_slide_2 = images['efx-slide-2.jpg']
  assign fi_inline = images['efx-inline.jpg']
  assign fi_body_map = images['efx-body.jpg']
  assign fi_thumb_1 = images['efx-thumb-1.jpg']
  assign fi_thumb_2 = images['efx-thumb-2.jpg']
  assign fi_thumb_3 = images['efx-thumb-3.jpg']
  assign fi_look = images['efx-look.jpg']
  assign fi_insp_1 = images['efx-insp-1.jpg']
  assign fi_insp_2 = images['efx-insp-2.jpg']
  assign fi_insp_3 = images['efx-insp-3.jpg']
  assign fi_why = images['efx-why.jpg']
  assign fi_why_1 = images['efx-why-1.jpg']
  assign fi_why_2 = images['efx-why-2.jpg']
  assign fi_rev_1 = images['efx-rev-1.jpg']
  assign fi_rev_2 = images['efx-rev-2.jpg']
  assign fi_rev_3 = images['efx-rev-3.jpg']
  assign fi_rev_4 = images['efx-rev-4.jpg']
  assign fi_faq = images['efx-faq.jpg']
  assign fi_col_1 = images['efx-col-1.jpg']
  assign fi_col_2 = images['efx-col-2.jpg']
  assign fi_col_3 = images['efx-col-3.jpg']
  assign fi_col_4 = images['efx-col-4.jpg']
  assign fi_col_5 = images['efx-col-5.jpg']
  assign fi_lvl_1 = images['efx-lvl-1.jpg']
  assign fi_lvl_2 = images['efx-lvl-2.jpg']
  assign fi_lvl_3 = images['efx-lvl-3.jpg']
  assign fi_pos_1 = images['efx-pos-1.jpg']
  assign fi_pos_2 = images['efx-pos-2.jpg']
  assign fi_pos_3 = images['efx-pos-3.jpg']
  assign fi_pos_4 = images['efx-pos-4.jpg']
  assign fi_pos_5 = images['efx-pos-5.jpg']
  assign fi_pos_6 = images['efx-pos-6.jpg']
  assign fi_vt_1 = images['efx-vthumb-1.jpg']
  assign fi_vt_2 = images['efx-vthumb-2.jpg']
  assign fi_vt_3 = images['efx-vthumb-3.jpg']
  assign fi_vt_4 = images['efx-vthumb-4.jpg']
  assign fi_vt_5 = images['efx-vthumb-5.jpg']
  assign fi_vt_6 = images['efx-vthumb-6.jpg']
  assign fi_rt_1 = images['efx-rthumb-1.jpg']
  assign fi_rt_2 = images['efx-rthumb-2.jpg']

  # Store có bộ ảnh mẫu: nhãn Verified và đếm ngược như Figma. Store mới cài không có file nên tắt (CTO 06/11).
  assign home_demo = false
  if fi_slide_1 != blank
    assign home_demo = true
    assign demo_countdown_end = 'now' | date: '%s' | plus: 81360 | date: '%Y-%m-%d %H:%M'
  endif
  assign fp_rev_1 = all_products['figma-ativafit-lava']
  assign fp_rev_2 = all_products['figma-compact-power-rack-r3']
  assign fp_rev_3 = all_products['figma-flexfold-adjustable-bench-2']
  assign fp_rev_4 = all_products['figma-revllen-speed-rope']

  assign slide_eyebrow = 'blocks.slideshow_slide.default_eyebrow' | t
  assign slide_heading = 'blocks.slideshow_slide.default_heading_html' | t
  assign slide_subheading = 'blocks.slideshow_slide.default_text' | t
  assign slide_button_label = 'blocks.slideshow_slide.default_button_label' | t
  assign level_label = 'blocks.level_card.default_label' | t
  assign banner_heading = 'blocks.image_with_text.banner_heading_html' | t
  assign banner_body = 'blocks.image_with_text.banner_text_html' | t
  assign banner_button_label = 'blocks.image_with_text.banner_button_label' | t
  assign why_eyebrow = 'blocks.image_with_text.why_eyebrow' | t
  assign why_heading = 'blocks.image_with_text.why_heading_html' | t
  assign why_body = 'blocks.image_with_text.why_text_html' | t
  assign why_button_label = 'blocks.image_with_text.why_button_label' | t

  assign s1_question = 'blocks.quiz_step.s1_question' | t
  assign s1_hint = 'blocks.quiz_step.s1_hint' | t
  assign s1_option_1_label = 'blocks.quiz_step.s1_option_1_label' | t
  assign s1_option_1_text = 'blocks.quiz_step.s1_option_1_text' | t
  assign s1_option_2_label = 'blocks.quiz_step.s1_option_2_label' | t
  assign s1_option_2_text = 'blocks.quiz_step.s1_option_2_text' | t
  assign s1_option_3_label = 'blocks.quiz_step.s1_option_3_label' | t
  assign s1_option_3_text = 'blocks.quiz_step.s1_option_3_text' | t
  assign s2_question = 'blocks.quiz_step.s2_question' | t
  assign s2_hint = 'blocks.quiz_step.s2_hint' | t
  assign s2_option_1_label = 'blocks.quiz_step.s2_option_1_label' | t
  assign s2_option_1_text = 'blocks.quiz_step.s2_option_1_text' | t
  assign s2_option_2_label = 'blocks.quiz_step.s2_option_2_label' | t
  assign s2_option_2_text = 'blocks.quiz_step.s2_option_2_text' | t
  assign s2_option_3_label = 'blocks.quiz_step.s2_option_3_label' | t
  assign s2_option_3_text = 'blocks.quiz_step.s2_option_3_text' | t
  assign s3_question = 'blocks.quiz_step.s3_question' | t
  assign s3_hint = 'blocks.quiz_step.s3_hint' | t
  assign s3_option_1_label = 'blocks.quiz_step.s3_option_1_label' | t
  assign s3_option_1_text = 'blocks.quiz_step.s3_option_1_text' | t
  assign s3_option_2_label = 'blocks.quiz_step.s3_option_2_label' | t
  assign s3_option_2_text = 'blocks.quiz_step.s3_option_2_text' | t
  assign s3_option_3_label = 'blocks.quiz_step.s3_option_3_label' | t
  assign s3_option_3_text = 'blocks.quiz_step.s3_option_3_text' | t

  assign testimonials_eyebrow = 'blocks.testimonials.default_eyebrow' | t
  assign testimonials_heading = 'blocks.testimonials.default_heading' | t
  assign r1_name = 'blocks.testimonial_item.r1_name' | t
  assign r1_title = 'blocks.testimonial_item.r1_title' | t
  assign r1_quote = 'blocks.testimonial_item.r1_quote' | t
  assign r2_name = 'blocks.testimonial_item.r2_name' | t
  assign r2_title = 'blocks.testimonial_item.r2_title' | t
  assign r2_quote = 'blocks.testimonial_item.r2_quote' | t
  assign r3_name = 'blocks.testimonial_item.r3_name' | t
  assign r3_title = 'blocks.testimonial_item.r3_title' | t
  assign r3_quote = 'blocks.testimonial_item.r3_quote' | t
  assign r4_name = 'blocks.testimonial_item.r4_name' | t
  assign r4_title = 'blocks.testimonial_item.r4_title' | t
  assign r4_quote = 'blocks.testimonial_item.r4_quote' | t

  assign faq_eyebrow = 'blocks.faq.default_eyebrow' | t
  assign faq_heading = 'blocks.faq.default_heading' | t
  assign faq_stat_1_label = 'blocks.faq.default_stat_1_label' | t
  assign faq_stat_1_value = 'blocks.faq.default_stat_1_value' | t
  assign faq_stat_1_text = 'blocks.faq.default_stat_1_text' | t
  assign faq_stat_2_label = 'blocks.faq.default_stat_2_label' | t
  assign faq_stat_2_value = 'blocks.faq.default_stat_2_value' | t
  assign faq_stat_2_text = 'blocks.faq.default_stat_2_text' | t
  assign faq_answer = 'blocks.faq_item.default_answer_html' | t
  assign faq_q1 = 'blocks.faq_item.q1_question' | t
  assign faq_q2 = 'blocks.faq_item.q2_question' | t
  assign faq_q3 = 'blocks.faq_item.q3_question' | t
  assign faq_q4 = 'blocks.faq_item.q4_question' | t
  assign faq_q5 = 'blocks.faq_item.q5_question' | t
-%}

{% block 'container', id: 'home-hero' %}
  {% block 'slideshow' %}
    {% block 'slideshow-slide',
      id: 'home-slide-1',
      priority: true,
      image: fi_slide_1,
      overlay_opacity: 0,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
    {% block 'slideshow-slide',
      id: 'home-slide-2',
      image: fi_slide_2,
      overlay_opacity: 0,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
    {% block 'slideshow-slide',
      id: 'home-slide-3',
      image: fi_slide_1,
      overlay_opacity: 0,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-collection-list', background: 'dark' %}
