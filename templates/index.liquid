    {% block 'collection-card', id: 'home-collection-card-1', handle: 'figma-cat-free-weights', image: fi_col_1 %}{% endblock %}
    {% block 'collection-card', id: 'home-collection-card-2', handle: 'figma-cat-functional-training', image: fi_col_2 %}{% endblock %}
    {% block 'collection-card', id: 'home-collection-card-3', handle: 'figma-cat-benches-racks', image: fi_col_3 %}{% endblock %}
    {% block 'collection-card', id: 'home-collection-card-4', handle: 'figma-cat-recovery-mobility', image: fi_col_4 %}{% endblock %}
    {% block 'collection-card', id: 'home-collection-card-5', handle: 'figma-cat-accessories', image: fi_col_5 %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-intro', background: 'sand' %}
  {% block 'rich-text', inline_image: fi_inline %}{% endblock %}
  {% block 'shop-by-level' %}
    {% block 'level-card', id: 'home-level-card-1', handle: 'figma-level-beginner', image: fi_lvl_1, default_label: level_label %}{% endblock %}
    {% block 'level-card', id: 'home-level-card-2', handle: 'figma-level-intermediate', image: fi_lvl_2, default_label: level_label %}{% endblock %}
    {% block 'level-card', id: 'home-level-card-3', handle: 'figma-level-advanced', image: fi_lvl_3, default_label: level_label %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-featured-collection', tag: 'div' %}
  {% block 'featured-collection',
    id: 'home-featured-collection',
    collection: figma_featured_collection,
    default_tab_2_collection: 'figma-tab-weight',
    default_tab_3_collection: 'figma-tab-portable-fitness',
    default_tab_4_collection: 'figma-tab-accessories'
  %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-quiz', tag: 'div' %}
  {% block 'quiz', id: 'home-quiz' %}
    {% block 'quiz-step',
      id: 'home-quiz-step-1',
      step: 1,
      default_checked: 1,
      total: 3,
      body_map: fi_body_map,
      option_1_image: fi_thumb_1,
      option_2_image: fi_thumb_2,
      option_3_image: fi_thumb_3,
      default_question: s1_question,
      default_subheading: s1_hint,
      default_option_1_label: s1_option_1_label,
      default_option_1_description: s1_option_1_text,
      default_option_1_tag: 'quiz-upper',
      default_option_2_label: s1_option_2_label,
      default_option_2_description: s1_option_2_text,
      default_option_2_tag: 'quiz-core',
      default_option_3_label: s1_option_3_label,
      default_option_3_description: s1_option_3_text,
      default_option_3_tag: 'quiz-lower'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'home-quiz-step-2',
      step: 2,
      total: 3,
      default_question: s2_question,
      default_subheading: s2_hint,
      default_option_1_label: s2_option_1_label,
      default_option_1_description: s2_option_1_text,
      default_option_1_tag: 'quiz-beginner',
      default_option_2_label: s2_option_2_label,
      default_option_2_description: s2_option_2_text,
      default_option_2_tag: 'quiz-intermediate',
      default_option_3_label: s2_option_3_label,
      default_option_3_description: s2_option_3_text,
      default_option_3_tag: 'quiz-advanced'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'home-quiz-step-3',
      step: 3,
      total: 3,
      default_question: s3_question,
      default_subheading: s3_hint,
      default_option_1_label: s3_option_1_label,
      default_option_1_description: s3_option_1_text,
      default_option_1_tag: 'quiz-home',
      default_option_2_label: s3_option_2_label,
      default_option_2_description: s3_option_2_text,
      default_option_2_tag: 'quiz-gym',
      default_option_3_label: s3_option_3_label,
      default_option_3_description: s3_option_3_text,
      default_option_3_tag: 'quiz-outdoor'
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-shop-the-look', tag: 'div' %}
  {% block 'shop-the-look', id: 'home-shop-the-look', image: fi_look %}
    {% block 'shop-the-look-row', id: 'home-look-row-1', look_row: 1, product: figma_setup_1 %}{% endblock %}
    {% block 'shop-the-look-row', id: 'home-look-row-2', look_row: 2, product: figma_setup_2 %}{% endblock %}
