{%- comment -%} Sample content for a new install (plan ES1-T169 D1): a setting the merchant saved wins. Figma has the same copy on both slides. Same list in templates/index.figma.liquid. {%- endcomment -%}
{%- liquid
  assign slide_eyebrow = 'blocks.slideshow_slide.default_eyebrow' | t
  assign slide_heading = 'blocks.slideshow_slide.default_heading_html' | t
  assign slide_subheading = 'blocks.slideshow_slide.default_text' | t
  assign slide_button_label = 'blocks.slideshow_slide.default_button_label' | t
  assign level_label = 'blocks.level_card.default_label' | t
  assign banner_heading = 'blocks.image_with_text.banner_heading_html' | t
  assign banner_body = 'blocks.image_with_text.banner_text_html' | t
  assign banner_button_label = 'blocks.image_with_text.banner_button_label' | t
  assign why_eyebrow = 'blocks.image_with_text.why_eyebrow' | t
  assign why_heading = 'blocks.image_with_text.why_heading_html' | t
  assign why_body = 'blocks.image_with_text.why_text_html' | t
  assign why_button_label = 'blocks.image_with_text.why_button_label' | t

  assign s1_question = 'blocks.quiz_step.s1_question' | t
  assign s1_hint = 'blocks.quiz_step.s1_hint' | t
  assign s1_option_1_label = 'blocks.quiz_step.s1_option_1_label' | t
  assign s1_option_1_text = 'blocks.quiz_step.s1_option_1_text' | t
  assign s1_option_2_label = 'blocks.quiz_step.s1_option_2_label' | t
  assign s1_option_2_text = 'blocks.quiz_step.s1_option_2_text' | t
  assign s1_option_3_label = 'blocks.quiz_step.s1_option_3_label' | t
  assign s1_option_3_text = 'blocks.quiz_step.s1_option_3_text' | t
  assign s2_question = 'blocks.quiz_step.s2_question' | t
  assign s2_hint = 'blocks.quiz_step.s2_hint' | t
  assign s2_option_1_label = 'blocks.quiz_step.s2_option_1_label' | t
  assign s2_option_1_text = 'blocks.quiz_step.s2_option_1_text' | t
  assign s2_option_2_label = 'blocks.quiz_step.s2_option_2_label' | t
  assign s2_option_2_text = 'blocks.quiz_step.s2_option_2_text' | t
  assign s2_option_3_label = 'blocks.quiz_step.s2_option_3_label' | t
  assign s2_option_3_text = 'blocks.quiz_step.s2_option_3_text' | t
  assign s3_question = 'blocks.quiz_step.s3_question' | t
  assign s3_hint = 'blocks.quiz_step.s3_hint' | t
  assign s3_option_1_label = 'blocks.quiz_step.s3_option_1_label' | t
  assign s3_option_1_text = 'blocks.quiz_step.s3_option_1_text' | t
  assign s3_option_2_label = 'blocks.quiz_step.s3_option_2_label' | t
  assign s3_option_2_text = 'blocks.quiz_step.s3_option_2_text' | t
  assign s3_option_3_label = 'blocks.quiz_step.s3_option_3_label' | t
  assign s3_option_3_text = 'blocks.quiz_step.s3_option_3_text' | t
-%}

{% block 'container' %}
  {% block 'slideshow' %}
    {% block 'slideshow-slide',
      id: 'slide-1',
      priority: true,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
    {% block 'slideshow-slide',
      id: 'slide-2',
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-collection-list', background: 'dark' %}
  {% block 'collection-list' %}
    {% block 'collection-card', id: 'collection-card-1' %}{% endblock %}
    {% block 'collection-card', id: 'collection-card-2' %}{% endblock %}
    {% block 'collection-card', id: 'collection-card-3' %}{% endblock %}
    {% block 'collection-card', id: 'collection-card-4' %}{% endblock %}
    {% block 'collection-card', id: 'collection-card-5' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-intro', background: 'sand' %}
  {% block 'rich-text' %}{% endblock %}
  {% block 'shop-by-level' %}
    {% block 'level-card', id: 'level-card-1', default_label: level_label %}{% endblock %}
    {% block 'level-card', id: 'level-card-2', default_label: level_label %}{% endblock %}
    {% block 'level-card', id: 'level-card-3', default_label: level_label %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-featured-collection', tag: 'div' %}
  {% block 'featured-collection', id: 'featured-collection', default_collection: 'all' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-quiz', tag: 'div' %}
  {% block 'quiz', id: 'quiz' %}
    {% block 'quiz-step',
      id: 'quiz-step-1',
      step: 1,
      total: 3,
      default_question: s1_question,
      default_subheading: s1_hint,
      default_option_1_label: s1_option_1_label,
      default_option_1_description: s1_option_1_text,
      default_option_1_tag: 'quiz-upper',
      default_option_2_label: s1_option_2_label,
      default_option_2_description: s1_option_2_text,
      default_option_2_tag: 'quiz-core',
      default_option_3_label: s1_option_3_label,
      default_option_3_description: s1_option_3_text,
      default_option_3_tag: 'quiz-lower'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'quiz-step-2',
      step: 2,
      total: 3,
      default_question: s2_question,
      default_subheading: s2_hint,
      default_option_1_label: s2_option_1_label,
      default_option_1_description: s2_option_1_text,
      default_option_1_tag: 'quiz-beginner',
      default_option_2_label: s2_option_2_label,
      default_option_2_description: s2_option_2_text,
      default_option_2_tag: 'quiz-intermediate',
      default_option_3_label: s2_option_3_label,
      default_option_3_description: s2_option_3_text,
      default_option_3_tag: 'quiz-advanced'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'quiz-step-3',
      step: 3,
      total: 3,
      default_question: s3_question,
      default_subheading: s3_hint,
      default_option_1_label: s3_option_1_label,
      default_option_1_description: s3_option_1_text,
      default_option_1_tag: 'quiz-home',
      default_option_2_label: s3_option_2_label,
      default_option_2_description: s3_option_2_text,
      default_option_2_tag: 'quiz-gym',
      default_option_3_label: s3_option_3_label,
      default_option_3_description: s3_option_3_text,
      default_option_3_tag: 'quiz-outdoor'
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-inspiration', background: 'sand' %}
  {% block 'image-with-text',
    id: 'inspiration',
    layout: 'banner',
    default_heading: banner_heading,
    default_body: banner_body,
    default_button_label: banner_button_label
  %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-bundle-builder', tag: 'div', background: 'cream' %}
  {% block 'bundle-builder', id: 'bundle-builder', default_collection: 'all' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-featured-product', tag: 'div' %}
  {% block 'featured-product', id: 'featured-product' %}{% endblock %}
{% endblock %}

