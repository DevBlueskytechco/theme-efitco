{% block 'container' %}
  {% block 'slideshow' %}
    {% block 'slideshow-slide', id: 'slide-1', priority: true %}{% endblock %}
    {% block 'slideshow-slide', id: 'slide-2' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-intro', background: 'sand' %}
  {% block 'rich-text' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-featured-collection', tag: 'div' %}
  {% block 'featured-collection', id: 'featured-collection', default_collection: 'all' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-inspiration', background: 'sand' %}
  {% block 'image-with-text', id: 'inspiration', layout: 'banner' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-testimonials', background: 'cream' %}
  {% block 'testimonials' %}
    {% block 'testimonial-item', id: 'testimonial-1' %}{% endblock %}
    {% block 'testimonial-item', id: 'testimonial-2' %}{% endblock %}
    {% block 'testimonial-item', id: 'testimonial-3' %}{% endblock %}
    {% block 'testimonial-item', id: 'testimonial-4' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-why-choose', background: 'dark' %}
  {% block 'image-with-text', id: 'why-choose' %}{% endblock %}
{% endblock %}
