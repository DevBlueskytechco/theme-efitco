{% block 'container' %}
  {% block 'slideshow' %}
    {% block 'slideshow-slide', id: 'slide-1', priority: true %}{% endblock %}
    {% block 'slideshow-slide', id: 'slide-2' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'home-intro', background: 'sand' %}
  {% block 'rich-text' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-featured-collection', tag: 'div' %}
  {% block 'featured-collection', id: 'featured-collection', default_collection: 'all' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'home-quiz', tag: 'div' %}
  {% block 'quiz', id: 'quiz' %}
    {% block 'quiz-step', id: 'quiz-step-1', step: 1, total: 3 %}{% endblock %}
    {% block 'quiz-step', id: 'quiz-step-2', step: 2, total: 3 %}{% endblock %}
    {% block 'quiz-step', id: 'quiz-step-3', step: 3, total: 3 %}{% endblock %}
  {% endblock %}
{% endblock %}
