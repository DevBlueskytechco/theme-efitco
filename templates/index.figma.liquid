{% comment %}
  Gate template for the home page, opened with /?view=figma (plan ES1-T169 D2, ES1-T175).
  A branch preview has no block settings, so this file passes resources through
  block parameters. Same block order as templates/index.liquid: a PR that adds a
  block to the home page adds it to both files.

  Each resource comes from a figma-* collection, or from collections.all when
  that collection is missing or empty. Images are the featured images of those
  products; the image regions are masked when screenshots are compared here.
  Exception: collection cards and level cards have no fallback. Their name, link and
  product count are the thing being checked, so a missing figma-cat-* or figma-level-*
  collection shows one card fewer. The blog band has none either: without the figma-blog
  blog it renders nothing.

  Copy stays in the block defaults or, for repeated blocks, in locales passed as
  default_* (plan ES1-T169 D1), same list as templates/index.liquid.
  Exception (TS-FE4, ES1-T406, ADR 0011 mục 3): Figma copy with claims, figures or
  sample reviews (slide eyebrow, testimonial items, FAQ) and the Figma spelling of
  the why-choose eyebrow are literal strings here, never locale keys, because the
  theme must not ship them as defaults. Bundle and setup tiers (10/15%, 10%) are
  set here because the schema defaults are 0.

  Remove this file before a real store release.
{% endcomment %}

{%- liquid
  assign figma_featured_collection = collections['figma-tab-all']
  unless figma_featured_collection.products_count > 0
    assign figma_featured_collection = collections.all
  endunless

  assign figma_bundle = collections['figma-bundle']
  unless figma_bundle.products_count > 0
    assign figma_bundle = collections.all
  endunless

  assign figma_featured_product = all_products['figma-ativafit-lava-featured']
  unless figma_featured_product.id
    assign figma_featured_product = collections.all.products[0]
  endunless

  assign figma_setup = collections['figma-setup']
  unless figma_setup.products_count > 0
    assign figma_setup = collections.all
  endunless
  assign figma_setup_1 = figma_setup.products[0]
  assign figma_setup_2 = figma_setup.products[1]
  assign figma_setup_3 = figma_setup.products[2]
  assign figma_setup_4 = figma_setup.products[3]

  # Figma has no video files (ES1-T199 #3). A figma-* product uses its own video; until
  # then the cards share the test product video, then a public YouTube id, so 6 cards
  # always render. Cards 7 and 8 have no source and render nothing, as in Figma.
  assign figma_video_media = all_products['media-dủ-loại'].media
  assign figma_video_fallback = figma_video_media | where: 'media_type', 'video' | first
  assign figma_video_external = figma_video_media | where: 'media_type', 'external_video' | first
  assign figma_video_id = figma_video_external.external_id | default: 'aqz-KE-bpKQ'
  assign figma_video_host = figma_video_external.host | default: 'youtube'

  assign figma_video_product_1 = all_products['figma-ativafit-lava']
  assign figma_video_product_2 = all_products['figma-compact-power-rack']
  assign figma_video_product_3 = all_products['figma-olympic-plate-set']
  assign figma_video_product_4 = all_products['figma-home-starter-kit']
  assign figma_video_product_5 = all_products['figma-recovery-roller-pro']
  assign figma_video_product_6 = all_products['figma-resistance-band-set-pro']
  unless figma_video_product_1.id
    assign figma_video_product_1 = collections.all.products[0]
  endunless
  unless figma_video_product_2.id
    assign figma_video_product_2 = collections.all.products[1]
  endunless
  unless figma_video_product_3.id
    assign figma_video_product_3 = collections.all.products[2]
  endunless
  unless figma_video_product_4.id
    assign figma_video_product_4 = collections.all.products[3]
  endunless
  unless figma_video_product_5.id
    assign figma_video_product_5 = collections.all.products[4]
  endunless
  unless figma_video_product_6.id
    assign figma_video_product_6 = collections.all.products[5]
  endunless
  assign figma_video_1 = figma_video_product_1.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_2 = figma_video_product_2.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_3 = figma_video_product_3.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_4 = figma_video_product_4.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_5 = figma_video_product_5.metafields.custom.demo_video.value | default: figma_video_fallback
  assign figma_video_6 = figma_video_product_6.metafields.custom.demo_video.value | default: figma_video_fallback


  # Ảnh đúng vị trí trên store dev: Content, Files (ES1-T178). Store khác không có file nên rơi về trống, block vẫn chạy.
  assign fi_slide_1 = images['efx-slide-1.jpg']
  assign fi_slide_2 = images['efx-slide-2.jpg']
  assign fi_inline = images['efx-inline.jpg']
  assign fi_body_map = images['efx-body.jpg']
  assign fi_thumb_1 = images['efx-thumb-1.jpg']
  assign fi_thumb_2 = images['efx-thumb-2.jpg']
  assign fi_thumb_3 = images['efx-thumb-3.jpg']
  assign fi_look = images['efx-look.jpg']
  assign fi_insp_1 = images['efx-insp-1.jpg']
  assign fi_insp_2 = images['efx-insp-2.jpg']
  assign fi_insp_3 = images['efx-insp-3.jpg']
  assign fi_why = images['efx-why-b.jpg']
  assign fi_why_1 = images['efx-why-1.jpg']
  assign fi_why_2 = images['efx-why-2.jpg']
  assign fi_rev_1 = images['efx-rev-1.jpg']
  assign fi_rev_2 = images['efx-rev-2.jpg']
  assign fi_rev_3 = images['efx-rev-3.jpg']
  assign fi_rev_4 = images['efx-rev-4.jpg']
  assign fi_faq = images['efx-faq.jpg']
  assign fi_col_1 = images['efx-col-1.jpg']
  assign fi_col_2 = images['efx-col-2.jpg']
  assign fi_col_3 = images['efx-col-3.jpg']
  assign fi_col_4 = images['efx-col-4.jpg']
  assign fi_col_5 = images['efx-col-5.jpg']
  assign fi_lvl_1 = images['efx-lvl-1.jpg']
  assign fi_lvl_2 = images['efx-lvl-2.jpg']
  assign fi_lvl_3 = images['efx-lvl-3.jpg']
  assign fi_pos_1 = images['efx-pos-1.jpg']
  assign fi_pos_2 = images['efx-pos-2.jpg']
  assign fi_pos_3 = images['efx-pos-3.jpg']
  assign fi_pos_4 = images['efx-pos-4.jpg']
  assign fi_pos_5 = images['efx-pos-5.jpg']
  assign fi_pos_6 = images['efx-pos-6.jpg']

  # Store có bộ ảnh mẫu: nhãn Verified và đếm ngược như Figma. Store mới cài không có file nên tắt (CTO 06/11).
  assign home_demo = false
  if fi_slide_1 != blank
    assign home_demo = true
    # Khuyến mãi trong ngày: hết lúc 23:59 giờ store, đếm ngược là thời gian thật
    assign demo_countdown_end = 'now' | date: '%Y-%m-%d' | append: ' 23:59'
  endif
  assign fp_rev_1 = all_products['figma-ativafit-lava']
  assign fp_rev_2 = all_products['figma-compact-power-rack-r3']
  assign fp_rev_3 = all_products['figma-flexfold-adjustable-bench-2']
  assign fp_rev_4 = all_products['figma-revllen-speed-rope']

  assign slide_eyebrow = 'Trusted by 10,000+ athletes'
  assign slide_heading = 'blocks.slideshow_slide.default_heading_html' | t
  assign slide_subheading = 'blocks.slideshow_slide.default_text' | t
  assign slide_button_label = 'blocks.slideshow_slide.default_button_label' | t
  assign level_label = 'blocks.level_card.default_label' | t
  assign banner_heading = 'blocks.image_with_text.banner_heading_html' | t
  assign banner_body = 'blocks.image_with_text.banner_text_html' | t
  assign banner_button_label = 'blocks.image_with_text.banner_button_label' | t
  assign why_eyebrow = 'We aRE about'
  assign why_heading = 'blocks.image_with_text.why_heading_html' | t
  assign why_body = 'blocks.image_with_text.why_text_html' | t
  assign why_button_label = 'blocks.image_with_text.why_button_label' | t

  assign quiz_eyebrow = 'blocks.quiz.default_eyebrow' | t
  assign quiz_heading = 'blocks.quiz.default_heading' | t
  assign quiz_subheading = 'blocks.quiz.default_subheading' | t
  assign quiz_note_1 = 'blocks.quiz.default_note_1' | t
  assign quiz_note_2 = 'blocks.quiz.default_note_2' | t
  assign s1_question = 'blocks.quiz_step.s1_question' | t
  assign s1_hint = 'blocks.quiz_step.s1_hint' | t
  assign s1_option_1_label = 'blocks.quiz_step.s1_option_1_label' | t
  assign s1_option_1_text = 'blocks.quiz_step.s1_option_1_text' | t
  assign s1_option_2_label = 'blocks.quiz_step.s1_option_2_label' | t
  assign s1_option_2_text = 'blocks.quiz_step.s1_option_2_text' | t
  assign s1_option_3_label = 'blocks.quiz_step.s1_option_3_label' | t
  assign s1_option_3_text = 'blocks.quiz_step.s1_option_3_text' | t
  assign s2_question = 'blocks.quiz_step.s2_question' | t
  assign s2_hint = 'blocks.quiz_step.s2_hint' | t
  assign s2_option_1_label = 'blocks.quiz_step.s2_option_1_label' | t
  assign s2_option_1_text = 'blocks.quiz_step.s2_option_1_text' | t
  assign s2_option_2_label = 'blocks.quiz_step.s2_option_2_label' | t
  assign s2_option_2_text = 'blocks.quiz_step.s2_option_2_text' | t
  assign s2_option_3_label = 'blocks.quiz_step.s2_option_3_label' | t
  assign s2_option_3_text = 'blocks.quiz_step.s2_option_3_text' | t
  assign s3_question = 'blocks.quiz_step.s3_question' | t
  assign s3_hint = 'blocks.quiz_step.s3_hint' | t
  assign s3_option_1_label = 'blocks.quiz_step.s3_option_1_label' | t
  assign s3_option_1_text = 'blocks.quiz_step.s3_option_1_text' | t
  assign s3_option_2_label = 'blocks.quiz_step.s3_option_2_label' | t
  assign s3_option_2_text = 'blocks.quiz_step.s3_option_2_text' | t
  assign s3_option_3_label = 'blocks.quiz_step.s3_option_3_label' | t
  assign s3_option_3_text = 'blocks.quiz_step.s3_option_3_text' | t

  assign testimonials_eyebrow = 'blocks.testimonials.default_eyebrow' | t
  assign testimonials_heading = 'blocks.testimonials.default_heading' | t
  assign r1_name = 'E. Johnson'
  assign r1_title = 'Versatile Gear For All Exercises'
  assign r1_quote = "High quality equipment that doesn't break the bank. I am very impressed with the overall durability."
  assign r2_name = 'S. Williams'
  assign r2_title = 'Folds Away In Seconds'
  assign r2_quote = 'The rack folds flat against the wall. My garage is a garage again between sessions.'
  assign r3_name = 'M. Anderson'
  assign r3_title = 'Smooth Every Single Rep'
  assign r3_quote = 'The dial switches weight fast, no jamming at all. Saves an entire corner of my room.'
  assign r4_name = 'J. Miller'
  assign r4_title = 'Worth Every Penny'
  assign r4_quote = 'Spins so smoothly, no tangling even at high speed. Best rope I have owned.'

  assign faq_eyebrow = 'Questions and Answers'
  assign faq_heading = "We're Proud To Be The Best At Training"
  assign faq_stat_1_label = 'Products'
  assign faq_stat_1_value = '360+'
  assign faq_stat_1_text = 'Home gym gear in stock.'
  assign faq_stat_2_label = 'Warranty'
  assign faq_stat_2_value = '12'
  assign faq_stat_2_text = 'Months on every item.'
  assign faq_answer = '<p>Orders ship within one business day. Standard delivery is 2-4 business days across the continental US, and shipping is free on orders over $99.</p>'
  assign faq_a2 = '<p>Yes. The dial changes the weight in seconds, from 11 to 66 lb per hand, so you can start light and add load as you get stronger. There are no plates to swap.</p>'
  assign faq_a3 = "<p>A pair of adjustable dumbbells takes just 0.18 m² and fits under a desk. A complete corner setup fits in 2.4 x 2.0 m and folds flat when you're done.</p>"
  assign faq_a4 = '<p>Adjustable dumbbells arrive ready to use, with no assembly needed. Other equipment varies, so check the product page before you order.</p>'
  assign faq_a5 = "<p>Every item comes with a 12-month warranty, and you can return it within 90 days for your money back. Contact us with your order number and we'll help from there.</p>"
  assign faq_q1 = 'How long does shipping take?'
  assign faq_q2 = 'Are adjustable dumbbells easy for beginners?'
  assign faq_q3 = 'How much floor space do i actually need?'
  assign faq_q4 = 'Does equipment arrive assembled?'
  assign faq_q5 = "What's covered by the warranty?"
-%}

<div
  hidden
  data-testid="figma-meta"
  data-featured-collection="{{ figma_featured_collection.handle }}"
  data-bundle="{{ figma_bundle.handle }}"
  data-setup="{{ figma_setup.handle }}"
  data-featured-product="{{ figma_featured_product.handle }}"
></div>

{% block 'container', id: 'figma-hero' %}
  {% block 'slideshow' %}
    {% block 'slideshow-slide',
      id: 'figma-slide-1',
      priority: true,
      image: fi_slide_2,
      overlay_opacity: 0,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
    {% block 'slideshow-slide',
      id: 'figma-slide-2',
      image: fi_slide_1,
      overlay_opacity: 0,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-collection-list', background: 'dark' %}
  {% block 'collection-list' %}
    {% block 'collection-card', id: 'figma-collection-card-1', handle: 'figma-cat-free-weights', image: fi_col_1 %}{% endblock %}
    {% block 'collection-card', id: 'figma-collection-card-2', handle: 'figma-cat-functional-training', image: fi_col_2 %}{% endblock %}
    {% block 'collection-card', id: 'figma-collection-card-3', handle: 'figma-cat-benches-racks', image: fi_col_3 %}{% endblock %}
    {% block 'collection-card', id: 'figma-collection-card-4', handle: 'figma-cat-recovery-mobility', image: fi_col_4 %}{% endblock %}
    {% block 'collection-card', id: 'figma-collection-card-5', handle: 'figma-cat-accessories', image: fi_col_5 %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-intro', background: 'sand' %}
  {% block 'rich-text', inline_image: fi_inline %}{% endblock %}
  {% block 'shop-by-level' %}
    {% block 'level-card', id: 'figma-level-card-1', handle: 'figma-level-beginner', image: fi_lvl_1, default_label: level_label %}{% endblock %}
    {% block 'level-card', id: 'figma-level-card-2', handle: 'figma-level-intermediate', image: fi_lvl_2, default_label: level_label %}{% endblock %}
    {% block 'level-card', id: 'figma-level-card-3', handle: 'figma-level-advanced', image: fi_lvl_3, default_label: level_label %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-featured-collection', tag: 'div' %}
  {% block 'featured-collection',
    id: 'figma-featured-collection',
    collection: figma_featured_collection,
    default_tab_2_collection: 'figma-tab-weight',
    default_tab_3_collection: 'figma-tab-portable-fitness',
    default_tab_4_collection: 'figma-tab-accessories'
  %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-quiz', tag: 'div' %}
  {% block 'quiz',
    id: 'figma-quiz',
    default_eyebrow: quiz_eyebrow,
    default_heading: quiz_heading,
    default_subheading: quiz_subheading,
    default_note_1: quiz_note_1,
    default_note_2: quiz_note_2
  %}
    {% block 'quiz-step',
      id: 'figma-quiz-step-1',
      step: 1,
      default_checked: 1,
      total: 3,
      body_map: fi_body_map,
      option_1_image: fi_thumb_1,
      option_2_image: fi_thumb_2,
      option_3_image: fi_thumb_3,
      default_question: s1_question,
      default_subheading: s1_hint,
      default_option_1_label: s1_option_1_label,
      default_option_1_description: s1_option_1_text,
      default_option_1_tag: 'quiz-upper',
      default_option_2_label: s1_option_2_label,
      default_option_2_description: s1_option_2_text,
      default_option_2_tag: 'quiz-core',
      default_option_3_label: s1_option_3_label,
      default_option_3_description: s1_option_3_text,
      default_option_3_tag: 'quiz-lower'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'figma-quiz-step-2',
      step: 2,
      total: 3,
      default_question: s2_question,
      default_subheading: s2_hint,
      default_option_1_label: s2_option_1_label,
      default_option_1_description: s2_option_1_text,
      default_option_1_tag: 'quiz-beginner',
      default_option_2_label: s2_option_2_label,
      default_option_2_description: s2_option_2_text,
      default_option_2_tag: 'quiz-intermediate',
      default_option_3_label: s2_option_3_label,
      default_option_3_description: s2_option_3_text,
      default_option_3_tag: 'quiz-advanced'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'figma-quiz-step-3',
      step: 3,
      total: 3,
      default_question: s3_question,
      default_subheading: s3_hint,
      default_option_1_label: s3_option_1_label,
      default_option_1_description: s3_option_1_text,
      default_option_1_tag: 'quiz-home',
      default_option_2_label: s3_option_2_label,
      default_option_2_description: s3_option_2_text,
      default_option_2_tag: 'quiz-gym',
      default_option_3_label: s3_option_3_label,
      default_option_3_description: s3_option_3_text,
      default_option_3_tag: 'quiz-outdoor'
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-shop-the-look', tag: 'div' %}
  {% block 'shop-the-look', id: 'figma-shop-the-look', image: fi_look, tier_1_quantity: 4, tier_1_percent: 10, hotspot_1_x: 85.04, hotspot_1_y: 15.3, hotspot_2_x: 26.5, hotspot_2_y: 67.6, hotspot_3_x: 78.2, hotspot_3_y: 64, hotspot_4_x: 46.4, hotspot_4_y: 58.2 %}
    {% block 'shop-the-look-row', id: 'figma-look-row-1', look_row: 1, product: figma_setup_1 %}{% endblock %}
    {% block 'shop-the-look-row', id: 'figma-look-row-2', look_row: 2, product: figma_setup_2 %}{% endblock %}
    {% block 'shop-the-look-row', id: 'figma-look-row-3', look_row: 3, product: figma_setup_3 %}{% endblock %}
    {% block 'shop-the-look-row', id: 'figma-look-row-4', look_row: 4, product: figma_setup_4 %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-inspiration', background: 'sand' %}
  {% block 'image-with-text',
    id: 'figma-inspiration',
    layout: 'banner',
    accent_image_1: fi_insp_1,
    accent_image_2: fi_insp_2,
    accent_image_3: fi_insp_3,
    default_heading: banner_heading,
    default_body: banner_body,
