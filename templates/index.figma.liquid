{% comment %}
  Gate template for the home page, opened with /?view=figma (plan ES1-T169 D2, ES1-T175).
  A branch preview has no block settings, so this file passes resources through
  block parameters. Same block order as templates/index.liquid: a PR that adds a
  block to the home page adds it to both files.

  Each resource comes from a figma-* collection, or from collections.all when
  that collection is missing or empty. Images are the featured images of those
  products; the image regions are masked when screenshots are compared here.

  Copy stays in the block defaults or, for repeated blocks, in locales passed as
  default_* (plan ES1-T169 D1), same list as templates/index.liquid.

  Remove this file before a real store release.
{% endcomment %}

{%- liquid
  assign figma_images = collections['figma-level-beginner']
  unless figma_images.products_count > 0
    assign figma_images = collections.all
  endunless

  assign figma_featured_collection = collections['figma-tab-all']
  unless figma_featured_collection.products_count > 0
    assign figma_featured_collection = collections.all
  endunless

  assign figma_bundle = collections['figma-bundle']
  unless figma_bundle.products_count > 0
    assign figma_bundle = collections.all
  endunless

  assign figma_featured_product = all_products['figma-ativafit-lava-featured']
  unless figma_featured_product.id
    assign figma_featured_product = collections.all.products[0]
  endunless

  assign figma_product_1 = figma_images.products[0]
  assign figma_product_2 = figma_images.products[1]
  assign figma_product_3 = figma_images.products[2]
  assign figma_product_4 = figma_images.products[3]
  assign figma_image_1 = figma_product_1.featured_image
  assign figma_image_2 = figma_product_2.featured_image
  assign figma_image_3 = figma_product_3.featured_image
  assign figma_image_4 = figma_product_4.featured_image

  assign slide_eyebrow = 'blocks.slideshow_slide.default_eyebrow' | t
  assign slide_heading = 'blocks.slideshow_slide.default_heading_html' | t
  assign slide_subheading = 'blocks.slideshow_slide.default_text' | t
  assign slide_button_label = 'blocks.slideshow_slide.default_button_label' | t
  assign banner_heading = 'blocks.image_with_text.banner_heading_html' | t
  assign banner_body = 'blocks.image_with_text.banner_text_html' | t
  assign banner_button_label = 'blocks.image_with_text.banner_button_label' | t
  assign why_eyebrow = 'blocks.image_with_text.why_eyebrow' | t
  assign why_heading = 'blocks.image_with_text.why_heading_html' | t
  assign why_body = 'blocks.image_with_text.why_text_html' | t
  assign why_button_label = 'blocks.image_with_text.why_button_label' | t

  assign s1_question = 'blocks.quiz_step.s1_question' | t
  assign s1_hint = 'blocks.quiz_step.s1_hint' | t
  assign s1_option_1_label = 'blocks.quiz_step.s1_option_1_label' | t
  assign s1_option_1_text = 'blocks.quiz_step.s1_option_1_text' | t
  assign s1_option_2_label = 'blocks.quiz_step.s1_option_2_label' | t
  assign s1_option_2_text = 'blocks.quiz_step.s1_option_2_text' | t
  assign s1_option_3_label = 'blocks.quiz_step.s1_option_3_label' | t
  assign s1_option_3_text = 'blocks.quiz_step.s1_option_3_text' | t
  assign s2_question = 'blocks.quiz_step.s2_question' | t
  assign s2_hint = 'blocks.quiz_step.s2_hint' | t
  assign s2_option_1_label = 'blocks.quiz_step.s2_option_1_label' | t
  assign s2_option_1_text = 'blocks.quiz_step.s2_option_1_text' | t
  assign s2_option_2_label = 'blocks.quiz_step.s2_option_2_label' | t
  assign s2_option_2_text = 'blocks.quiz_step.s2_option_2_text' | t
  assign s2_option_3_label = 'blocks.quiz_step.s2_option_3_label' | t
  assign s2_option_3_text = 'blocks.quiz_step.s2_option_3_text' | t
  assign s3_question = 'blocks.quiz_step.s3_question' | t
  assign s3_hint = 'blocks.quiz_step.s3_hint' | t
  assign s3_option_1_label = 'blocks.quiz_step.s3_option_1_label' | t
  assign s3_option_1_text = 'blocks.quiz_step.s3_option_1_text' | t
  assign s3_option_2_label = 'blocks.quiz_step.s3_option_2_label' | t
  assign s3_option_2_text = 'blocks.quiz_step.s3_option_2_text' | t
  assign s3_option_3_label = 'blocks.quiz_step.s3_option_3_label' | t
  assign s3_option_3_text = 'blocks.quiz_step.s3_option_3_text' | t

  assign testimonials_eyebrow = 'blocks.testimonials.default_eyebrow' | t
  assign testimonials_heading = 'blocks.testimonials.default_heading' | t
  assign r1_name = 'blocks.testimonial_item.r1_name' | t
  assign r1_title = 'blocks.testimonial_item.r1_title' | t
  assign r1_quote = 'blocks.testimonial_item.r1_quote' | t
  assign r2_name = 'blocks.testimonial_item.r2_name' | t
  assign r2_title = 'blocks.testimonial_item.r2_title' | t
  assign r2_quote = 'blocks.testimonial_item.r2_quote' | t
  assign r3_name = 'blocks.testimonial_item.r3_name' | t
  assign r3_title = 'blocks.testimonial_item.r3_title' | t
  assign r3_quote = 'blocks.testimonial_item.r3_quote' | t
  assign r4_name = 'blocks.testimonial_item.r4_name' | t
  assign r4_title = 'blocks.testimonial_item.r4_title' | t
  assign r4_quote = 'blocks.testimonial_item.r4_quote' | t

  assign faq_eyebrow = 'blocks.faq.default_eyebrow' | t
  assign faq_heading = 'blocks.faq.default_heading' | t
  assign faq_stat_1_label = 'blocks.faq.default_stat_1_label' | t
  assign faq_stat_1_value = 'blocks.faq.default_stat_1_value' | t
  assign faq_stat_1_text = 'blocks.faq.default_stat_1_text' | t
  assign faq_stat_2_label = 'blocks.faq.default_stat_2_label' | t
  assign faq_stat_2_value = 'blocks.faq.default_stat_2_value' | t
  assign faq_stat_2_text = 'blocks.faq.default_stat_2_text' | t
  assign faq_answer = 'blocks.faq_item.default_answer_html' | t
  assign faq_q1 = 'blocks.faq_item.q1_question' | t
  assign faq_q2 = 'blocks.faq_item.q2_question' | t
  assign faq_q3 = 'blocks.faq_item.q3_question' | t
  assign faq_q4 = 'blocks.faq_item.q4_question' | t
  assign faq_q5 = 'blocks.faq_item.q5_question' | t
-%}

<div
  hidden
  data-testid="figma-meta"
  data-images="{{ figma_images.handle }}"
  data-featured-collection="{{ figma_featured_collection.handle }}"
  data-bundle="{{ figma_bundle.handle }}"
  data-featured-product="{{ figma_featured_product.handle }}"
></div>

{% block 'container', id: 'figma-hero' %}
  {% block 'slideshow' %}
    {% block 'slideshow-slide',
      id: 'figma-slide-1',
      priority: true,
      image: figma_image_1,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
    {% block 'slideshow-slide',
      id: 'figma-slide-2',
      image: figma_image_2,
      default_eyebrow: slide_eyebrow,
      default_heading: slide_heading,
      default_subheading: slide_subheading,
      default_button_label: slide_button_label
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-intro', background: 'sand' %}
  {% block 'rich-text', inline_image: figma_image_3 %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-featured-collection', tag: 'div' %}
  {% block 'featured-collection', id: 'figma-featured-collection', collection: figma_featured_collection %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-quiz', tag: 'div' %}
  {% block 'quiz', id: 'figma-quiz' %}
    {% block 'quiz-step',
      id: 'figma-quiz-step-1',
      step: 1,
      total: 3,
      body_map: figma_image_1,
      option_1_image: figma_image_2,
      option_2_image: figma_image_3,
      option_3_image: figma_image_4,
      default_question: s1_question,
      default_subheading: s1_hint,
      default_option_1_label: s1_option_1_label,
      default_option_1_description: s1_option_1_text,
      default_option_1_tag: 'quiz-upper',
      default_option_2_label: s1_option_2_label,
      default_option_2_description: s1_option_2_text,
      default_option_2_tag: 'quiz-core',
      default_option_3_label: s1_option_3_label,
      default_option_3_description: s1_option_3_text,
      default_option_3_tag: 'quiz-lower'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'figma-quiz-step-2',
      step: 2,
      total: 3,
      default_question: s2_question,
      default_subheading: s2_hint,
      default_option_1_label: s2_option_1_label,
      default_option_1_description: s2_option_1_text,
      default_option_1_tag: 'quiz-beginner',
      default_option_2_label: s2_option_2_label,
      default_option_2_description: s2_option_2_text,
      default_option_2_tag: 'quiz-intermediate',
      default_option_3_label: s2_option_3_label,
      default_option_3_description: s2_option_3_text,
      default_option_3_tag: 'quiz-advanced'
    %}{% endblock %}
    {% block 'quiz-step',
      id: 'figma-quiz-step-3',
      step: 3,
      total: 3,
      default_question: s3_question,
      default_subheading: s3_hint,
      default_option_1_label: s3_option_1_label,
      default_option_1_description: s3_option_1_text,
      default_option_1_tag: 'quiz-home',
      default_option_2_label: s3_option_2_label,
      default_option_2_description: s3_option_2_text,
      default_option_2_tag: 'quiz-gym',
      default_option_3_label: s3_option_3_label,
      default_option_3_description: s3_option_3_text,
      default_option_3_tag: 'quiz-outdoor'
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-inspiration', background: 'sand' %}
  {% block 'image-with-text',
    id: 'figma-inspiration',
    layout: 'banner',
    accent_image_1: figma_image_1,
    accent_image_2: figma_image_2,
    accent_image_3: figma_image_3,
    default_heading: banner_heading,
    default_body: banner_body,
    default_button_label: banner_button_label
  %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-bundle-builder', tag: 'div', background: 'cream' %}
  {% block 'bundle-builder', id: 'figma-bundle-builder', collection: figma_bundle %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-featured-product', tag: 'div' %}
  {% block 'featured-product', id: 'figma-featured-product', product: figma_featured_product %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-testimonials', background: 'cream' %}
  {% block 'testimonials', default_eyebrow: testimonials_eyebrow, default_heading: testimonials_heading %}
    {% block 'testimonial-item',
      id: 'figma-testimonial-1',
      image: figma_image_1,
      product: figma_product_1,
      default_author: r1_name,
      default_rating: 5,
      default_title: r1_title,
      default_quote: r1_quote
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'figma-testimonial-2',
      image: figma_image_2,
      product: figma_product_2,
      default_author: r2_name,
      default_rating: 4,
      default_title: r2_title,
      default_quote: r2_quote
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'figma-testimonial-3',
      image: figma_image_3,
      product: figma_product_3,
      default_author: r3_name,
      default_rating: 5,
      default_title: r3_title,
      default_quote: r3_quote
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'figma-testimonial-4',
      image: figma_image_4,
      product: figma_product_4,
      default_author: r4_name,
      default_rating: 5,
      default_title: r4_title,
      default_quote: r4_quote
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% block 'container', id: 'figma-why-choose', background: 'dark' %}
  {% block 'image-with-text',
    id: 'figma-why-choose',
    image: figma_image_1,
    accent_image_1: figma_image_2,
    accent_image_2: figma_image_3,
    default_eyebrow: why_eyebrow,
    default_heading: why_heading,
    default_body: why_body,
    default_button_label: why_button_label
  %}{% endblock %}
{% endblock %}

{% block 'container', id: 'figma-faq', background: 'cream' %}
  {% block 'faq',
    image: figma_image_1,
    default_eyebrow: faq_eyebrow,
    default_heading: faq_heading,
    default_stat_1_label: faq_stat_1_label,
    default_stat_1_value: faq_stat_1_value,
    default_stat_1_text: faq_stat_1_text,
    default_stat_2_label: faq_stat_2_label,
    default_stat_2_value: faq_stat_2_value,
    default_stat_2_text: faq_stat_2_text
  %}
    {% block 'faq-item', id: 'figma-faq-1', open: true, default_question: faq_q1, default_answer: faq_answer %}{% endblock %}
    {% block 'faq-item', id: 'figma-faq-2', default_question: faq_q2, default_answer: faq_answer %}{% endblock %}
    {% block 'faq-item', id: 'figma-faq-3', default_question: faq_q3, default_answer: faq_answer %}{% endblock %}
    {% block 'faq-item', id: 'figma-faq-4', default_question: faq_q4, default_answer: faq_answer %}{% endblock %}
    {% block 'faq-item', id: 'figma-faq-5', default_question: faq_q5, default_answer: faq_answer %}{% endblock %}
  {% endblock %}
{% endblock %}
