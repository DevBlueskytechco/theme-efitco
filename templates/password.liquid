{% layout 'password' %}

{% block 'container', alignment: 'center' %}
  {% # ES1-T408 (TS-FE8): theme logo (alt shop.name) or shop.name above the h1 (Shopify 7 Password, audit A#63). Not a link: every URL leads here. %}
  <p class="password-logo" data-testid="password-logo">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 200
        | image_tag: alt: shop.name, class: 'password-logo__image', widths: '100, 200', sizes: '100px', fetchpriority: 'high'
      }}
    {%- else -%}
      <span class="password-logo__text">{{ shop.name | escape }}</span>
    {%- endif -%}
  </p>

  <h1>{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password' %}
    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}

    <label for="password-input">
      {{ 'password.password' | t }}
    </label>

    <input type="password" name="password" id="password-input" autocomplete="current-password">

    <button type="submit">
      {{ 'password.enter' | t }}
    </button>
  {% endform %}
{% endblock %}
