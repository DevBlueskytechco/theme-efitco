{% layout none %}
{% comment %}
  Quick view data view (TE-3 AC10, AC14–AC16; ADR 0008 item 3, ADR 0012; mini-cart-quickview.md §3, §3.1, §6;
  product-shopify-features.md §3.1, §4, §5.2, §10). Never a page: assets/quick-view.js (BE TE-3-R2-BE1) fetches the
  partial quick-view from {product.url}?view=quick-view and applies it into the shell in layout/theme.liquid;
  a variant change fetches the same partial with &option_values= (assets/product-variant-picker.js, data-fetch-url,
  data-partials="quick-view"). The background page URL never changes: only the View Detail href and the hidden
  input id follow the variant (M4). layout none: no header, footer or scripts in the response.

  Content, in DOM order (one column below 48rem; from 48rem media left, header and info right):
  vendor eyebrow (theme setting show_quick_view_vendor) and h2 qv-title (tabindex -1, focus target); every media
  of the product (image, video, YouTube/Vimeo, 3D) through snippets/product-media-item with zoom off, 8 at most,
  the selected variant's media first, 1:1 cream frame; from 2 media: prev/next round buttons and up to 5 thumbnails
  (from 48rem), a scroll progress line (below 48rem, CSS scroll timeline); price row (sale, compare-at, -N% badge,
  unit price) with a skeleton for the loading state; rating from the reviews.rating metafield; variant picker
  (id_prefix qv-); selling plans as plain radios name=selling_plan (TE-4 AC19, no JavaScript needed); stock line;
  quantity with the quantity rule (min, max, step, "(N in cart)", rule line) and volume pricing in a closed
  details; gift card note with a link to the product page (no recipient form); Add To Cart + View Detail.
  No Buy It Now, no installments, no pickup, no countdown (TE-3 AC15).

  All ids start with qv- (no clash with the product page form when quick view opens on it). product-form has the
  same data hooks as blocks/product-form, so assets/product-form.js runs unchanged; its role status and role alert
  stay direct children. Loading a variant: JS sets aria-busy on [data-variant-busy] (price row, stock) and
  aria-disabled on the add button (VP1). BE also gets: data-selected-media-id on the gallery, data-media-prev /
  data-media-next buttons, thumbnails a[data-media-id] (href #qv-media-{id}), [data-quick-view-detail] link,
  data-quantity-min / -max / -step / -in-cart on the quantity input. Long content: BE adds .qv--long on the
  dialog (from 48rem the buy row then sticks to the bottom of the info column).

  Test hooks: quick-view-product, quick-view-vendor, quick-view-title, quick-view-media, quick-view-media-item,
  quick-view-media-placeholder, quick-view-media-prev, quick-view-media-next, quick-view-thumbnail,
  quick-view-price, quick-view-discount, quick-view-rating, quick-view-form, quick-view-selling-plans,
  quick-view-variant-id, quick-view-stock, quick-view-inventory, quick-view-unavailable, quick-view-quantity,
  quick-view-quantity-rules, quick-view-volume-pricing, quick-view-gift-card-note, quick-view-add,
  quick-view-detail, quick-view-form-status, quick-view-form-error; inside: product-variant-picker,
  product-option, product-option-value, product-selected-variant and the product-media-* hooks.
{% endcomment %}
{% block 'container', id: 'quick-view-regions', tag: 'div' %}
  {% partial 'quick-view' %}
    {%- liquid
      assign current_variant = product.selected_or_first_available_variant
      assign form_id = 'qv-product-form-' | append: product.id
      assign cart_type = settings.cart_type | default: 'drawer'
      assign title_text = product.title | escape

      assign label_add = 'blocks.product_form.add_to_cart' | t
      assign label_added = 'blocks.product_form.added_to_cart' | t
      assign label_sold_out = 'blocks.product_form.sold_out' | t
      assign label_unavailable = 'blocks.product_form.unavailable' | t

      assign has_variant_choice = true
      if product.has_only_default_variant or product.variants_count == 1
        assign has_variant_choice = false
      endif

      # Tổ hợp đang chọn không tạo thành biến thể: cùng quy tắc blocks/product-form (ADR 0008, ES1-T253)
      assign variant_exists = true
      if has_variant_choice
        for option in product.options_with_values limit: 1
          for value in option.values
            if value.selected and value.variant == blank
              assign variant_exists = false
            endif
          endfor
        endfor
      endif

      assign can_buy = false
      if variant_exists == false
        assign stock_state = 'unavailable'
        assign stock_label = label_unavailable
      elsif current_variant.available
        assign stock_state = 'in_stock'
        assign stock_label = 'blocks.product_form.in_stock' | t
        assign can_buy = true
      else
        assign stock_state = 'sold_out'
        assign stock_label = label_sold_out
      endif

      assign detail_url = product.url
      if has_variant_choice and variant_exists
        assign detail_url = current_variant.url
      endif
      assign fetch_url = product.url | append: '?view=quick-view'

      # Rich media (ADR 0012): every media type, selected variant first, 8 at most
      assign featured_media = current_variant.featured_media
      assign ordered_media = product.media
      if featured_media != blank
        assign featured_list = product.media | where: 'id', featured_media.id
        assign other_media = product.media | reject: 'id', featured_media.id
        assign ordered_media = featured_list | concat: other_media
      endif
      assign media_total = ordered_media.size | at_most: 8

      assign rating_data = product.metafields.reviews.rating.value
      assign rating_value = rating_data.rating
      if rating_value != blank
        assign rating_scale = rating_data.scale_max | plus: 0
        if rating_scale <= 0
          assign rating_scale = 5
        endif
        assign rating_on_five = rating_value | times: 5.0 | divided_by: rating_scale | round: 1
        assign rating_count = product.metafields.reviews.rating_count.value
        if rating_count != blank
          assign rating_count_number = rating_count | plus: 0
        endif
      endif

      # Quantity rule (B2B catalog; B2C: min 1, step 1, no max → nothing printed)
      assign rule_min = current_variant.quantity_rule.min | default: 1
      assign rule_max = current_variant.quantity_rule.max
      assign rule_step = current_variant.quantity_rule.increment | default: 1
      assign in_cart = 0
      for item in cart.items
        if item.variant_id == current_variant.id
          assign in_cart = in_cart | plus: item.quantity
        endif
      endfor
      assign show_rules = false
      if rule_min > 1 or rule_max != blank or rule_step > 1
        assign show_rules = true
      endif
      assign rules_id = form_id | append: '-quantity-rules'
      assign unavailable_id = form_id | append: '-unavailable'
    -%}
    <div class="quick-view__product" data-product-id="{{ product.id }}" data-testid="quick-view-product">
      <div class="quick-view__layout">
        <div class="quick-view__header">
          {%- if settings.show_quick_view_vendor and product.vendor != blank -%}
            <p class="quick-view__vendor" data-testid="quick-view-vendor">{{ product.vendor | escape }}</p>
          {%- endif -%}
          <h2 id="qv-title" class="quick-view__title" tabindex="-1" data-testid="quick-view-title">{{ title_text }}</h2>
        </div>

        <product-media-gallery
          class="quick-view__gallery"
          data-product-id="{{ product.id }}"
          data-media-count="{{ media_total }}"
          {% if featured_media != blank %}
            data-selected-media-id="{{ featured_media.id }}"
          {% endif %}
          style="--qv-media-count: {{ media_total | at_least: 1 }};"
        >
          <ul
            class="quick-view__media-list"
            role="list"
            {% if media_total > 1 %}
              tabindex="0"
            {% endif %}
            aria-label="{{ 'products.quick_view.media_label' | t }}"
            data-testid="quick-view-media"
          >
            {%- for media in ordered_media limit: 8 -%}
              <li
                id="qv-media-{{ media.id }}"
                class="quick-view__media-item"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                style="--media-ratio: {{ media.preview_image.aspect_ratio | default: 1 }};"
                data-testid="quick-view-media-item"
              >
                {% render 'product-media-item',
                  media: media,
                  product: product,
                  loading: 'lazy',
                  sizes: '(min-width: 80rem) 408px, (min-width: 48rem) 316px, 78vw',
                  widths: '320, 408, 632, 816',
                  zoom: false,
                  index: forloop.index,
                  total: media_total
                %}
              </li>
            {%- else -%}
              <li class="quick-view__media-item quick-view__media-item--placeholder" data-testid="quick-view-media-placeholder">
                {%- render 'status-icon', name: 'image' -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if media_total > 1 -%}
            <div class="quick-view__media-nav">
              <button
                type="button"
                class="round-button"
                aria-label="{{ 'products.quick_view.previous_image' | t }}"
                aria-disabled="true"
                data-media-prev
                data-testid="quick-view-media-prev"
              >
                {%- render 'slideshow-icon', name: 'previous' -%}
              </button>
              <button
                type="button"
                class="round-button"
                aria-label="{{ 'products.quick_view.next_image' | t }}"
                data-media-next
                data-testid="quick-view-media-next"
              >
                {%- render 'slideshow-icon', name: 'next' -%}
              </button>
            </div>

            <ul class="quick-view__thumbnails" role="list" aria-label="{{ 'products.quick_view.thumbnails_label' | t }}">
              {%- for media in ordered_media limit: 5 -%}
                <li>
                  <a
                    class="product-media__thumbnail quick-view__thumbnail"
                    href="#qv-media-{{ media.id }}"
                    data-media-id="{{ media.id }}"
                    data-media-type="{{ media.media_type }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                    data-testid="quick-view-thumbnail"
                  >
                    {%- if media.preview_image != blank -%}
                      {% render 'image',
                        image: media.preview_image,
                        width: 144,
                        height: 144,
                        crop: 'center',
                        widths: '72, 144',
                        sizes: '72px',
                        loading: 'lazy',
                        inline: true,
                        decorative: true
                      %}
                    {%- endif -%}
                    {%- case media.media_type -%}
                      {%- when 'video', 'external_video' -%}
                        <span class="product-media__thumbnail-badge" aria-hidden="true">
                          {%- render 'slideshow-icon', name: 'play' -%}
                        </span>
                      {%- when 'model' -%}
                        <span class="product-media__thumbnail-badge product-media__thumbnail-badge--text" aria-hidden="true">
                          {{- 'blocks.featured_product.badge_model' | t -}}
                        </span>
                    {%- endcase -%}
                    <span class="visually-hidden">
                      {%- case media.media_type -%}
                        {%- when 'video', 'external_video' -%}
                          {{- 'products.quick_view.thumbnail_video_label' | t: index: forloop.index, total: media_total -}}
                        {%- when 'model' -%}
                          {{- 'products.quick_view.thumbnail_model_label' | t: index: forloop.index, total: media_total -}}
                        {%- else -%}
                          {{- 'products.quick_view.thumbnail_label' | t: index: forloop.index, total: media_total -}}
                      {%- endcase -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>

            <div class="quick-view__progress" aria-hidden="true">
              <span class="quick-view__progress-thumb"></span>
            </div>
          {%- endif -%}
        </product-media-gallery>

        <div class="quick-view__info">
          <div class="quick-view__summary">
            <div class="quick-view__price" data-variant-busy data-testid="quick-view-price">
              {%- if variant_exists -%}
                {% render 'price', product: product, variant: current_variant %}
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  {%- assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
                  <span class="quick-view__discount" data-testid="quick-view-discount">
                    {%- if discount_percent > 0 -%}
                      {{- 'products.card.sale_percent' | t: percent: discount_percent -}}
                    {%- else -%}
                      {{- 'products.card.sale' | t -}}
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
              <span class="skeleton quick-view__price-skeleton" aria-hidden="true"></span>
            </div>

            {%- if rating_value != blank -%}
              <div class="quick-view__rating" data-testid="quick-view-rating">
                {% render 'rating-stars', rating: rating_on_five %}
                <span>{{ 'products.quick_view.rating_value' | t: rating: rating_on_five }}</span>
                {%- if rating_count != blank -%}
                  <span class="quick-view__rating-count">
                    {{- 'products.quick_view.rating_count' | t: count: rating_count_number -}}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          <product-form
            class="quick-view__buy"
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
            data-cart-add-url="{{ routes.cart_add_url }}"
            data-cart-url="{{ routes.cart_url }}"
            data-cart-type="{{ cart_type | escape }}"
            data-label-add="{{ label_add | escape }}"
            data-label-added="{{ label_added | escape }}"
            data-label-sold-out="{{ label_sold_out | escape }}"
            data-label-unavailable="{{ label_unavailable | escape }}"
            data-testid="quick-view-form"
          >
            {%- if has_variant_choice -%}
              {%- render 'product-variant-picker',
                product: product,
                form_id: form_id,
                id_prefix: 'qv-',
                fetch_url: fetch_url,
                regions: 'quick-view'
              -%}
            {%- endif -%}

            {%- form 'product', product, id: form_id, class: 'product-form__form quick-view__form' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-testid="quick-view-variant-id">
              {%- render 'selected-variant-data', variant: current_variant, exists: variant_exists -%}

              {%- if product.selling_plan_groups.size > 0 -%}
                {%- liquid
                  assign selected_plan = product.selected_selling_plan
                  assign plan_preselected = false
                  if selected_plan != blank
                    assign plan_preselected = true
                  endif
                -%}
                <fieldset class="product-selling-plans quick-view__selling-plans" data-testid="quick-view-selling-plans">
                  <legend class="product-form__label">{{ 'blocks.product_form.purchase_options' | t }}</legend>
                  <div class="product-selling-plans__list">
                    {%- unless product.requires_selling_plan -%}
                      <label class="product-selling-plan">
                        <input
                          class="product-selling-plan__input"
                          type="radio"
                          name="selling_plan"
                          value=""
                          {% unless plan_preselected %}
                            checked
                          {% endunless %}
                        >
                        <span class="product-selling-plan__name">{{ 'blocks.product_form.one_time_purchase' | t }}</span>
                        <span class="product-selling-plan__price">{{ current_variant.price | money }}</span>
                      </label>
                      {%- assign plan_preselected = true -%}
                    {%- endunless -%}

                    {%- for group in product.selling_plan_groups -%}
                      {%- if product.selling_plan_groups.size > 1 -%}
                        <p class="product-selling-plans__group">{{ group.name | escape }}</p>
                      {%- endif -%}
                      {%- for plan in group.selling_plans -%}
                        {%- for allocation in current_variant.selling_plan_allocations -%}
                          {%- if allocation.selling_plan.id == plan.id -%}
                            {%- liquid
                              assign plan_checked = false
                              if selected_plan != blank and selected_plan.id == plan.id
                                assign plan_checked = true
                              elsif plan_preselected == false
                                assign plan_checked = true
                                assign plan_preselected = true
                              endif
                            -%}
                            <label class="product-selling-plan">
                              <input
                                class="product-selling-plan__input"
                                type="radio"
                                name="selling_plan"
                                value="{{ plan.id }}"
                                {% if plan_checked %}
                                  checked
                                {% endif %}
                              >
                              <span class="product-selling-plan__name">{{ plan.name | escape }}</span>
                              <span class="product-selling-plan__price">
                                {%- if allocation.compare_at_price > allocation.price -%}
                                  <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
                                  {{ allocation.price | money }}
                                  <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
                                  <s class="price__compare">{{ allocation.compare_at_price | money }}</s>
                                {%- else -%}
                                  {{ allocation.price | money }}
                                {%- endif -%}
                              </span>
                            </label>
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endif -%}

              <div class="product-form__stock" data-variant-busy data-testid="quick-view-stock">
                <p class="product-form__inventory" data-state="{{ stock_state }}" data-testid="quick-view-inventory">
                  {{- stock_label -}}
                </p>
                <p class="product-form__checking">
                  <span class="spinner product-form__checking-spinner" aria-hidden="true"></span>
                  {{- 'products.variant.checking' | t -}}
                </p>
                {%- unless variant_exists -%}
                  <p id="{{ unavailable_id }}" class="product-form__hint" data-testid="quick-view-unavailable">
                    {{- 'products.variant.combination_unavailable' | t -}}
                  </p>
                {%- endunless -%}
              </div>

              {%- if current_variant.quantity_price_breaks_configured? -%}
                {%- liquid
                  assign tier_quantity = rule_min | plus: in_cart
                  assign current_tier = 0
                  for price_break in current_variant.quantity_price_breaks
                    if price_break.minimum_quantity <= tier_quantity
                      assign current_tier = forloop.index
                    endif
                  endfor
                -%}
                <details class="quick-view__volume" data-testid="quick-view-volume-pricing">
                  <summary class="quick-view__volume-summary">{{ 'products.volume_pricing.summary' | t }}</summary>
                  <table class="quick-view__volume-table">
                    <caption class="visually-hidden">{{ 'products.volume_pricing.caption' | t }}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{{ 'products.volume_pricing.quantity' | t }}</th>
                        <th scope="col">{{ 'products.volume_pricing.price' | t }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr
                        data-quantity-from="{{ rule_min }}"
                        {% if current_tier == 0 %}
                          data-current
                        {% endif %}
                      >
                        <td>
                          {%- if current_tier == 0 -%}
                            <span class="visually-hidden">{{ 'products.volume_pricing.current' | t }}</span>
                          {%- endif -%}
                          {{- 'products.volume_pricing.quantity_from' | t: count: rule_min -}}
                        </td>
                        {%- assign tier_price = current_variant.price | money -%}
                        <td>{{ 'products.volume_pricing.price_each' | t: price: tier_price }}</td>
                      </tr>
                      {%- for price_break in current_variant.quantity_price_breaks -%}
                        <tr
                          data-quantity-from="{{ price_break.minimum_quantity }}"
                          {% if current_tier == forloop.index %}
                            data-current
                          {% endif %}
                        >
                          <td>
                            {%- if current_tier == forloop.index -%}
                              <span class="visually-hidden">{{ 'products.volume_pricing.current' | t }}</span>
                            {%- endif -%}
                            {{- 'products.volume_pricing.quantity_from' | t: count: price_break.minimum_quantity -}}
                          </td>
                          {%- assign tier_price = price_break.price | money -%}
                          <td>{{ 'products.volume_pricing.price_each' | t: price: tier_price }}</td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </details>
              {%- endif -%}

              <div class="product-form__field">
                <label class="product-form__label" for="{{ form_id }}-quantity">
                  {{- 'blocks.product_form.quantity' | t -}}
                  {%- if in_cart > 0 %}
                    <span class="quick-view__in-cart">{{ 'products.quick_view.in_cart' | t: count: in_cart }}</span>
                  {%- endif -%}
                </label>
                <input
                  id="{{ form_id }}-quantity"
                  class="product-form__input product-form__quantity"
                  type="number"
                  name="quantity"
                  min="{{ rule_min }}"
                  {% if rule_max != blank %}
                    max="{{ rule_max }}"
                  {% endif %}
                  step="{{ rule_step }}"
                  value="{{ rule_min }}"
                  inputmode="numeric"
                  {% if show_rules %}
                    aria-describedby="{{ rules_id }}"
                  {% endif %}
                  data-quantity-min="{{ rule_min }}"
                  data-quantity-max="{{ rule_max }}"
                  data-quantity-step="{{ rule_step }}"
                  data-quantity-in-cart="{{ in_cart }}"
                  data-testid="quick-view-quantity"
                >
                {%- if show_rules -%}
                  <p id="{{ rules_id }}" class="quick-view__rules" data-testid="quick-view-quantity-rules">
                    {%- render 'status-icon', name: 'info' -%}
                    <span class="quick-view__rules-text">
                      {%- if rule_min > 1 -%}
                        <span>{{ 'products.quantity_rule.minimum' | t: count: rule_min }}</span>
                      {%- endif -%}
                      {%- if rule_max != blank -%}
                        <span>{{ 'products.quantity_rule.maximum' | t: count: rule_max }}</span>
                      {%- endif -%}
                      {%- if rule_step > 1 -%}
                        <span>{{ 'products.quantity_rule.increment' | t: count: rule_step }}</span>
                      {%- endif -%}
                    </span>
                  </p>
                {%- endif -%}
              </div>

              {%- if product.gift_card? -%}
                <p class="product-form__hint quick-view__gift-card" data-testid="quick-view-gift-card-note">
                  {{- 'products.quick_view.gift_card_note_html' | t: link: product.url -}}
                </p>
              {%- endif -%}

              <div class="quick-view__actions">
                <button
                  class="button product-form__add quick-view__add"
                  type="submit"
                  name="add"
                  {% unless can_buy %}
                    disabled
                  {% endunless %}
                  {% unless variant_exists %}
                    aria-describedby="{{ unavailable_id }}"
                  {% endunless %}
                  data-testid="quick-view-add"
                >
                  {%- if can_buy -%}
                    {% render 'header-icon', name: 'bag' %}
                  {%- endif -%}
                  <span class="product-form__add-label">
                    {%- if can_buy -%}
                      {{- label_add -}}
                    {%- else -%}
                      {{- stock_label -}}
                    {%- endif -%}
                  </span>
                </button>
                <a class="button quick-view__view-detail" href="{{ detail_url }}" data-quick-view-detail data-testid="quick-view-detail">
                  {{- 'products.quick_view.view_detail' | t -}}
                  <span class="visually-hidden"> {{ 'products.quick_view.view_detail_hidden' | t: title: product.title }}</span>
                  {% render 'slideshow-icon', name: 'arrow' %}
                </a>
              </div>
            {%- endform -%}

            <div class="visually-hidden" role="status" aria-live="polite" data-testid="quick-view-form-status"></div>
            <div class="product-form__error" role="alert" data-testid="quick-view-form-error"></div>
          </product-form>
        </div>
      </div>
    </div>
  {% endpartial %}
{% endblock %}
