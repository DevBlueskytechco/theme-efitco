{%- comment -%}
  Sand band. Column 1 has both image and icon: the image wins. Column 2 has no
  image, no icon, no link. Column 3 has only an icon: it counts as empty, so 2
  columns remain on one row.
{%- endcomment -%}
{% block 'container', id: 'te7-multicolumn-mixed', background: 'sand' %}
  {% block 'multicolumn', id: 'te7-mc-mixed', eyebrow: 'Mixed columns', heading: 'Image wins, empty column hidden' %}
    {% block 'multicolumn-column',
      id: 'te7-mc-mixed-1',
      icon: 'truck',
      image: te7_image_4,
      heading: 'Image and icon',
      text: '<p>Only the image shows.</p>',
      link_label: ''
    %}{% endblock %}
    {% block 'multicolumn-column',
      id: 'te7-mc-mixed-2',
      heading: 'Text only',
      text: '<p>No image, no icon, no link.</p>',
      link_label: ''
    %}{% endblock %}
    {% block 'multicolumn-column', id: 'te7-mc-mixed-3', icon: 'truck', heading: '', text: '', link_label: '' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} Empty column: no column, no list, no band. {% endcomment %}
{% block 'container', id: 'te7-multicolumn-empty' %}
