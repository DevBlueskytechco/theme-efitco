{% comment %} Empty question: no question, no list, no band. {% endcomment %}
{% block 'container', id: 'te7-faq-empty', background: 'cream' %}
  {% block 'faq', id: 'te7-faq-none', eyebrow: 'Questions and Answers', heading: 'Hidden' %}
    {% block 'faq-item', id: 'te7-faq-none-1', question: '' %}{% endblock %}
  {% endblock %}
{% endblock %}
