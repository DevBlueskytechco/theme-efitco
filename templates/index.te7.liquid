{% comment %}
  TE-7 test template, opened with /?view=te7 (drafts/techlead/ES1-T114/task-split.md D2).
  A branch preview has no block settings, so this file sets them through block
  parameters and uses Figma copy, with images and products from collections.all.
  Each TE-7 task adds its own band here. Remove this file before a real store release.
{% endcomment %}

{%- liquid
  assign te7_product_1 = collections.all.products[0]
  assign te7_product_2 = collections.all.products[1]
  assign te7_product_3 = collections.all.products[2]
  assign te7_product_4 = collections.all.products[3]
  assign te7_image_1 = te7_product_1.featured_image
  assign te7_image_2 = te7_product_2.featured_image
  assign te7_image_3 = te7_product_3.featured_image
  assign te7_image_4 = te7_product_4.featured_image
-%}

{% block 'container', id: 'te7-title' %}
  <h1 class="visually-hidden">{{ shop.name }}</h1>
{% endblock %}

{% comment %} Figma 1:885: 4 reviews, 4 columns from 80rem. Rating 4 on the second review. {% endcomment %}
{% block 'container', id: 'te7-testimonials', background: 'cream' %}
  {% block 'testimonials', id: 'te7-figma', eyebrow: 'Testimonial', heading: 'What Our Customers Say?' %}
    {% block 'testimonial-item',
      id: 'te7-figma-1',
      author: 'E. Johnson',
      verified: true,
      rating: 5,
      title: 'Versatile Gear For All Exercises',
      quote: "High quality equipment that doesn't break the bank. I am very impressed with the overall durability.",
      image: te7_image_1,
      product: te7_product_1
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-figma-2',
      author: 'S. Williams',
      verified: true,
      rating: 4,
      title: 'Folds Away In Seconds',
      quote: 'The rack folds flat against the wall. My garage is a garage again between sessions.',
      image: te7_image_2,
      product: te7_product_2
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-figma-3',
      author: 'M. Anderson',
      verified: true,
      rating: 5,
      title: 'Smooth Every Single Rep',
      quote: 'The dial switches weight fast, no jamming at all. Saves an entire corner of my room.',
      image: te7_image_3,
      product: te7_product_3
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-figma-4',
      author: 'J. Miller',
      verified: true,
      rating: 5,
      title: 'Worth Every Penny',
      quote: 'Spins so smoothly, no tangling even at high speed. Best rope I have owned.',
      image: te7_image_4,
      product: te7_product_4
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} 1 review: 1 card, nothing to scroll. {% endcomment %}
{% block 'container', id: 'te7-testimonials-one', background: 'cream' %}
  {% block 'testimonials', id: 'te7-one', eyebrow: 'Testimonial', heading: 'One review' %}
    {% block 'testimonial-item',
      id: 'te7-one-1',
      author: 'E. Johnson',
      rating: 5,
      title: 'Versatile Gear For All Exercises',
      quote: 'High quality equipment that does not break the bank.',
      image: te7_image_1,
      product: te7_product_1
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %}
  6 reviews: 3 columns from 80rem. Item 1 rating 0, item 2 no image, item 3 no
  product, item 4 no image and no product, item 5 no title, item 6 no author.
{% endcomment %}
{% block 'container', id: 'te7-testimonials-six', background: 'cream' %}
  {% block 'testimonials', id: 'te7-six', eyebrow: 'Testimonial', heading: 'Six reviews' %}
    {% block 'testimonial-item',
      id: 'te7-six-1',
      author: 'Rating zero',
      rating: 0,
      title: 'Rating zero',
      quote: 'Five empty stars and a name that says zero.',
      image: te7_image_1,
      product: te7_product_1
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-2',
      author: 'No image',
      rating: 4,
      title: 'No image',
      quote: 'The card starts with the text, with no gap above it.',
      product: te7_product_2
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-3',
      author: 'No product',
      rating: 5,
      title: 'No product',
      quote: 'The product row and its divider are both gone.',
      image: te7_image_3
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-4',
      author: 'No image, no product',
      rating: 3,
      title: 'Text only',
      quote: 'Only the text remains.'
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-5',
      author: 'No title',
      rating: 2,
      title: '',
      quote: 'The quote follows the author row directly.',
      image: te7_image_4
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-6',
      author: '',
      rating: 1,
      title: 'No author',
      quote: 'The stars stay on the row without a name.',
      image: te7_image_2
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} Multicolumn has no Figma frame, so this copy is test text. 2 columns, icons, default and set link. {% endcomment %}
{% block 'container', id: 'te7-multicolumn-two', background: 'cream' %}
  {% block 'multicolumn', id: 'te7-mc-two', eyebrow: 'Two columns', heading: 'Two columns with icons' %}
    {% block 'multicolumn-column',
      id: 'te7-mc-two-1',
      icon: 'truck',
      heading: 'Fast delivery',
      text: '<p>Link falls back to all products.</p>',
      link_label: 'Shop All Products'
    %}{% endblock %}
    {% block 'multicolumn-column',
      id: 'te7-mc-two-2',
      icon: 'return',
      heading: 'Easy returns',
      text: '<p>Link goes to the list of collections.</p>',
      link_label: 'See Collections',
      link_url: routes.collections_url
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} 3 columns, images. {% endcomment %}
{% block 'container', id: 'te7-multicolumn-three' %}
  {% block 'multicolumn', id: 'te7-mc-three', eyebrow: 'Three columns', heading: 'Three columns with images' %}
    {% block 'multicolumn-column',
      id: 'te7-mc-three-1',
      image: te7_image_1,
      heading: 'Strength',
      text: '<p>Image at 3 / 2, lazy.</p>',
      link_label: 'Shop All Products'
    %}{% endblock %}
    {% block 'multicolumn-column',
      id: 'te7-mc-three-2',
      image: te7_image_2,
      heading: 'Mobility',
      text: '<p>A longer text checks that links stay on one line across the row when one column runs taller than the others.</p>',
      link_label: 'Shop All Products'
    %}{% endblock %}
    {% block 'multicolumn-column',
      id: 'te7-mc-three-3',
      image: te7_image_3,
      heading: 'Endurance',
      text: '<p>Image at 3 / 2, lazy.</p>',
      link_label: 'Shop All Products'
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} 4 columns on the dark band: eyebrow and text must keep contrast. {% endcomment %}
{% block 'container', id: 'te7-multicolumn-four', background: 'dark' %}
  {% block 'multicolumn', id: 'te7-mc-four', eyebrow: 'Four columns', heading: 'Four columns on dark' %}
    {% block 'multicolumn-column', id: 'te7-mc-four-1', icon: 'shield', heading: 'Warranty', text: '<p>Column one.</p>', link_label: 'Shop All Products' %}{% endblock %}
    {% block 'multicolumn-column', id: 'te7-mc-four-2', icon: 'support', heading: 'Support', text: '<p>Column two.</p>', link_label: 'Shop All Products' %}{% endblock %}
    {% block 'multicolumn-column', id: 'te7-mc-four-3', icon: 'quality', heading: 'Quality', text: '<p>Column three.</p>', link_label: 'Shop All Products' %}{% endblock %}
    {% block 'multicolumn-column', id: 'te7-mc-four-4', icon: 'truck', heading: 'Delivery', text: '<p>Column four.</p>', link_label: 'Shop All Products' %}{% endblock %}
  {% endblock %}
{% endblock %}

{%- comment -%}
  Sand band. Column 1 has both image and icon: the image wins. Column 2 has no
  image, no icon, no link. Column 3 has only an icon: it counts as empty, so 2
  columns remain on one row.
{%- endcomment -%}
{% block 'container', id: 'te7-multicolumn-mixed', background: 'sand' %}
  {% block 'multicolumn', id: 'te7-mc-mixed', eyebrow: 'Mixed columns', heading: 'Image wins, empty column hidden' %}
    {% block 'multicolumn-column',
      id: 'te7-mc-mixed-1',
      icon: 'truck',
      image: te7_image_4,
      heading: 'Image and icon',
      text: '<p>Only the image shows.</p>',
      link_label: ''
    %}{% endblock %}
    {% block 'multicolumn-column',
      id: 'te7-mc-mixed-2',
      heading: 'Text only',
      text: '<p>No image, no icon, no link.</p>',
      link_label: ''
    %}{% endblock %}
    {% block 'multicolumn-column', id: 'te7-mc-mixed-3', icon: 'truck', heading: '', text: '', link_label: '' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} Empty column: no column, no list, no band. {% endcomment %}
{% block 'container', id: 'te7-multicolumn-empty' %}
  {% block 'multicolumn', id: 'te7-mc-empty', eyebrow: 'Hidden', heading: 'Hidden' %}
    {% block 'multicolumn-column', id: 'te7-mc-empty-1', heading: '', text: '', link_label: '' %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} Fixed text plus one Liquid expression, compared with the h1 of te7-title. {% endcomment %}
{% block 'container', id: 'te7-custom-liquid' %}
  {% block 'custom-liquid', id: 'te7-cl', custom_liquid: '<p>Custom Liquid runs on <strong>{{ shop.name }}</strong></p>' %}{% endblock %}
{% endblock %}

{% comment %} Empty setting: no block, no band. {% endcomment %}
{% block 'container', id: 'te7-custom-liquid-empty' %}
  {% block 'custom-liquid', id: 'te7-cl-empty' %}{% endblock %}
{% endblock %}

{% comment %} Empty review: no card, no list, no band (blocks/container.liquid). {% endcomment %}
{% block 'container', id: 'te7-testimonials-empty', background: 'cream' %}
  {% block 'testimonials', id: 'te7-empty', eyebrow: 'Testimonial', heading: 'Hidden' %}
    {% block 'testimonial-item', id: 'te7-empty-1', author: '', quote: '' %}{% endblock %}
  {% endblock %}
{% endblock %}
