{% comment %}
  TE-7 test template, opened with /?view=te7 (drafts/techlead/ES1-T114/task-split.md D2).
  A branch preview has no block settings, so this file sets them through block
  parameters and uses Figma copy, with images and products from collections.all.
  Each TE-7 task adds its own band here. Remove this file before a real store release.
{% endcomment %}

{%- liquid
  assign te7_product_1 = collections.all.products[0]
  assign te7_product_2 = collections.all.products[1]
  assign te7_product_3 = collections.all.products[2]
  assign te7_product_4 = collections.all.products[3]
  assign te7_image_1 = te7_product_1.featured_image
  assign te7_image_2 = te7_product_2.featured_image
  assign te7_image_3 = te7_product_3.featured_image
  assign te7_image_4 = te7_product_4.featured_image
-%}

{% block 'container', id: 'te7-title' %}
  <h1 class="visually-hidden">{{ shop.name }}</h1>
{% endblock %}

{% comment %} Figma 1:625: banner on sand, no main image, 3 scattered images. {% endcomment %}
{% block 'container', id: 'te7-iwt-banner', background: 'sand' %}
  {% block 'image-with-text',
    id: 'te7-banner',
    layout: 'banner',
    heading: 'Make fitness a natural part of your everyday life !',
    body: '<p>Just simple, effective workouts you can do anytime at home</p>',
    button_label: 'Get Started Now',
    image: te7_image_4,
    accent_image_1: te7_image_1,
    accent_image_2: te7_image_2,
    accent_image_3: te7_image_3
  %}{% endblock %}
{% endblock %}

{% comment %} Banner with an eyebrow on sand and 1 accent image: the 2 empty ones are skipped. {% endcomment %}
{% block 'container', id: 'te7-iwt-banner-one', background: 'sand' %}
  {% block 'image-with-text',
    id: 'te7-banner-one',
    layout: 'banner',
    eyebrow: 'Inspiration',
    heading: 'One accent image',
    body: '<p>The other two are empty.</p>',
    button_label: 'Get Started Now',
    accent_image_1: te7_image_1
  %}{% endblock %}
{% endblock %}

{% comment %} Figma 1:992: split on dark, image left. accent_image_3 must not render in this layout. {% endcomment %}
{% block 'container', id: 'te7-iwt-left', background: 'dark' %}
  {% block 'image-with-text',
    id: 'te7-left',
    eyebrow: 'We are about',
    heading: 'Why Choose Efitco?',
    body: "<p>Affordable, high-quality fitness gear that supports beginners to elite athletes.</p><p>We design for the home first — equipment that folds, stacks or disappears when you're done, so your living room stays a living room between sessions.</p>",
    button_label: 'View About Us',
    image: te7_image_1,
    image_position: 'left',
    accent_image_1: te7_image_2,
    accent_image_2: te7_image_3,
    accent_image_3: te7_image_4
  %}{% endblock %}
{% endblock %}

{% comment %} Same content with the image on the right. {% endcomment %}
{% block 'container', id: 'te7-iwt-right', background: 'dark' %}
  {% block 'image-with-text',
    id: 'te7-right',
    eyebrow: 'We are about',
    heading: 'Why Choose Efitco?',
    body: "<p>Affordable, high-quality fitness gear that supports beginners to elite athletes.</p><p>We design for the home first — equipment that folds, stacks or disappears when you're done, so your living room stays a living room between sessions.</p>",
    button_label: 'View About Us',
    image: te7_image_1,
    image_position: 'right',
    accent_image_1: te7_image_2,
    accent_image_2: te7_image_3
  %}{% endblock %}
{% endblock %}

{% comment %} No main image on sand: the dark frame stays and the text keeps sand colors. {% endcomment %}
{% block 'container', id: 'te7-iwt-no-image', background: 'sand' %}
  {% block 'image-with-text',
    id: 'te7-no-image',
    eyebrow: 'No main image',
    heading: 'Dark frame',
    body: '<p>The storefront keeps the dark frame next to this text.</p>',
    button_label: 'View About Us'
  %}{% endblock %}
{% endblock %}

{% comment %} All text and images empty: no block, no band (blocks/container.liquid). {% endcomment %}
{% block 'container', id: 'te7-iwt-empty', background: 'dark' %}
  {% block 'image-with-text',
    id: 'te7-empty-split',
    eyebrow: '',
    heading: '',
    body: '',
    button_label: ''
  %}{% endblock %}
{% endblock %}

{% comment %} Figma 1:885: 4 reviews, 4 columns from 80rem. Rating 4 on the second review. {% endcomment %}
{% block 'container', id: 'te7-testimonials', background: 'cream' %}
  {% block 'testimonials', id: 'te7-figma', eyebrow: 'Testimonial', heading: 'What Our Customers Say?' %}
    {% block 'testimonial-item',
      id: 'te7-figma-1',
      author: 'E. Johnson',
      verified: true,
      rating: 5,
      title: 'Versatile Gear For All Exercises',
      quote: "High quality equipment that doesn't break the bank. I am very impressed with the overall durability.",
      image: te7_image_1,
      product: te7_product_1
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-figma-2',
      author: 'S. Williams',
      verified: true,
      rating: 4,
      title: 'Folds Away In Seconds',
      quote: 'The rack folds flat against the wall. My garage is a garage again between sessions.',
      image: te7_image_2,
      product: te7_product_2
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-figma-3',
      author: 'M. Anderson',
      verified: true,
      rating: 5,
      title: 'Smooth Every Single Rep',
      quote: 'The dial switches weight fast, no jamming at all. Saves an entire corner of my room.',
      image: te7_image_3,
      product: te7_product_3
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-figma-4',
      author: 'J. Miller',
      verified: true,
      rating: 5,
      title: 'Worth Every Penny',
      quote: 'Spins so smoothly, no tangling even at high speed. Best rope I have owned.',
      image: te7_image_4,
      product: te7_product_4
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} 1 review: 1 card, nothing to scroll. {% endcomment %}
{% block 'container', id: 'te7-testimonials-one', background: 'cream' %}
  {% block 'testimonials', id: 'te7-one', eyebrow: 'Testimonial', heading: 'One review' %}
    {% block 'testimonial-item',
      id: 'te7-one-1',
      author: 'E. Johnson',
      rating: 5,
      title: 'Versatile Gear For All Exercises',
      quote: 'High quality equipment that does not break the bank.',
      image: te7_image_1,
      product: te7_product_1
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %}
  6 reviews: 3 columns from 80rem. Item 1 rating 0, item 2 no image, item 3 no
  product, item 4 no image and no product, item 5 no title, item 6 no author.
{% endcomment %}
{% block 'container', id: 'te7-testimonials-six', background: 'cream' %}
  {% block 'testimonials', id: 'te7-six', eyebrow: 'Testimonial', heading: 'Six reviews' %}
    {% block 'testimonial-item',
      id: 'te7-six-1',
      author: 'Rating zero',
      rating: 0,
      title: 'Rating zero',
      quote: 'Five empty stars and a name that says zero.',
      image: te7_image_1,
      product: te7_product_1
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-2',
      author: 'No image',
      rating: 4,
      title: 'No image',
      quote: 'The card starts with the text, with no gap above it.',
      product: te7_product_2
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-3',
      author: 'No product',
      rating: 5,
      title: 'No product',
      quote: 'The product row and its divider are both gone.',
      image: te7_image_3
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-4',
      author: 'No image, no product',
      rating: 3,
      title: 'Text only',
      quote: 'Only the text remains.'
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-5',
      author: 'No title',
      rating: 2,
      title: '',
      quote: 'The quote follows the author row directly.',
      image: te7_image_4
    %}{% endblock %}
    {% block 'testimonial-item',
      id: 'te7-six-6',
      author: '',
      rating: 1,
      title: 'No author',
      quote: 'The stars stay on the row without a name.',
      image: te7_image_2
    %}{% endblock %}
  {% endblock %}
{% endblock %}

{% comment %} Empty review: no card, no list, no band (blocks/container.liquid). {% endcomment %}
{% block 'container', id: 'te7-testimonials-empty', background: 'cream' %}
  {% block 'testimonials', id: 'te7-empty', eyebrow: 'Testimonial', heading: 'Hidden' %}
    {% block 'testimonial-item', id: 'te7-empty-1', author: '', quote: '' %}{% endblock %}
  {% endblock %}
{% endblock %}
