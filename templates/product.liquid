{% # TE-4 composition (drafts/techlead/ES1-T59/task-split.md D1). Each FE task adds only its own block call. %}
{% block 'container', id: 'product-main' %}
  <div class="product">
    {% block 'product-media' %}{% endblock %}

    <div class="product__details">
      {% # Interim until ES1-T63 (product-info) and ES1-T64 (product-form) replace these lines. %}
      <h1>{{ product.title }}</h1>
      {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
      <div>{{ product.description }}</div>
    </div>
  </div>
{% endblock %}

{% block 'container', id: 'product-related' %}{% endblock %}

{% block 'container', id: 'product-complementary' %}{% endblock %}
