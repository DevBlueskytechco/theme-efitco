{% # TE-4 composition (drafts/techlead/ES1-T59/task-split.md D1). Each FE task adds only its own block call. %}
{% block 'container', id: 'product-main' %}
  <div class="product">
    {% block 'product-media' %}{% endblock %}

    <div class="product__details">
      {% block 'product-info' %}{% endblock %}
      {% block 'product-form' %}{% endblock %}
    </div>
  </div>

  {% block 'product-sticky-bar' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'product-related' %}
  {% block 'product-recommendations', id: 'product-recommendations-related', intent: 'related' %}{% endblock %}
{% endblock %}

{% block 'container', id: 'product-complementary' %}
  {% block 'product-recommendations', id: 'product-recommendations-complementary', intent: 'complementary' %}{% endblock %}
{% endblock %}
